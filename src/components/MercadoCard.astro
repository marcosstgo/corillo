---
import { CONDICION, ENTREGA, nombrePueblo, precio, type Anuncio } from '../data/mercado';
interface Props { a: Anuncio; }
const { a } = Astro.props;
const href = `/mercado/a/${a.id}/`;
const vendido = a.estado === 'vendido';
---
<article class="of-card mk-card" data-estado={a.estado}>
  <a class="of-pic mk-pic" href={href} aria-label={a.titulo}>
    {a.fotos[0] && <img src={a.fotos[0]} alt="" width="400" height="300" loading="lazy" decoding="async" />}
    <span class="of-flag" style="--tc:var(--h2-bone)">{CONDICION[a.condicion]}</span>
    {vendido && <span class="mk-sold">Vendido</span>}
    {a.estado === 'reservado' && <span class="mk-res">Reservado</span>}
  </a>
  <div class="of-body">
    <h3><a href={href}>{a.titulo}</a></h3>
    <div class="of-price"><b>{precio(a.precio)}</b>{a.negociable && !vendido && <em>Negociable</em>}</div>
    <div class="of-meta mk-meta"><span>{nombrePueblo(a.pueblo)}</span><span>{ENTREGA[a.entrega]}</span></div>
    <div class="mk-who">
      <span class="mk-ava" style={`--c:${a.vendedor.color || 'var(--h2-cyan)'}`}>{a.vendedor.avatar ? <img src={a.vendedor.avatar} alt="" width="24" height="24" loading="lazy" /> : a.vendedor.nombre.slice(0, 1)}</span>
      <span class="mk-name">{a.vendedor.nombre}</span>
      {a.vendedor.streamer && <span class="mk-badge" title="Transmite en CORILLO">Streamer de CORILLO</span>}
    </div>
  </div>
</article>

<style>
  .mk-pic { aspect-ratio: 4 / 3; overflow: hidden; }
  .mk-card[data-estado="vendido"] .mk-pic img { filter: grayscale(.85) brightness(.55); }
  .mk-sold, .mk-res { position: absolute; left: 50%; top: 50%; translate: -50% -50%; padding: 8px 18px; border-radius: 12px;
    font: 800 1.05rem var(--h2-display); letter-spacing: .02em; text-transform: uppercase; }
  .mk-sold { background: var(--h2-live); color: #fff; rotate: -6deg; }
  .mk-res { background: var(--h2-mag); color: var(--h2-ink); }
  .mk-card .of-body { gap: 10px; }
  .mk-card h3 { margin: 0; }
  .mk-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .mk-meta span + span::before { content: '·'; margin-right: 12px; color: var(--h2-line); }
  .mk-who { display: flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--h2-line); min-width: 0; }
  .mk-ava { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; overflow: hidden;
    background: color-mix(in srgb, var(--c) 30%, transparent); color: var(--c); font: 800 .75rem var(--h2-body); }
  .mk-ava img { width: 100%; height: 100%; object-fit: cover; }
  .mk-name { color: var(--h2-bone); font: 700 .88rem var(--h2-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mk-badge { flex: none; padding: 3px 8px; border-radius: 8px; background: color-mix(in srgb, var(--h2-cyan) 18%, transparent);
    color: var(--h2-cyan); font: 800 .7rem var(--h2-body); letter-spacing: .02em; }
</style>
