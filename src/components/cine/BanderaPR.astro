---
/* Bandera de Puerto Rico en SVG (los emoji de bandera no se ven en Windows: salen dos cajitas). */
interface Props { size?: number; class?: string }
const { size = 16, class: clase = '' } = Astro.props;
---
<svg class={`cn-bandera ${clase}`} width={Math.round(size * 1.5)} height={size} viewBox="0 0 30 20" role="img" aria-label="Puerto Rico">
  <rect width="30" height="20" fill="#ed0000"/>
  <rect y="4" width="30" height="4" fill="#fff"/><rect y="12" width="30" height="4" fill="#fff"/>
  <path d="M0 0 L17.3 10 L0 20 Z" fill="#0050f0"/>
  <path d="M5.8 7.2 l.66 2.03 h2.13 l-1.72 1.25 .66 2.03 -1.73-1.26 -1.72 1.26 .66-2.03 -1.73-1.25 h2.13z" fill="#fff"/>
</svg>
