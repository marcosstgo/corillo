---
const { uno = 'Elige el overlay que quieres en pantalla y escribe tu usuario.' } = Astro.props;
---
<ol class="ov-pasos" aria-label="Cómo se usa">
  <li><b>1</b><span><strong>Escoge.</strong> {uno}</span></li>
  <li><b>2</b><span><strong>Copia el enlace.</strong> Ya trae tu usuario.</span></li>
  <li><b>3</b><span><strong>Pégalo en OBS</strong> como Fuente de navegador. El fondo ya es transparente.</span></li>
</ol>
