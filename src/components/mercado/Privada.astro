---
// Páginas del Mercado que se llenan en el navegador (mis anuncios, moderación, anuncio recién creado).
// No se indexan. `modo` elige el script.
import SiteShell from '../../layouts/SiteShell.astro';
import Cabecera from './Cabecera.astro';
import I18nCliente from './I18nCliente.astro';
import { MUNICIPIOS } from '../../data/categorias';
import { traductor, ruta, alternos, type Lang } from '../../i18n';
interface Props { lang: Lang; modo: 'mis-anuncios' | 'moderacion' | 'anuncio'; }
const { lang, modo } = Astro.props;
const t = traductor(lang);
const path = `/mercado/${modo}/`;
const titulo = modo === 'mis-anuncios' ? t('mercado.mis_anuncios') : modo === 'moderacion' ? t('mercado.moderacion') : t('mercado.nombre');
---
<SiteShell lang={lang} alternates={alternos(path)} title={`${titulo} — ${t('mercado.nombre')} CORILLO`} description={t('mercado.lema')} canonical={`https://corillo.live${ruta(lang, path)}`}>
  <fragment slot="head">
    <meta name="robots" content="noindex" />
    <link rel="stylesheet" href="/assets/ofertas.css?v=2" />
    <link rel="stylesheet" href="/assets/mercado.css?v=8" />
  </fragment>
  <main class="of" data-privada={modo} data-lang={lang} data-fallback={modo === 'anuncio' ? '1' : undefined}>
    <nav class="of-crumb" aria-label="Ruta"><a href={ruta(lang, '/mercado/')}>{t('mercado.nombre')}</a>{modo !== 'anuncio' && <> / {titulo}</>}</nav>
    <header class="of-hd" style="margin-top:14px">
      <h1 style="font-size:clamp(2.2rem,6vw,4.2rem)" data-h1>{modo === 'anuncio' ? t('comun.cargando') : titulo}</h1>
      {modo !== 'anuncio' && <Cabecera lang={lang} path={path} />}
    </header>
    <div data-cuerpo><p class="of-empty">{t('comun.cargando')}</p></div>
  </main>
  <script type="application/json" id="mkPueblos" set:html={JSON.stringify(Object.fromEntries(MUNICIPIOS.map(m => [m.slug, m.nombre])))} />
  <I18nCliente lang={lang} />
  <script is:inline src="/assets/mercado-cuenta.js?v=1"></script>
  <script is:inline src="/assets/mercado-privada.js?v=1" defer></script>
</SiteShell>
