---
import SiteShell from '../../layouts/SiteShell.astro';
import Lista from './Lista.astro';
import Nota from './Nota.astro';
import Cabecera from './Cabecera.astro';
import I18nCliente from './I18nCliente.astro';
import { loadMercado, categoriasConAnuncios } from '../../data/mercado';
import { traductor, ruta, alternos, type Lang } from '../../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = traductor(lang);
const R = await loadMercado();
const cats = categoriasConAnuncios(R);
const donde = t('mercado.en_pr');
const hoy = R.total ? t('mercado.hoy_hay', { n: R.total, donde }) : t('mercado.hoy_hay_cero', { donde });
---
<SiteShell lang={lang} alternates={alternos('/mercado/')} title={t('mercado.titulo_seo')} description={t('mercado.desc_seo', { hoy })} canonical={`https://corillo.live${ruta(lang, '/mercado/')}`} ogImage="/assets/og-mercado.png">
  <fragment slot="head">
    <link rel="stylesheet" href="/assets/ofertas.css?v=2" />
    <link rel="stylesheet" href="/assets/mercado.css?v=7" />
  </fragment>
  <main class="of">
    <header class="of-hd">
      <h1>{t('mercado.nombre')}</h1>
      <p>{t('mercado.lema')}</p>
      <p class="of-stamp">{R.total ? t('mercado.disponibles', { n: R.total }) : t('mercado.vacio')}</p>
      <Cabecera lang={lang} path="/mercado/" />
    </header>
    <nav class="of-chips mk-cats" aria-label={t('mercado.categorias')}>
      <a class="of-chip" href={ruta(lang, '/mercado/')} aria-current="page" aria-pressed="true">{t('mercado.todo')}</a>
      {cats.map(c => <a class="of-chip" href={ruta(lang, `/mercado/${c.slug}/`)} aria-pressed="false">{c[lang]}{c.n > 0 && <span class="mk-n">{c.n}</span>}</a>)}
    </nav>
    <section class="of-sec">
      <h2>{t('mercado.recientes')}</h2>
      <Lista lang={lang} anuncios={R.anuncios} vacio={t('mercado.vacio')} />
    </section>
    <Nota lang={lang} />
  </main>
  <I18nCliente lang={lang} />
</SiteShell>
