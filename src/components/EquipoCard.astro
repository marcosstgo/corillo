---
import { withTag, type EquipoItem, type EquipoKind } from '../data/equipo';
// usados: anuncios disponibles en el Mercado de la misma categoría (0 = no se muestra el enlace).
interface Props { it: EquipoItem; usados?: { n: number; href: string } | null; }
const { it, usados = null } = Astro.props;
const href = withTag(it.url);

// Íconos de línea propios (viewBox 24), uno por tipo de equipo.
const ICONS: Record<EquipoKind, string> = {
  webcam:    '<circle cx="12" cy="10" r="7"/><circle cx="12" cy="10" r="3"/><path d="M12 17v3M8 21h8"/>',
  mic:       '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5v3.5M8.5 21h7"/>',
  capture:   '<rect x="2.5" y="7" width="19" height="10" rx="2.5"/><path d="M6.5 12h.01M10 12h7.5M2.5 10.5H1M2.5 13.5H1M23 12h-1.5"/>',
  keyboard:  '<rect x="2" y="6" width="20" height="12" rx="2.5"/><path d="M6 10h.01M9.3 10h.01M12.6 10h.01M15.9 10h.01M18 10h.01M6 14h.01M18 14h.01M9 14h6"/>',
  mouse:     '<rect x="6" y="2.5" width="12" height="19" rx="6"/><path d="M12 6.5v4"/>',
  headset:   '<path d="M3.5 14v-2a8.5 8.5 0 0 1 17 0v2"/><path d="M20.5 15.5a2.5 2.5 0 0 1-2.5 2.5h-1v-6h1a2.5 2.5 0 0 1 2.5 2.5zM3.5 15.5A2.5 2.5 0 0 0 6 18h1v-6H6a2.5 2.5 0 0 0-2.5 2.5z"/><path d="M18 18v.5a3 3 0 0 1-3 3h-2"/>',
  light:     '<rect x="3.5" y="3" width="17" height="11" rx="2.5"/><path d="M7.5 6.8h.01M12 6.8h.01M16.5 6.8h.01M7.5 10.2h.01M12 10.2h.01M16.5 10.2h.01M12 14v4M8.5 21l3.5-3 3.5 3"/>',
  arm:       '<path d="M3 21h7M6.5 21l3-8.5 8-4.5"/><circle cx="9.5" cy="12.5" r="1.2"/><rect x="16" y="2.5" width="5" height="8" rx="2.5"/>',
  popfilter: '<circle cx="9.5" cy="9.5" r="6.5"/><path d="M6 7.5h7M4.5 9.5h10M6 11.5h7M14.2 14.2c2.3 2.3 3.3 4.5 3.3 7.3M15 21.5h5"/>',
  cable:     '<path d="M4 3.5h8v6l-1.5 2h-5L4 9.5z"/><path d="M8 11.5v2.5a4 4 0 0 0 4 4h4a4 4 0 0 1 4 3.5"/><path d="M6.5 6.5h3"/>',
  hub:       '<rect x="2.5" y="9" width="19" height="7.5" rx="2.5"/><path d="M6.5 12.75h2M11 12.75h2M15.5 12.75h2M12 9V3.5M10 3.5h4"/>',
};
---
<article class="of-card eq-card">
  <a class="of-pic eq-pic" href={href} target="_blank" rel="nofollow noopener sponsored" aria-label={it.title} data-kind={it.kind}>
    <svg class="eq-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[it.kind]} />
    <span class="eq-brand">{it.brand}</span>
    <span class="of-flag" style="--tc:var(--h2-mag)">{it.category}</span>
  </a>
  <div class="of-body">
    <h3><a href={href} target="_blank" rel="nofollow noopener sponsored">{it.title}</a></h3>
    <p class="eq-why">{it.why}</p>
    <a class="of-go" href={href} target="_blank" rel="nofollow noopener sponsored">Ver en Amazon</a>
    {usados && usados.n > 0 && <a class="eq-used" href={usados.href}>Ver usados en el Mercado ({usados.n})</a>}
  </div>
</article>

<style>
  .eq-pic { display: grid; place-items: center; overflow: hidden; color: var(--h2-cyan);
    background: radial-gradient(120% 90% at 50% 110%, color-mix(in srgb, var(--h2-cyan) 26%, transparent), transparent 60%),
                linear-gradient(160deg, var(--h2-raise), var(--h2-panel) 70%); }
  .eq-pic::before { content: ''; position: absolute; inset: 0; opacity: .5;
    background-image: radial-gradient(color-mix(in srgb, var(--h2-bone) 14%, transparent) 1px, transparent 1.4px);
    background-size: 16px 16px; mask-image: linear-gradient(to bottom, #000, transparent 85%); }
  .eq-ico { position: relative; margin-top: 22px; width: 38%; height: auto; max-height: 64%; filter: drop-shadow(0 6px 18px color-mix(in srgb, var(--h2-cyan) 45%, transparent)); transition: transform .25s ease; }
  .eq-card:hover .eq-ico { transform: translateY(-3px) scale(1.04); }
  .eq-brand { position: absolute; right: 14px; bottom: 10px; color: var(--h2-mute); font: 800 .72rem var(--h2-body); letter-spacing: .14em; text-transform: uppercase; }
  .eq-card .of-body { padding: 20px 20px 22px; gap: 10px; }
  .eq-card h3 { margin: 0; -webkit-line-clamp: unset; min-height: 0; }
  .eq-why { margin: 0; color: var(--h2-mute); font: 500 .92rem/1.5 var(--h2-body); flex: 1; }
  .eq-used { align-self: center; color: var(--h2-bone); font: 700 .88rem var(--h2-body); text-decoration: underline; text-underline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .eq-ico { transition: none; } }
</style>
