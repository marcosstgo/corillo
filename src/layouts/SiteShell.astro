</aside>

<!-- BARRA INFERIOR (móvil) -->
<nav class="nv-tabs" aria-label="Navegación">
  <a href="/" class="nv-tab" data-nav="/"><i class="fa-solid fa-house" aria-hidden="true"></i><span>Inicio</span></a>
