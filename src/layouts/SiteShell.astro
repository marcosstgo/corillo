        <a href="https://status.corillo.live" target="_blank" rel="noopener">Status</a>
      </div></div>
    </div>
  </div>
  <div class="foot-bottom">
    <div class="foot-socials">
      <a class="foot-social" href="https://x.com/corillolive" target="_blank" rel="noopener" title="X / Twitter"><i class="fa-brands fa-x-twitter"></i></a>
      <a class="foot-social" href="https://instagram.com/corillolive" target="_blank" rel="noopener" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
      <a class="foot-social" href="https://tiktok.com/@corillolive" target="_blank" rel="noopener" title="TikTok"><i class="fa-brands fa-tiktok"></i></a>
      <a class="foot-social" href="/discord/" target="_blank" rel="noopener" title="Discord"><i class="fa-brands fa-discord"></i></a>
      <a class="foot-social" href="https://github.com/marcosstgo" target="_blank" rel="noopener" title="GitHub"><i class="fa-brands fa-github"></i></a>
    </div>
    <span class="foot-version" id="footVersion"></span>
    <div class="foot-copy">© 2026 CORILLO · Hecho con <i class="fa-solid fa-heart" style="color:var(--crl-hot);font-size:9px"></i> en Puerto Rico</div>
  </div>
  <div class="foot-credits">
    <span class="foot-credits-icon">⚡</span>
    <a href="https://marcossantiago.com" target="_blank" rel="noopener" class="foot-credits-link">Marcos Santiago</a>
  </div>
</footer>

</div><!-- /page-right -->

<script>
/* SiteShell — menú, canales y sesión. Auto-contenido. */
const POLL_MS = 15000;
const PB_URL  = 'https://pb.corillo.live';
let STREAMERS: any[] = ((window as any).STREAMERS || []).filter((s: any) => !s.soon);

const $ = (id: string) => document.getElementById(id);
const esc = (v: any) => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]);

/* ── sesión: la guarda el SDK de PocketBase en localStorage; se lee sin cargar el SDK ── */
function readSession(): any | null {
  try {
    const raw = localStorage.getItem('pocketbase_auth');
    if (!raw) return null;
    const a = JSON.parse(raw);
    const p = JSON.parse(atob(String(a.token).split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));
    if (!p.exp || p.exp * 1000 < Date.now()) return null;
    return a.record || a.model || null;
  } catch { return null; }
}
function avaHTML(name: string, color: string, img?: string) {
  return `<span class="nv-ava" style="--c:${esc(color || 'var(--h2-raise)')}">${img ? `<img src="${esc(img)}" alt="" loading="lazy" onerror="this.remove()">` : esc((name || '?')[0].toUpperCase())}</span>`;
}
function renderAuth() {
  const rec = readSession();
  const top = $('nvAuth'), side = $('nvSideAuth');
  if (rec) {
    const name = rec.display_name || rec.key || 'Mi canal';
    const img = rec.avatar ? `${PB_URL}/api/files/${rec.collectionId || 'streamers'}/${rec.id}/${rec.avatar}?thumb=72x72` : '';
    const me = `<a class="nv-me" href="/perfil/" title="Mi perfil">${avaHTML(name, rec.color, img)}<span class="nv-me-n">${esc(name)}</span></a>`;
    if (top) top.innerHTML = me;
    if (side) side.innerHTML = me;
    const promo = $('nvPromo');
    if (promo) promo.innerHTML = `<b>Hola, ${esc(name)}</b><span>Administra tu canal, tu stream key y tus VODs.</span><a class="nv-signup" href="/perfil/">Mi canal</a>`;
  } else if (side) {
    side.innerHTML = '<a class="nv-signup" href="/join/">Crear cuenta</a><a class="nv-login" href="/perfil/">Entrar</a>';
  }
}

/* ── "en vivo": solo un contador junto a Streamers (la lista de canales vive en /streamers/) ── */
function renderLive(n: number) {
  const el = $('nvLiveN');
  if (!el) return;
  el.hidden = n < 1;
  const t = el.querySelector('span'); if (t) t.textContent = String(n);
}
async function poll() {
  let paths: any[] = [];
  try {
    const r = await fetch('/mediamtx-api/v3/paths/list', { signal: AbortSignal.timeout(4000) });
    paths = (await r.json()).items || [];
  } catch { /* sin datos de mediamtx: no se muestra contador */ }
  const liveKeys = new Set<string>();
  for (const p of paths) {
    if (!p.ready) continue;
    const m = String(p.name).match(/^live\/([^/]+)$/);
    if (m && !/_(low|rtc)$/.test(m[1])) liveKeys.add(m[1]);
  }
  renderLive(STREAMERS.filter(s => liveKeys.has(s.key)).length);
}

/* ── menú: abrir/cerrar, colapsar, sección activa ── */
const desktop = () => window.matchMedia('(min-width: 1000px)').matches;
function setOpen(open: boolean) {
  document.body.classList.toggle('nv-open', open);
  $('nvMoreTab')?.setAttribute('aria-expanded', String(open));
}
function markActive() {
  const path = location.pathname;
  document.querySelectorAll('[data-nav]').forEach(a => {
    const h = a.getAttribute('data-nav') || '';
    const on = h === '/' ? path === '/' : path.startsWith(h) || path.startsWith('/en' + h);
    a.classList.toggle('is-on', on);
    if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
  });
}
function initFooter() {
  document.querySelectorAll('[data-foot-toggle]').forEach(title => {
    const links = title.nextElementSibling;
    if (!links) return;
    title.setAttribute('aria-expanded', 'false');
    title.addEventListener('click', () => {
      const isOpen = title.getAttribute('aria-expanded') === 'true';
      title.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      links.classList.toggle('open', !isOpen);
    });
  });
}
async function loadVersion() {
  try {
    const j = await (await fetch('/version.json', { signal: AbortSignal.timeout(3000) })).json();
    const el = $('footVersion'); if (el && j.version) el.textContent = 'v' + j.version;
  } catch {}
}

document.addEventListener('DOMContentLoaded', async () => {
  initFooter(); loadVersion(); markActive(); renderAuth();

  $('nvBurger')?.addEventListener('click', () => {
    const min = document.documentElement.classList.toggle('nv-min');
    try { localStorage.setItem('corillo-sb', min ? 'min' : 'open'); } catch {}
  });
  $('nvMoreTab')?.addEventListener('click', () => setOpen(true));
  $('nvClose')?.addEventListener('click', () => setOpen(false));
  $('nvScrim')?.addEventListener('click', () => setOpen(false));
  $('nvSide')?.addEventListener('click', e => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { setOpen(false); closeSearch(); } });
  window.addEventListener('resize', () => { if (desktop()) setOpen(false); });

  /* búsqueda: filtra en las páginas que escuchan 'crl-search' (inicio); en las demás, Enter lleva a Streamers */
  const top = $('nvTop'), input = $('nvSearch') as HTMLInputElement | null, clear = $('nvSearchClear') as HTMLButtonElement | null;
  const emit = (q: string) => window.dispatchEvent(new CustomEvent('crl-search', { detail: q }));
  function closeSearch() { if (top?.classList.contains('is-search') && !input?.value) top.classList.remove('is-search'); }
  $('nvSearchOpen')?.addEventListener('click', () => { top?.classList.add('is-search'); input?.focus(); });
  input?.addEventListener('blur', () => setTimeout(closeSearch, 150));
  input?.addEventListener('input', () => { const q = input.value.trim().toLowerCase(); if (clear) clear.hidden = !q; emit(q); });
  clear?.addEventListener('click', () => { if (!input) return; input.value = ''; clear.hidden = true; emit(''); input.focus(); });
  $('nvSearchForm')?.addEventListener('submit', e => {
    if (location.pathname === '/' || location.pathname.startsWith('/streamers')) e.preventDefault();
  });

  try { const r = await fetch('/api/streamers', { signal: AbortSignal.timeout(5000) }); if (r.ok) STREAMERS = (await r.json()).filter((s: any) => !s.soon); } catch {}
  await poll();
  setInterval(poll, POLL_MS);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) poll(); });
});
</script>
<script>if('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');</script>

</body>
</html>
