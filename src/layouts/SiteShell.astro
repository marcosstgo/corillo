      <a href="/que-es-corillo/" class="nv-item nv-sm" data-nav="/que-es-corillo/"><span class="nv-tile"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span><span class="nv-lbl">Sobre Corillo</span></a>
      <a href="/roadmap/" class="nv-item nv-sm" data-nav="/roadmap/"><span class="nv-tile"><i class="fa-solid fa-route" aria-hidden="true"></i></span><span class="nv-lbl">Roadmap</span></a>
    <a href="/discord/" class="nv-item nv-sm" data-nav="/discord/" style="--tc:#8b95ff"><span class="nv-tile"><i class="fa-brands fa-discord" aria-hidden="true"></i></span><span class="nv-lbl">Discord</span></a>
