    </div>
    <div>
      <div class="foot-col-title" data-foot-toggle><span class="rdot"></span>Software<i class="fa-solid fa-chevron-down foot-chev"></i></div>
      <div class="foot-col-links"><div>
        <a href="/software/">Todo el software</a>
