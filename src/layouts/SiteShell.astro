      <div class="foot-col-title" data-foot-toggle><span class="rdot"></span>Info<i class="fa-solid fa-chevron-down foot-chev"></i></div>
      <div class="foot-col-links"><div>
        <a href="/roadmap/">Roadmap</a>
        <a href="/que-es-corillo/">Sobre Corillo</a>
        <a href="/noticias/">Noticias</a>
        <a href="/faq/">FAQ</a>
