<script>
/* SiteShell — interacciones del chrome (drawer/sidebar/topbar/footer). Auto-contenido. */
const SHELL_POLL_MS = 15000;
let STREAMERS = ((window as any).STREAMERS || []).filter((s: any) => !s.soon);

const THEME_CYCLE: Record<string, string> = { dark: 'verano', verano: 'light', light: 'dark' };
const THEME_ICON: Record<string, string> = { dark: 'fa-moon', verano: 'fa-sun', light: 'fa-circle-half-stroke' };
const THEME_LABEL: Record<string, string> = { dark: 'Modo oscuro', verano: 'Modo Verano PR 🇵🇷', light: 'Modo claro' };

function shellSetThemeIcons(t: string) {
  const icon = THEME_ICON[t] || 'fa-moon';
  document.getElementById('themeIcon')?.setAttribute('class', `fa-solid ${icon}`);
  document.getElementById('themeIconDrawer')?.setAttribute('class', `fa-solid ${icon}`);
  document.getElementById('themeBtn')?.setAttribute('title', THEME_LABEL[t] || '');
  document.getElementById('themeBtnDrawer')?.setAttribute('title', THEME_LABEL[t] || '');
}

function shellToggleTheme() {
  const root = document.documentElement;
  const current = root.getAttribute('data-theme') || 'dark';
  const next = THEME_CYCLE[current] || 'dark';
  root.setAttribute('data-theme', next);
  localStorage.setItem('corillo-theme', next);
  shellSetThemeIcons(next);
}

function shellOpenDrawer() {
  document.getElementById('drawer')!.classList.add('open');
  document.getElementById('drawerOverlay')!.classList.add('open');
}
(window as any).closeDrawer = () => {
  document.getElementById('drawer')!.classList.remove('open');
  document.getElementById('drawerOverlay')!.classList.remove('open');
};

function shellRowAva(s: any, dim = false) {
  const ava = s.avatar_url
    ? `<img src="${s.avatar_url}" alt="">`
    : (s.ava || (s.name && s.name[0]) || '?');
  const style = `background:${s.color || 'var(--accent)'}${dim ? ';opacity:.55' : ''}`;
  return `<div class="ch-row-ava" style="${style}">${ava}</div>`;
}

function shellGetViewers(paths: any[], key: string) {
  const p = (paths || []).find((x: any) => x && x.name === 'live/' + key);
  if (!p || !p.readers) return 0;
  return p.readers.filter((r: any) => r.type !== 'hlsMuxer').length;
}

function shellRenderSidebar(live: any[], offline: any[], paths: any[]) {
  const liveSection = document.getElementById('sidebarLiveSection');
  const liveRows    = document.getElementById('sidebarLiveRows');
  const offlineRows = document.getElementById('sidebarOfflineRows');
  const liveBadge   = document.getElementById('sidebarLiveBadge');
  if (!liveSection || !liveRows || !offlineRows) return;

  if (live.length) {
    liveSection.style.display = '';
    if (liveBadge) { liveBadge.textContent = String(live.length); liveBadge.style.display = ''; }
    liveRows.innerHTML = live.map((s: any) => {
      const v = shellGetViewers(paths, s.key);
      return `<a href="/${s.key}/" class="channel-row is-live">
        <div class="sidebar-row-inner">
          ${shellRowAva(s)}
          <div class="ch-row-info nav-text">
            <div class="ch-row-name">${s.name}</div>
            <div class="ch-row-status live">${v > 0 ? v + ' viewers' : 'En vivo'}</div>
          </div>
          <div class="live-pip nav-text"></div>
        </div>
      </a>`;
    }).join('');
  } else {
    liveSection.style.display = 'none';
    if (liveBadge) liveBadge.style.display = 'none';
  }

  const MAX = 8;
  const showAllBtn = document.getElementById('sidebarShowAll') as HTMLButtonElement | null;
  const renderOffline = (list: any[]) => list.map((s: any) => `
    <a href="/${s.key}/" class="channel-row">
      <div class="sidebar-row-inner">
        ${shellRowAva(s, true)}
        <div class="ch-row-info nav-text">
          <div class="ch-row-name">${s.name}</div>
          <div class="ch-row-status">Offline</div>
        </div>
      </div>
    </a>`).join('');

  if (offline.length > MAX) {
    offlineRows.innerHTML = renderOffline(offline.slice(0, MAX));
    if (showAllBtn) {
      showAllBtn.style.display = '';
      showAllBtn.onclick = () => {
        offlineRows.innerHTML = renderOffline(offline);
        showAllBtn.style.display = 'none';
      };
    }
  } else {
    offlineRows.innerHTML = renderOffline(offline);
    if (showAllBtn) showAllBtn.style.display = 'none';
  }
}

function shellRenderDrawer(live: any[], offline: any[], paths: any[]) {
  const liveSection = document.getElementById('drawerLiveSection');
  const liveRows    = document.getElementById('drawerLiveRows');
  const offlineRows = document.getElementById('drawerOfflineRows');
  if (!liveSection || !liveRows || !offlineRows) return;

  if (live.length) {
    liveSection.style.display = '';
    liveRows.innerHTML = live.map((s: any) => {
      const v = shellGetViewers(paths, s.key);
      return `<a href="/${s.key}/" class="channel-row is-live" onclick="window.closeDrawer()">
        ${shellRowAva(s)}
        <div class="ch-row-info">
          <div class="ch-row-name">${s.name}</div>
          <div class="ch-row-status live">En vivo</div>
        </div>
        ${v > 0 ? `<div class="ch-row-viewers">${v}</div>` : '<div class="live-pip"></div>'}
      </a>`;
    }).join('');
  } else {
    liveSection.style.display = 'none';
  }

  const MAX = 8;
  const showAllBtn = document.getElementById('drawerShowAll') as HTMLButtonElement | null;
  const renderOffline = (list: any[]) => list.map((s: any) => `
    <a href="/${s.key}/" class="channel-row" onclick="window.closeDrawer()">
      ${shellRowAva(s, true)}
      <div class="ch-row-info">
        <div class="ch-row-name">${s.name}</div>
        <div class="ch-row-status">Offline</div>
      </div>
    </a>`).join('');

  if (offline.length > MAX) {
    offlineRows.innerHTML = renderOffline(offline.slice(0, MAX));
    if (showAllBtn) {
      showAllBtn.style.display = '';
      showAllBtn.onclick = () => {
        offlineRows.innerHTML = renderOffline(offline);
        showAllBtn.style.display = 'none';
      };
    }
  } else {
    offlineRows.innerHTML = renderOffline(offline);
    if (showAllBtn) showAllBtn.style.display = 'none';
  }
}

async function shellPoll() {
  try {
    const r = await fetch('/mediamtx-api/v3/paths/list', { signal: AbortSignal.timeout(4000) });
    const data = await r.json();
    const paths = data.items || [];
    const liveSet = new Set(paths.filter((p: any) => p.ready).map((p: any) => p.name.replace('live/', '')));
    const live    = STREAMERS.filter((s: any) => liveSet.has(s.key));
    const offline = STREAMERS.filter((s: any) => !liveSet.has(s.key));
    shellRenderSidebar(live, offline, paths);
    shellRenderDrawer(live, offline, paths);
  } catch {
    // En offline total mostramos todos como offline para que la lista no quede vacía.
    shellRenderSidebar([], STREAMERS, []);
    shellRenderDrawer([], STREAMERS, []);
  }
}

async function shellLoadVersion() {
  try {
    const r = await fetch('/version.json', { signal: AbortSignal.timeout(3000) });
    const j = await r.json();
    const el = document.getElementById('footVersion');
    if (el && j.version) el.textContent = 'v' + j.version;
  } catch {}
}

function shellInitFooter() {
  document.querySelectorAll('[data-foot-toggle]').forEach(title => {
    const links = title.nextElementSibling;
    if (!links) return;
    title.setAttribute('aria-expanded', 'false');
    title.addEventListener('click', () => {
      const isOpen = title.getAttribute('aria-expanded') === 'true';
      title.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      links.classList.toggle('open', !isOpen);
    });
  });
}

document.addEventListener('DOMContentLoaded', async () => {
  shellInitFooter();
  shellLoadVersion();

  document.getElementById('menuBtn')?.addEventListener('click', shellOpenDrawer);
  document.getElementById('drawerClose')?.addEventListener('click', (window as any).closeDrawer);
  document.getElementById('drawerOverlay')?.addEventListener('click', (window as any).closeDrawer);
  document.getElementById('themeBtn')?.addEventListener('click', shellToggleTheme);
  document.getElementById('themeBtnDrawer')?.addEventListener('click', shellToggleTheme);
  shellSetThemeIcons(document.documentElement.getAttribute('data-theme') || 'dark');

  // Sidebar collapse
  const sidebar = document.getElementById('leftSidebar');
  const savedCollapsed = localStorage.getItem('corillo-sidebar') === 'collapsed';
  if (savedCollapsed) sidebar?.classList.add('collapsed');
  document.getElementById('sidebarToggle')?.addEventListener('click', () => {
    const collapsed = sidebar!.classList.toggle('collapsed');
    localStorage.setItem('corillo-sidebar', collapsed ? 'collapsed' : 'open');
  });

  // Search — emite evento 'crl-search' para que la página activa lo consuma
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const searchClear = document.getElementById('searchClear') as HTMLButtonElement | null;
  searchInput?.addEventListener('input', e => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    if (searchClear) searchClear.style.display = q ? '' : 'none';
    window.dispatchEvent(new CustomEvent('crl-search', { detail: q }));
  });
  searchClear?.addEventListener('click', () => {
    if (!searchInput) return;
    searchInput.value = '';
    searchClear.style.display = 'none';
    searchInput.focus();
    window.dispatchEvent(new CustomEvent('crl-search', { detail: '' }));
  });
  if (searchClear) searchClear.style.display = 'none';

  // Cargar roster completo desde API (una sola llamada)
  try {
    const r = await fetch('/api/streamers', { signal: AbortSignal.timeout(5000) });
    if (r.ok) {
      const fresh = await r.json();
      STREAMERS = fresh;
    }
  } catch {}

  await shellPoll();
  setInterval(shellPoll, SHELL_POLL_MS);

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) shellPoll();
  });
});
</script>
<script>if('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');</script>

