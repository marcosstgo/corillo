      <a href="/ofertas/" class="nv-item" data-nav="/ofertas/" style="--tc:var(--h2-mag)"><span class="nv-tile"><i class="fa-solid fa-tags" aria-hidden="true"></i></span><span class="nv-lbl">Ofertas</span></a>
