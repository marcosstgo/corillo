---
import SiteShell from '../../../layouts/SiteShell.astro';
---
<SiteShell
  title="VOD — CORILLO"
  description="Transmisión grabada en CORILLO — plataforma independiente desde Puerto Rico."
  canonical="https://corillo.live/vods/v/"
>
  <fragment slot="head">
    <meta name="theme-color" content="var(--crl-ink)" />
    <style is:global>
      .player-wrap{background:#000;width:100%;aspect-ratio:16/9;max-height:70vh;display:flex;align-items:center;justify-content:center;position:relative}
      .player-wrap video{width:100%;height:100%;display:block}

      .meta-bar{max-width:900px;margin:0 auto;padding:20px 24px 0}
      .meta-channel{display:flex;align-items:center;gap:12px;margin-bottom:12px}
      .meta-ava{width:36px;height:36px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:var(--crl-display);font-size:16px;color:var(--crl-ink)}
      .meta-name{font-family:var(--crl-display);font-size:1.5rem;letter-spacing:3px}
      .meta-title{font-size:1.1rem;font-weight:600;margin:8px 0 4px;color:var(--crl-white);line-height:1.3}
      .meta-stats{display:flex;align-items:center;gap:20px;font-family:var(--crl-mono);font-size:11px;color:var(--crl-muted);letter-spacing:.5px;flex-wrap:wrap}
      .meta-stats i{color:var(--crl-accent);font-size:.65rem}
      .meta-divider{border:none;border-top:1px solid var(--crl-border);margin:16px 0}

      .actions{max-width:900px;margin:0 auto;padding:0 24px 16px;display:flex;gap:10px;flex-wrap:wrap}
      .action-btn{font-family:var(--crl-mono);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;padding:8px 16px;border-radius:6px;border:1px solid var(--crl-border);background:transparent;color:var(--crl-muted);cursor:pointer;transition:.15s;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
      .action-btn:hover{border-color:var(--crl-border-h);color:var(--crl-white)}
      .action-btn.primary{border-color:rgba(var(--crl-accent-rgb),.4);color:var(--crl-accent)}
      .action-btn.primary:hover{background:rgba(var(--crl-accent-rgb),.08)}

      .clip-panel{max-width:900px;margin:0 auto 4px;padding:0 24px;display:none}
      .clip-panel.open{display:block}
      .clip-panel-inner{background:var(--crl-surface);border:1px solid var(--crl-border);border-radius:10px;padding:16px 20px;display:flex;flex-direction:column;gap:14px}
      .clip-panel-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
      .clip-field{display:flex;align-items:center;gap:8px;flex:1;min-width:200px}
      .clip-field label{font-family:var(--crl-mono);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--crl-muted);white-space:nowrap;flex-shrink:0;width:40px}
      .clip-time-input{font-family:var(--crl-mono);font-size:13px;background:var(--crl-bg,#030a0e);border:1px solid var(--crl-border);color:var(--crl-white);border-radius:6px;padding:6px 10px;width:90px;text-align:center;outline:none;transition:.15s}
      .clip-time-input:focus{border-color:rgba(var(--crl-accent-rgb),.6)}
      .clip-mark-btn{font-family:var(--crl-mono);font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:5px 10px;border-radius:5px;border:1px solid var(--crl-border);background:transparent;color:var(--crl-muted);cursor:pointer;transition:.15s;white-space:nowrap}
      .clip-mark-btn:hover{border-color:var(--crl-border-h);color:var(--crl-white)}
      .clip-dur-label{font-family:var(--crl-mono);font-size:10px;letter-spacing:1px;color:var(--crl-muted);margin-left:4px}
      .clip-dur-label span{color:var(--crl-accent)}
      .clip-panel-actions{display:flex;gap:8px;justify-content:flex-end}
      .clip-cancel-btn{font-family:var(--crl-mono);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;padding:8px 16px;border-radius:6px;border:1px solid var(--crl-border);background:transparent;color:var(--crl-muted);cursor:pointer;transition:.15s}
      .clip-cancel-btn:hover{border-color:var(--crl-border-h);color:var(--crl-white)}
      .clip-gen-btn{font-family:var(--crl-mono);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;padding:8px 18px;border-radius:6px;border:1px solid rgba(var(--crl-accent-rgb),.5);background:rgba(var(--crl-accent-rgb),.08);color:var(--crl-accent);cursor:pointer;transition:.15s}
      .clip-gen-btn:hover{background:rgba(var(--crl-accent-rgb),.15);border-color:var(--crl-accent)}
      .clip-gen-btn:disabled{opacity:.5;cursor:not-allowed}

      .unmute-btn{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);z-index:10;font-family:var(--crl-mono);font-size:11px;letter-spacing:2px;text-transform:uppercase;padding:10px 20px;border-radius:8px;border:1px solid rgba(var(--crl-accent-rgb),.5);background:rgba(3,10,14,.85);color:var(--crl-accent);cursor:pointer;display:flex;align-items:center;gap:8px;backdrop-filter:blur(8px);transition:.15s;white-space:nowrap}
      .unmute-btn:hover{background:rgba(var(--crl-accent-rgb),.1);border-color:var(--crl-accent)}
      .unmute-btn.hidden{display:none}

      .not-found{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:16px;text-align:center;padding:40px}
      .not-found-icon{font-size:3rem;color:var(--crl-muted);margin-bottom:8px}
      .not-found h2{font-family:var(--crl-display);font-size:2.5rem;letter-spacing:4px;color:rgba(232,246,255,.2)}
      .not-found p{font-family:var(--crl-mono);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--crl-muted)}

      /* ── Related sections ── */
      .related-wrap{max-width:900px;margin:0 auto;padding:0 24px 48px;display:flex;flex-direction:column;gap:36px}
      .rel-sec{display:flex;flex-direction:column;gap:16px}
      .rel-hd{display:flex;align-items:center;gap:12px}
      .rel-title{font-family:var(--crl-display);font-size:22px;letter-spacing:3px;white-space:nowrap;flex-shrink:0}
      .rel-count{font-family:var(--crl-mono);font-size:11px;letter-spacing:1.5px;color:var(--crl-muted);flex-shrink:0}
      .rel-rule{flex:1;height:1px;background:var(--crl-border)}
      .rel-more{font-family:var(--crl-mono);font-size:10px;letter-spacing:1px;color:var(--crl-accent);white-space:nowrap;text-decoration:none;flex-shrink:0;transition:opacity .15s}
      .rel-more:hover{opacity:.7}
      .rel-rail{display:flex;gap:14px;overflow-x:auto;scrollbar-width:none;padding-bottom:6px;scroll-snap-type:x mandatory}
      .rel-rail::-webkit-scrollbar{display:none}

      /* ── Related card ── */
      .rel-card{
        flex:0 0 220px;scroll-snap-align:start;
        border-radius:12px;overflow:hidden;
        background:var(--crl-surface);border:1px solid var(--crl-border);
        text-decoration:none;color:inherit;
        transition:border-color .25s cubic-bezier(.4,0,.2,1),transform .25s cubic-bezier(.4,0,.2,1),box-shadow .25s;
        display:flex;flex-direction:column;
      }
      .rel-card:hover{
        border-color:var(--crl-border-h);
        transform:translateY(-5px) scale(1.01);
        box-shadow:0 20px 48px rgba(0,0,0,.5),0 0 0 1px rgba(var(--crl-accent-rgb),.25),0 0 32px rgba(var(--crl-accent-rgb),.1);
      }
      .rel-card:has(.rel-live-pill){border-color:rgba(var(--crl-hot-rgb,206,17,38),.25)}
      .rel-card:has(.rel-live-pill):hover{
        border-color:rgba(var(--crl-hot-rgb,206,17,38),.45);
        box-shadow:0 20px 48px rgba(0,0,0,.5),0 0 0 1px rgba(206,17,38,.3),0 0 32px rgba(206,17,38,.12);
      }
      .rel-card-thumb{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#050a10,#0a1820);overflow:hidden;flex-shrink:0}
      .rel-card-thumb::after{
        content:'';position:absolute;inset:0;z-index:2;pointer-events:none;
        background:linear-gradient(135deg,rgba(var(--crl-accent-rgb),.13) 0%,transparent 45%,rgba(232,200,74,.07) 100%);
        transition:opacity .25s;
      }
      .rel-card:hover .rel-card-thumb::after{opacity:1.5}
      .rel-card-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}
      .rel-card-dur{position:absolute;bottom:5px;right:5px;z-index:3;font-family:var(--crl-mono);font-size:9px;font-weight:700;background:rgba(0,0,0,.82);color:#fff;padding:2px 6px;border-radius:3px}
      .rel-live-pill{
        position:absolute;top:7px;left:7px;z-index:3;
        font-family:var(--crl-mono);font-size:9px;font-weight:700;letter-spacing:2px;
        background:var(--crl-hot);color:#fff;
        padding:3px 8px;border-radius:4px;
        display:flex;align-items:center;gap:5px;
        box-shadow:0 0 12px rgba(206,17,38,.5);
      }
      .rel-live-pill::before{content:'';width:5px;height:5px;border-radius:50%;background:#fff;animation:blink 1.2s infinite}
      .rel-viewers{position:absolute;top:7px;right:7px;z-index:3;font-family:var(--crl-mono);font-size:9px;font-weight:700;background:rgba(0,0,0,.7);backdrop-filter:blur(4px);color:#fff;padding:2px 6px;border-radius:3px}
      .rel-card-body{padding:11px 12px 13px;display:flex;gap:9px;align-items:flex-start}
      .rel-card-ava{width:32px;height:32px;border-radius:5px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:var(--crl-display);font-size:15px;color:#000;overflow:hidden}
      .rel-card-ava img{width:100%;height:100%;object-fit:cover;border-radius:5px}
      .rel-card-ava.is-live{box-shadow:0 0 0 2px var(--crl-surface),0 0 0 3px var(--crl-hot),0 0 14px rgba(206,17,38,.4)}
      .rel-card-info{min-width:0;flex:1}
      .rel-card-name{font-family:var(--crl-display);font-size:17px;letter-spacing:1.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.1;margin-bottom:3px}
      .rel-card-sub{font-family:var(--crl-mono);font-size:10px;color:var(--crl-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .rel-card-thumb-bg{position:absolute;inset:0;opacity:.85;mix-blend-mode:overlay;z-index:0}
    </style>
  </fragment>

<div id="content"></div>
<div id="related"></div>

<script>
const PB = 'https://pb.corillo.live';

function fmtDuration(s: number) {
  if (!s) return '—';
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const ss = Math.floor(s % 60);
  if (h > 0) return `${h}h ${m.toString().padStart(2,'0')}m`;
  return `${m}:${ss.toString().padStart(2,'0')}`;
}

function fmtSize(bytes: number) {
  if (!bytes) return '—';
  if (bytes > 1073741824) return (bytes / 1073741824).toFixed(1) + ' GB';
  return (bytes / 1048576).toFixed(0) + ' MB';
}

function fmtDate(iso: string) {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('es-PR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
}

const _streamerMap: Record<string, any> = {};
for (const s of ((window as any).STREAMERS || [])) { if (s.key) _streamerMap[s.key] = s; }
fetch('/api/streamers', { signal: AbortSignal.timeout(5000) })
  .then(r => r.ok ? r.json() : null)
  .then((list: any[] | null) => { if (list) { for (const s of list) _streamerMap[s.key] = s; } })
  .catch(() => {});

function streamerInfo(channel: string) {
  return _streamerMap[channel] || { key: channel, name: channel.toUpperCase(), color: 'var(--crl-accent)', ava: channel[0]?.toUpperCase() };
}

function showNotFound() {
  document.getElementById('content')!.innerHTML = `
    <div class="not-found">
      <div class="not-found-icon"><i class="fa-solid fa-film"></i></div>
      <h2>VOD NO ENCONTRADO</h2>
      <p>Este VOD no existe o fue eliminado</p>
      <a href="/vods/" class="action-btn primary" style="margin-top:8px"><i class="fa-solid fa-arrow-left"></i> Ver todos los VODs</a>
    </div>`;
}

async function init() {
  const id = new URLSearchParams(location.search).get('id');
  if (!id) { showNotFound(); return; }

  let vod: any;
  try {
    const r = await fetch(`${PB}/api/collections/vods/records/${id}`);
    if (!r.ok) { showNotFound(); return; }
    vod = await r.json();
  } catch { showNotFound(); return; }

  const s = streamerInfo(vod.channel);
  const colorStyle = s.color ? `background:${s.color}` : 'background:var(--crl-accent)';
  const videoUrl   = `/vods/${vod.channel}/${vod.filename}`;
  const posterAttr = vod.thumb ? `poster="${vod.thumb}"` : '';

  const pageTitle = vod.title ? `${vod.title} — ${s.name}` : s.name;
  document.title = `${pageTitle} — VOD — CORILLO`;

  document.getElementById('content')!.innerHTML = `
    <div class="player-wrap">
      <video id="vodVideo" controls autoplay muted playsinline preload="metadata" src="${videoUrl}" ${posterAttr}></video>
      <button class="unmute-btn" id="unmuteBtn"><i class="fa-solid fa-volume-xmark"></i> Activar sonido</button>
    </div>
    <div class="meta-bar">
      <div class="meta-channel">
        <div class="meta-ava" style="${colorStyle}">${s.avatar_url ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">` : (s.name||'?')[0].toUpperCase()}</div>
        <a href="/${vod.channel}/" class="meta-name" style="color:${s.color||'var(--crl-white)'};text-decoration:none">${s.name}</a>
      </div>
      ${vod.title ? `<div class="meta-title">${vod.title}</div>` : ''}
      <div class="meta-stats">
        <span><i class="fa-regular fa-calendar"></i> ${fmtDate(vod.date)}</span>
        <span><i class="fa-solid fa-clock"></i> ${fmtDuration(vod.duration)}</span>
        <span><i class="fa-solid fa-weight-hanging"></i> ${fmtSize(vod.size)}</span>
      </div>
      <hr class="meta-divider">
    </div>
    <div class="actions">
      <a href="/${vod.channel}/" class="action-btn"><i class="fa-solid fa-tower-broadcast"></i> Canal de ${s.name}</a>
      <a href="/vods/?ch=${vod.channel}" class="action-btn"><i class="fa-solid fa-film"></i> Más VODs de ${s.name}</a>
      <button class="action-btn" id="copyLinkBtn"><i class="fa-solid fa-link"></i> Copiar enlace</button>
      <button class="action-btn" id="clipVodBtn"><i class="fa-solid fa-scissors"></i> Descargar clip</button>
    </div>
    <div class="clip-panel" id="clipPanel">
      <div class="clip-panel-inner">
        <div class="clip-panel-row">
          <div class="clip-field">
            <label>Inicio</label>
            <input class="clip-time-input" id="clipStart" type="text" value="0:00:00" spellcheck="false">
            <button class="clip-mark-btn" id="markStart">Marcar aquí</button>
          </div>
          <div class="clip-field">
            <label>Fin</label>
            <input class="clip-time-input" id="clipEnd" type="text" value="0:00:30" spellcheck="false">
            <button class="clip-mark-btn" id="markEnd">Marcar aquí</button>
          </div>
          <div class="clip-dur-label">Duración: <span id="clipDurDisplay">30s</span></div>
        </div>
        <div class="clip-panel-actions">
          <button class="clip-cancel-btn" id="clipCancelBtn">Cancelar</button>
          <button class="clip-gen-btn" id="clipGenBtn"><i class="fa-solid fa-scissors"></i> Generar clip</button>
        </div>
      </div>
    </div>`;

  const video = document.getElementById('vodVideo') as HTMLVideoElement;
  const unmuteBtn = document.getElementById('unmuteBtn')!;

  // Restore saved mute state
  if (localStorage.getItem('corillo_muted') === 'false') {
    video.muted = false;
    setTimeout(() => { if (video.muted) unmuteBtn.classList.remove('hidden'); else unmuteBtn.classList.add('hidden'); }, 300);
  }

  unmuteBtn.addEventListener('click', () => {
    video.muted = false;
    localStorage.setItem('corillo_muted', 'false');
    unmuteBtn.classList.add('hidden');
  });
  video.addEventListener('volumechange', () => { if (!video.muted) unmuteBtn.classList.add('hidden'); });

  document.getElementById('copyLinkBtn')!.addEventListener('click', () => {
    navigator.clipboard.writeText(location.href).then(() => {
      const btn = document.getElementById('copyLinkBtn')!;
      btn.innerHTML = '<i class="fa-solid fa-check"></i> Copiado';
      setTimeout(() => { btn.innerHTML = '<i class="fa-solid fa-link"></i> Copiar enlace'; }, 2000);
    });
  });

  // Load related content async (non-blocking)
  loadRelated(vod.channel, id);

  // ── Clip panel ──────────────────────────────────────────
  function parseSecs(val: string): number {
    const parts = val.trim().split(':').map(Number);
    if (parts.some(isNaN)) return 0;
    if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
    if (parts.length === 2) return parts[0] * 60 + parts[1];
    return parts[0] || 0;
  }
  function fmtSecs(s: number): string {
    s = Math.max(0, Math.floor(s));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const ss = s % 60;
    return `${h}:${m.toString().padStart(2,'0')}:${ss.toString().padStart(2,'0')}`;
  }

  const clipPanel  = document.getElementById('clipPanel')!;
  const clipVodBtn = document.getElementById('clipVodBtn') as HTMLButtonElement;
  const startInput = document.getElementById('clipStart') as HTMLInputElement;
  const endInput   = document.getElementById('clipEnd')   as HTMLInputElement;
  const durDisplay = document.getElementById('clipDurDisplay')!;
  const clipGenBtn = document.getElementById('clipGenBtn') as HTMLButtonElement;

  function updateDurDisplay() {
    const dur = parseSecs(endInput.value) - parseSecs(startInput.value);
    durDisplay.textContent = dur > 0 ? `${dur}s` : '—';
    durDisplay.style.color = (dur <= 0 || dur > 300) ? 'var(--crl-hot,#ce1126)' : 'var(--crl-accent)';
  }

  clipVodBtn.addEventListener('click', () => {
    const cur = Math.floor(video.currentTime || 0);
    const end = Math.min(cur + 30, Math.floor(video.duration || cur + 30));
    startInput.value = fmtSecs(cur);
    endInput.value   = fmtSecs(end);
    updateDurDisplay();
    clipPanel.classList.toggle('open');
  });

  document.getElementById('markStart')!.addEventListener('click', () => {
    startInput.value = fmtSecs(Math.floor(video.currentTime || 0));
    updateDurDisplay();
  });
  document.getElementById('markEnd')!.addEventListener('click', () => {
    endInput.value = fmtSecs(Math.floor(video.currentTime || 0));
    updateDurDisplay();
  });
  document.getElementById('clipCancelBtn')!.addEventListener('click', () => {
    clipPanel.classList.remove('open');
  });
  startInput.addEventListener('input', updateDurDisplay);
  endInput.addEventListener('input', updateDurDisplay);

  clipGenBtn.addEventListener('click', async () => {
    const t   = parseSecs(startInput.value);
    const end = parseSecs(endInput.value);
    const dur = end - t;
    if (dur <= 0 || dur > 300) {
      durDisplay.textContent = dur <= 0 ? 'El fin debe ser mayor que el inicio' : 'Máx 5 minutos';
      durDisplay.style.color = 'var(--crl-hot,#ce1126)';
      return;
    }
    const orig = clipGenBtn.innerHTML;
    clipGenBtn.disabled = true;
    clipGenBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generando…';
    try {
      const timeout = Math.min(dur * 2 + 15, 70) * 1000;
      const r = await fetch(`/api/clip/vod/${vod.id}?t=${t}&dur=${dur}`, { signal: AbortSignal.timeout(timeout) });
      if (!r.ok) throw new Error();
      const blob = await r.blob();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `clip_${vod.channel}_${t}s.mp4`;
      a.click();
      URL.revokeObjectURL(a.href);
      clipGenBtn.innerHTML = '<i class="fa-solid fa-check"></i> Guardado';
      setTimeout(() => { clipGenBtn.innerHTML = orig; clipGenBtn.disabled = false; clipPanel.classList.remove('open'); }, 2000);
    } catch {
      clipGenBtn.innerHTML = '<i class="fa-solid fa-xmark"></i> Error';
      setTimeout(() => { clipGenBtn.innerHTML = orig; clipGenBtn.disabled = false; }, 2500);
    }
  });
}

init();

/* ── Related content ─────────────────────────────────── */
function relativeTime(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 2)  return 'Hace un momento';
  if (mins < 60) return `Hace ${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Hace ${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'Ayer';
  if (days < 7)  return `Hace ${days} días`;
  return `Hace ${Math.floor(days / 7)} sem`;
}

function relCard(vod: any) {
  const s = streamerInfo(vod.channel);
  const dur = vod.duration ? fmtDuration(vod.duration) : '';
  const thumb = vod.thumb
    ? `<img src="${vod.thumb}" alt="" loading="lazy" onerror="this.style.display='none'">`
    : `<div class="rel-card-thumb-bg" style="background:${s.color||'#1e3a4a'}"></div>`;
  return `<a href="/vods/v/?id=${vod.id}" class="rel-card">
    <div class="rel-card-thumb">${thumb}${dur ? `<span class="rel-card-dur">${dur}</span>` : ''}</div>
    <div class="rel-card-body">
      <div class="rel-card-ava" style="background:${s.color||'#1e3a4a'}">${s.avatar_url ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:3px" alt="">` : (s.ava||s.name[0]).toUpperCase()}</div>
      <div class="rel-card-info">
        <div class="rel-card-name">${s.name}</div>
        <div class="rel-card-sub">${relativeTime(vod.date)}</div>
      </div>
    </div>
  </a>`;
}

function liveCard(s: any, viewers: number) {
  const t = Math.floor(Date.now() / 60000);
  return `<a href="/${s.key}/" class="rel-card">
    <div class="rel-card-thumb">
      <img src="/assets/thumbs/${s.key}.jpg?t=${t}" alt="" loading="lazy" onerror="this.style.display='none'">
      <span class="rel-live-pill">LIVE</span>
      ${viewers > 0 ? `<span class="rel-viewers">${viewers}</span>` : ''}
    </div>
    <div class="rel-card-body">
      <div class="rel-card-ava is-live" style="background:${s.color||'#1e3a4a'}">${s.avatar_url ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:3px" alt="">` : (s.ava||s.name[0]).toUpperCase()}</div>
      <div class="rel-card-info">
        <div class="rel-card-name">${s.name}</div>
        <div class="rel-card-sub">${viewers > 0 ? viewers + ' viewers' : 'En vivo'}</div>
      </div>
    </div>
  </a>`;
}

function relSection(title: string, count: string, moreHref: string, moreLabel: string, cards: string) {
  return `<div class="rel-sec">
    <div class="rel-hd">
      <span class="rel-title">${title}</span>
      ${count ? `<span class="rel-count">${count}</span>` : ''}
      <div class="rel-rule"></div>
      ${moreHref ? `<a href="${moreHref}" class="rel-more">${moreLabel}</a>` : ''}
    </div>
    <div class="rel-rail">${cards}</div>
  </div>`;
}

async function loadRelated(channel: string, currentId: string) {
  const sections: string[] = [];

  // 1. Live now
  try {
    const r = await fetch('/mediamtx-api/v3/paths/list', { signal: AbortSignal.timeout(4000) });
    const j = await r.json();
    const items = (j.items || []) as any[];
    const livePathMap: Record<string, any> = {};
    // Ignorar variantes derivadas del canal (_low = 720p ABR, _rtc = WebRTC): no son streamers.
    for (const p of items) { const m = p.name?.match(/^live\/(.+)$/); if (m && p.ready && !/_(low|rtc)$/.test(m[1])) livePathMap[m[1]] = p; }
    const liveStreamers = Object.entries(livePathMap).map(([key, p]: [string, any]) => ({
      ...(_streamerMap[key] || { key, name: key.toUpperCase(), color: 'var(--crl-accent)', ava: key[0]?.toUpperCase() }),
      _viewers: p.readers?.length ?? 0,
    }));
    if (liveStreamers.length) {
      const cards = liveStreamers.map((s: any) => liveCard(s, s._viewers)).join('');
      sections.push(relSection('EN VIVO AHORA', `${liveStreamers.length} streamers`, '/multiplayer/', 'Multiplayer →', cards));
    }
  } catch {}

  // 2. Más del mismo canal
  try {
    const enc = encodeURIComponent(`channel='${channel}'&&id!='${currentId}'`);
    const r = await fetch(`${PB}/api/collections/vods/records?filter=${enc}&sort=-date&perPage=8&fields=id,channel,filename,thumb,duration,date`);
    const j = await r.json();
    const vods = j.items || [];
    if (vods.length) {
      const s = streamerInfo(channel);
      const cards = vods.map(relCard).join('');
      sections.push(relSection(`MÁS DE ${s.name}`, `${vods.length} VODs`, `/vods/?ch=${channel}`, 'Ver todos →', cards));
    }
  } catch {}

  // 3. De otros canales
  try {
    const enc = encodeURIComponent(`channel!='${channel}'`);
    const r = await fetch(`${PB}/api/collections/vods/records?filter=${enc}&sort=-date&perPage=10&fields=id,channel,filename,thumb,duration,date`);
    const j = await r.json();
    const vods = j.items || [];
    // one per channel, max 6
    const seen = new Set<string>();
    const unique = vods.filter((v: any) => { if (seen.has(v.channel)) return false; seen.add(v.channel); return true; }).slice(0, 6);
    if (unique.length) {
      const cards = unique.map(relCard).join('');
      sections.push(relSection('DE OTROS CANALES', '', '/vods/', 'Ver todos →', cards));
    }
  } catch {}

  if (sections.length) {
    document.getElementById('related')!.innerHTML =
      `<div class="related-wrap">${sections.join('')}</div>`;
  }
}

</script>

