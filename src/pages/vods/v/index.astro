---
import SiteShell from '../../../layouts/SiteShell.astro';
---
<SiteShell
  pageClass="p-legacy"
  title="VOD — CORILLO"
  description="Transmisión grabada en CORILLO — plataforma independiente desde Puerto Rico."
  canonical="https://corillo.live/vods/v/"
>
  <fragment slot="head">
    <meta name="theme-color" content="var(--crl-ink)" />
    <style is:global>
      /* Disposición: reproductor + datos a la izquierda, "Más de…" en columna lateral (patrón YouTube/Twitch) */
      .vd{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;max-width:1680px;margin:0 auto;padding:22px var(--h2-gutter) 64px}
      @media(min-width:1100px){.vd{grid-template-columns:minmax(0,1fr) 400px}}
      @media(min-width:1500px){.vd{grid-template-columns:minmax(0,1fr) 450px}}
      .vd-main{min-width:0;display:grid;grid-template-columns:minmax(0,1fr);gap:20px;align-content:start}
      .player-wrap{position:relative;background:#000;aspect-ratio:16/9;border-radius:22px;overflow:hidden;box-shadow:0 30px 70px -30px rgb(0 0 0/.8),0 0 0 1px var(--h2-line)}
      .player-wrap video{width:100%;height:100%;display:block;object-fit:contain}
      .vd-title{margin:0;font:800 clamp(1.5rem,2.8vw,2.3rem)/1.08 var(--h2-display);letter-spacing:-.03em}

      .vd-ch{display:flex;align-items:center;gap:16px;padding:14px 16px;border-radius:22px;background:color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line)}
      .vd-ava{flex:none;width:58px;height:58px;border-radius:50%;overflow:hidden;display:grid;place-items:center;font:800 1.3rem var(--h2-display);color:#fff;box-shadow:0 0 0 3px var(--h2-ink),0 0 0 5px var(--tc,var(--h2-cyan))}
      .vd-ava img{width:100%;height:100%;object-fit:cover;display:block}
      .vd-ch-t{flex:1;min-width:0}
      .vd-ch-t a{display:block;color:inherit;text-decoration:none;font:800 1.25rem/1.1 var(--h2-display);letter-spacing:-.02em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .vd-ch-t small{display:block;margin-top:5px;color:var(--h2-mute);font:500 .9rem/1.3 var(--h2-body);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .vd-go{flex:none;display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 20px;border-radius:999px;background:var(--h2-cyan);color:var(--h2-ink);text-decoration:none;font:700 .92rem/1 var(--h2-body);transition:box-shadow .15s}
      .vd-go:hover{box-shadow:0 0 0 4px color-mix(in srgb,var(--h2-cyan) 35%,transparent)}

      .vd-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
      .vd-stat{--tc:var(--h2-bone);display:flex;align-items:center;gap:12px;padding:14px;border-radius:20px;background:color-mix(in srgb,var(--tc) 9%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--tc) 22%,transparent);min-width:0}
      .vd-tile{flex:none;width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:color-mix(in srgb,var(--tc) 20%,transparent);color:var(--tc);font-size:1rem}
      .vd-stat small{display:block;margin-bottom:5px;color:var(--h2-mute);font:600 .76rem/1 var(--h2-body)}
      .vd-stat b{display:block;font:800 1rem/1.15 var(--h2-body);overflow:hidden;text-overflow:ellipsis}
      @media(max-width:720px){.vd-stats{grid-template-columns:1fr 1fr}.vd-stat:first-child{grid-column:1/-1}}

      .vd-actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
      .vd-btn{--tc:var(--h2-bone);display:flex;align-items:center;gap:10px;height:52px;padding:0 16px 0 8px;border:0;border-radius:18px;background:color-mix(in srgb,var(--h2-bone) 9%,transparent);color:var(--h2-bone);font:700 .95rem/1 var(--h2-body);text-decoration:none;cursor:pointer;transition:background .15s,transform .15s}
      .vd-btn .vd-tile{width:36px;height:36px;border-radius:12px}
      .vd-btn:hover{background:color-mix(in srgb,var(--h2-bone) 16%,transparent);transform:translateY(-1px)}
      .vd-btn:active{transform:scale(.98)}

      .action-btn{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;border:0;background:color-mix(in srgb,var(--h2-bone) 10%,transparent);color:var(--h2-bone);font:700 .9rem/1 var(--h2-body);text-decoration:none;cursor:pointer}
      .action-btn.primary{background:var(--h2-cyan);color:var(--h2-ink)}

      /* recortar clip */
      .clip-panel{display:none}
      .clip-panel.open{display:block}
      .clip-panel-inner{display:grid;gap:16px;padding:18px 20px;border-radius:22px;background:color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line)}
      .clip-panel-row{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
      .clip-field{display:flex;align-items:center;gap:10px;flex:1;min-width:230px}
      .clip-field label{flex:none;width:44px;color:var(--h2-mute);font:700 .85rem/1 var(--h2-body)}
      .clip-time-input{width:100px;padding:10px 12px;border-radius:12px;border:1px solid var(--h2-line);background:var(--h2-ink);color:var(--h2-bone);font:600 .95rem 'Space Mono',ui-monospace,monospace}
      .clip-time-input:focus{outline:none;border-color:var(--h2-cyan)}
      .clip-mark-btn,.clip-cancel-btn{padding:10px 14px;border-radius:999px;border:0;background:color-mix(in srgb,var(--h2-bone) 10%,transparent);color:var(--h2-bone);font:700 .82rem/1 var(--h2-body);cursor:pointer}
      .clip-mark-btn:hover,.clip-cancel-btn:hover{background:color-mix(in srgb,var(--h2-bone) 18%,transparent)}
      .clip-dur-label{color:var(--h2-mute);font:600 .9rem var(--h2-body)}
      .clip-dur-label span{color:var(--h2-cyan);font-weight:800}
      .clip-panel-actions{display:flex;gap:8px;justify-content:flex-end}
      .clip-gen-btn{padding:11px 20px;border-radius:999px;border:0;background:var(--h2-cyan);color:var(--h2-ink);font:800 .9rem/1 var(--h2-body);cursor:pointer}
      .clip-gen-btn:disabled{opacity:.5;cursor:not-allowed}

      .unmute-btn{position:absolute;bottom:64px;left:50%;transform:translateX(-50%);z-index:10;display:inline-flex;align-items:center;gap:9px;padding:11px 18px;border:0;border-radius:999px;background:var(--h2-bone);color:var(--h2-ink);font:700 .88rem/1 var(--h2-body);cursor:pointer;box-shadow:0 10px 30px rgb(0 0 0/.4)}
      .unmute-btn.hidden{display:none}

      .not-found{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:50vh;gap:14px;text-align:center;padding:40px}
      .not-found-icon{font-size:3rem;color:var(--h2-mute)}
      .not-found h2{margin:0;font:800 2.2rem/1 var(--h2-display);letter-spacing:-.03em}
      .not-found p{margin:0;color:var(--h2-mute);font:500 1rem var(--h2-body)}

      /* ── columna lateral: más contenido ── */
      .vd-side{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;align-content:start;min-width:0}
      .rel-sec{display:grid;gap:10px}
      .rel-hd{display:flex;align-items:baseline;gap:10px}
      .rel-title{font:800 1.3rem/1 var(--h2-display);letter-spacing:-.025em}
      .rel-count{color:var(--h2-mute);font:500 .85rem var(--h2-body)}
      .rel-rule{display:none}
      .rel-more{margin-left:auto;color:var(--h2-cyan);font:700 .85rem var(--h2-body);text-decoration:none;white-space:nowrap}
      .rel-more:hover{text-decoration:underline}
      .rel-rail{display:grid;gap:4px}
      .rel-card{display:grid;grid-template-columns:168px minmax(0,1fr);gap:14px;align-items:center;padding:8px;margin:0 -8px;border-radius:18px;color:inherit;text-decoration:none;transition:background .15s}
      .rel-card:hover{background:color-mix(in srgb,var(--h2-bone) 8%,transparent)}
      .rel-card-thumb{position:relative;aspect-ratio:16/9;border-radius:13px;overflow:hidden;background:var(--h2-panel)}
      .rel-card-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .35s}
      .rel-card:hover .rel-card-thumb img{transform:scale(1.05)}
      .rel-card-thumb-bg{position:absolute;inset:0;opacity:.8}
      .rel-card-dur{position:absolute;right:6px;bottom:6px;padding:3px 7px;border-radius:7px;background:rgb(0 0 0/.75);color:#fff;font:700 .72rem/1 var(--h2-body);font-variant-numeric:tabular-nums}
      .rel-live-pill{position:absolute;top:7px;left:7px;display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:999px;background:var(--h2-live);color:#fff;font:800 .68rem/1 var(--h2-body)}
      .rel-live-pill::before{content:'';width:6px;height:6px;border-radius:50%;background:#fff;animation:blink 1.2s infinite}
      .rel-viewers{position:absolute;top:7px;right:7px;padding:4px 8px;border-radius:999px;background:rgb(0 0 0/.65);color:#fff;font:700 .7rem/1 var(--h2-body)}
      .rel-card-body{min-width:0;display:block;padding:0}
      .rel-card-t{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font:700 1rem/1.2 var(--h2-display);letter-spacing:-.015em}
      .rel-card-sub{margin-top:6px;color:var(--h2-mute);font:500 .84rem/1.3 var(--h2-body)}
      @media(max-width:560px){.rel-card{grid-template-columns:132px minmax(0,1fr);gap:12px}}
    </style>
  </fragment>

<div class="vd">
  <div class="vd-main" id="content">
    <div class="sk sk-thumb" style="border-radius:22px" aria-hidden="true"></div>
    <span class="sk sk-line lg" style="width:62%" aria-hidden="true"></span>
    <span class="sk sk-line" style="width:100%;height:78px;border-radius:22px" aria-hidden="true"></span>
    <span class="sk-label" role="status">Cargando transmisión…</span>
  </div>
  <aside class="vd-side" id="related" aria-label="Más contenido"></aside>
</div>

<script>
const PB = 'https://pb.corillo.live';

function fmtDuration(s: number) {
  if (!s) return '—';
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const ss = Math.floor(s % 60);
  if (h > 0) return `${h}h ${m.toString().padStart(2,'0')}m`;
  return `${m}:${ss.toString().padStart(2,'0')}`;
}

function fmtSize(bytes: number) {
  if (!bytes) return '—';
  if (bytes > 1073741824) return (bytes / 1073741824).toFixed(1) + ' GB';
  return (bytes / 1048576).toFixed(0) + ' MB';
}

function fmtDate(iso: string) {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('es-PR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
}

const _streamerMap: Record<string, any> = {};
for (const s of ((window as any).STREAMERS || [])) { if (s.key) _streamerMap[s.key] = s; }
fetch('/api/streamers', { signal: AbortSignal.timeout(5000) })
  .then(r => r.ok ? r.json() : null)
  .then((list: any[] | null) => { if (list) { for (const s of list) _streamerMap[s.key] = s; } })
  .catch(() => {});

function streamerInfo(channel: string) {
  return _streamerMap[channel] || { key: channel, name: channel.toUpperCase(), color: 'var(--crl-accent)', ava: channel[0]?.toUpperCase() };
}

function showNotFound() {
  document.getElementById('content')!.innerHTML = `
    <div class="not-found">
      <div class="not-found-icon"><i class="fa-solid fa-film"></i></div>
      <h2>VOD NO ENCONTRADO</h2>
      <p>Este VOD no existe o fue eliminado</p>
      <a href="/vods/" class="action-btn primary" style="margin-top:8px"><i class="fa-solid fa-arrow-left"></i> Ver todos los VODs</a>
    </div>`;
}

async function init() {
  const id = new URLSearchParams(location.search).get('id');
  if (!id) { showNotFound(); return; }

  let vod: any;
  try {
    const r = await fetch(`${PB}/api/collections/vods/records/${id}`);
    if (!r.ok) { showNotFound(); return; }
    vod = await r.json();
  } catch { showNotFound(); return; }

  const s = streamerInfo(vod.channel);
  const colorStyle = s.color ? `background:${s.color}` : 'background:var(--crl-accent)';
  const videoUrl   = `/vods/${vod.channel}/${vod.filename}`;
  const posterAttr = vod.thumb ? `poster="${vod.thumb}?v=2"` : '';

  const titleTxt = vod.title || `Transmisión del ${new Date(vod.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'long' })}`;
  const pageTitle = `${titleTxt} — ${s.name}`;
  document.title = `${pageTitle} — VOD — CORILLO`;

  document.getElementById('content')!.innerHTML = `
    <div class="player-wrap">
      <video id="vodVideo" controls autoplay muted playsinline preload="metadata" src="${videoUrl}" ${posterAttr}></video>
      <button class="unmute-btn" id="unmuteBtn"><i class="fa-solid fa-volume-xmark"></i> Activar sonido</button>
    </div>
    <h1 class="vd-title">${titleTxt}</h1>
    <div class="vd-ch" style="--tc:${s.color || 'var(--h2-cyan)'}">
      <div class="vd-ava" style="${colorStyle}">${s.avatar_url ? `<img src="${s.avatar_url}" alt="">` : (s.name||'?')[0].toUpperCase()}</div>
      <div class="vd-ch-t"><a href="/${vod.channel}/">${s.name}</a>${s.sub ? `<small>${s.sub}</small>` : ''}</div>
      <a href="/${vod.channel}/" class="vd-go"><i class="fa-solid fa-tower-broadcast"></i> Ver canal</a>
    </div>
    <div class="vd-stats">
      <div class="vd-stat" style="--tc:var(--h2-mag)"><span class="vd-tile"><i class="fa-regular fa-calendar"></i></span><div><small>Fecha</small><b>${new Date(vod.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' })}</b></div></div>
      <div class="vd-stat" style="--tc:var(--crl-confirm)"><span class="vd-tile"><i class="fa-solid fa-clock"></i></span><div><small>Duración</small><b>${fmtDuration(vod.duration)}</b></div></div>
      <div class="vd-stat" style="--tc:var(--h2-live)"><span class="vd-tile"><i class="fa-solid fa-weight-hanging"></i></span><div><small>Tamaño</small><b>${fmtSize(vod.size)}</b></div></div>
    </div>
    <div class="vd-actions">
      <a href="/vods/?ch=${vod.channel}" class="vd-btn" style="--tc:var(--crl-confirm)"><span class="vd-tile"><i class="fa-solid fa-film"></i></span>Más de ${s.name}</a>
      <button class="vd-btn" id="copyLinkBtn" style="--tc:var(--h2-mag)"><span class="vd-tile"><i class="fa-solid fa-link"></i></span>Copiar enlace</button>
      <button class="vd-btn" id="clipVodBtn" style="--tc:var(--h2-cyan)"><span class="vd-tile"><i class="fa-solid fa-scissors"></i></span>Descargar clip</button>
    </div>
    <div class="clip-panel" id="clipPanel">
      <div class="clip-panel-inner">
        <div class="clip-panel-row">
          <div class="clip-field">
            <label>Inicio</label>
            <input class="clip-time-input" id="clipStart" type="text" value="0:00:00" spellcheck="false">
            <button class="clip-mark-btn" id="markStart">Marcar aquí</button>
          </div>
          <div class="clip-field">
            <label>Fin</label>
            <input class="clip-time-input" id="clipEnd" type="text" value="0:00:30" spellcheck="false">
            <button class="clip-mark-btn" id="markEnd">Marcar aquí</button>
          </div>
          <div class="clip-dur-label">Duración: <span id="clipDurDisplay">30s</span></div>
        </div>
        <div class="clip-panel-actions">
          <button class="clip-cancel-btn" id="clipCancelBtn">Cancelar</button>
          <button class="clip-gen-btn" id="clipGenBtn"><i class="fa-solid fa-scissors"></i> Generar clip</button>
        </div>
      </div>
    </div>`;

  const video = document.getElementById('vodVideo') as HTMLVideoElement;
  const unmuteBtn = document.getElementById('unmuteBtn')!;

  // ?t=SEGUNDOS — permite enlazar un momento exacto (lo usan los Reels: "Ver la transmisión completa")
  const t0 = Number(new URLSearchParams(location.search).get('t'));
  if (t0 > 0) video.addEventListener('loadedmetadata', () => { video.currentTime = Math.min(t0, video.duration || t0); }, { once: true });

  // Restore saved mute state
  if (localStorage.getItem('corillo_muted') === 'false') {
    video.muted = false;
    setTimeout(() => { if (video.muted) unmuteBtn.classList.remove('hidden'); else unmuteBtn.classList.add('hidden'); }, 300);
  }

  unmuteBtn.addEventListener('click', () => {
    video.muted = false;
    localStorage.setItem('corillo_muted', 'false');
    unmuteBtn.classList.add('hidden');
  });
  video.addEventListener('volumechange', () => { if (!video.muted) unmuteBtn.classList.add('hidden'); });

  document.getElementById('copyLinkBtn')!.addEventListener('click', () => {
    navigator.clipboard.writeText(location.href).then(() => {
      const btn = document.getElementById('copyLinkBtn')!;
      const orig = btn.innerHTML;
      btn.innerHTML = '<span class="vd-tile"><i class="fa-solid fa-check"></i></span>¡Copiado!';
      setTimeout(() => { btn.innerHTML = orig; }, 2000);
    });
  });

  // Load related content async (non-blocking)
  loadRelated(vod.channel, id);

  // ── Clip panel ──────────────────────────────────────────
  function parseSecs(val: string): number {
    const parts = val.trim().split(':').map(Number);
    if (parts.some(isNaN)) return 0;
    if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
    if (parts.length === 2) return parts[0] * 60 + parts[1];
    return parts[0] || 0;
  }
  function fmtSecs(s: number): string {
    s = Math.max(0, Math.floor(s));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const ss = s % 60;
    return `${h}:${m.toString().padStart(2,'0')}:${ss.toString().padStart(2,'0')}`;
  }

  const clipPanel  = document.getElementById('clipPanel')!;
  const clipVodBtn = document.getElementById('clipVodBtn') as HTMLButtonElement;
  const startInput = document.getElementById('clipStart') as HTMLInputElement;
  const endInput   = document.getElementById('clipEnd')   as HTMLInputElement;
  const durDisplay = document.getElementById('clipDurDisplay')!;
  const clipGenBtn = document.getElementById('clipGenBtn') as HTMLButtonElement;

  function updateDurDisplay() {
    const dur = parseSecs(endInput.value) - parseSecs(startInput.value);
    durDisplay.textContent = dur > 0 ? `${dur}s` : '—';
    durDisplay.style.color = (dur <= 0 || dur > 300) ? 'var(--crl-hot,#ce1126)' : 'var(--crl-accent)';
  }

  clipVodBtn.addEventListener('click', () => {
    const cur = Math.floor(video.currentTime || 0);
    const end = Math.min(cur + 30, Math.floor(video.duration || cur + 30));
    startInput.value = fmtSecs(cur);
    endInput.value   = fmtSecs(end);
    updateDurDisplay();
    clipPanel.classList.toggle('open');
  });

  document.getElementById('markStart')!.addEventListener('click', () => {
    startInput.value = fmtSecs(Math.floor(video.currentTime || 0));
    updateDurDisplay();
  });
  document.getElementById('markEnd')!.addEventListener('click', () => {
    endInput.value = fmtSecs(Math.floor(video.currentTime || 0));
    updateDurDisplay();
  });
  document.getElementById('clipCancelBtn')!.addEventListener('click', () => {
    clipPanel.classList.remove('open');
  });
  startInput.addEventListener('input', updateDurDisplay);
  endInput.addEventListener('input', updateDurDisplay);

  clipGenBtn.addEventListener('click', async () => {
    const t   = parseSecs(startInput.value);
    const end = parseSecs(endInput.value);
    const dur = end - t;
    if (dur <= 0 || dur > 300) {
      durDisplay.textContent = dur <= 0 ? 'El fin debe ser mayor que el inicio' : 'Máx 5 minutos';
      durDisplay.style.color = 'var(--crl-hot,#ce1126)';
      return;
    }
    const orig = clipGenBtn.innerHTML;
    clipGenBtn.disabled = true;
    clipGenBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generando…';
    try {
      const timeout = Math.min(dur * 2 + 15, 70) * 1000;
      const r = await fetch(`/api/clip/vod/${vod.id}?t=${t}&dur=${dur}`, { signal: AbortSignal.timeout(timeout) });
      if (!r.ok) throw new Error();
      const blob = await r.blob();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `clip_${vod.channel}_${t}s.mp4`;
      a.click();
      URL.revokeObjectURL(a.href);
      clipGenBtn.innerHTML = '<i class="fa-solid fa-check"></i> Guardado';
      setTimeout(() => { clipGenBtn.innerHTML = orig; clipGenBtn.disabled = false; clipPanel.classList.remove('open'); }, 2000);
    } catch {
      clipGenBtn.innerHTML = '<i class="fa-solid fa-xmark"></i> Error';
      setTimeout(() => { clipGenBtn.innerHTML = orig; clipGenBtn.disabled = false; }, 2500);
    }
  });
}

init();

/* ── Related content ─────────────────────────────────── */
function relativeTime(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 2)  return 'Hace un momento';
  if (mins < 60) return `Hace ${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Hace ${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'Ayer';
  if (days < 7)  return `Hace ${days} días`;
  return `Hace ${Math.floor(days / 7)} sem`;
}

const vodName = (v: any) => v.title || `Transmisión del ${new Date(v.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'long' })}`;
function relCard(vod: any) {
  const s = streamerInfo(vod.channel);
  const dur = vod.duration ? fmtDuration(vod.duration) : '';
  const thumb = vod.thumb
    ? `<img src="${vod.thumb}?v=2" alt="" loading="lazy" onerror="this.style.display='none'">`
    : `<div class="rel-card-thumb-bg" style="background:${s.color||'#1e3a4a'}"></div>`;
  return `<a href="/vods/v/?id=${vod.id}" class="rel-card">
    <div class="rel-card-thumb">${thumb}${dur ? `<span class="rel-card-dur">${dur}</span>` : ''}</div>
    <div class="rel-card-body">
      <div class="rel-card-t">${vodName(vod)}</div>
      <div class="rel-card-sub">${s.name} · ${relativeTime(vod.date)}</div>
    </div>
  </a>`;
}

function liveCard(s: any, viewers: number) {
  const t = Math.floor(Date.now() / 60000);
  return `<a href="/${s.key}/" class="rel-card">
    <div class="rel-card-thumb">
      <img src="/assets/thumbs/${s.key}.jpg?t=${t}" alt="" loading="lazy" onerror="this.style.display='none'">
      <span class="rel-live-pill">EN VIVO</span>
      ${viewers > 0 ? `<span class="rel-viewers"><i class="fa-solid fa-eye"></i> ${viewers}</span>` : ''}
    </div>
    <div class="rel-card-body">
      <div class="rel-card-t">${s.stream_title || s.sub || s.name}</div>
      <div class="rel-card-sub">${s.name} · ${viewers > 0 ? viewers + ' viendo' : 'en vivo ahora'}</div>
    </div>
  </a>`;
}

function relSection(title: string, count: string, moreHref: string, moreLabel: string, cards: string) {
  return `<div class="rel-sec">
    <div class="rel-hd">
      <span class="rel-title">${title}</span>
      ${count ? `<span class="rel-count">${count}</span>` : ''}
      <div class="rel-rule"></div>
      ${moreHref ? `<a href="${moreHref}" class="rel-more">${moreLabel}</a>` : ''}
    </div>
    <div class="rel-rail">${cards}</div>
  </div>`;
}

async function loadRelated(channel: string, currentId: string) {
  const sections: string[] = [];

  // 1. Live now
  try {
    const r = await fetch('/mediamtx-api/v3/paths/list', { signal: AbortSignal.timeout(4000) });
    const j = await r.json();
    const items = (j.items || []) as any[];
    const livePathMap: Record<string, any> = {};
    // Ignorar variantes derivadas del canal (_low = 720p ABR, _rtc = WebRTC): no son streamers.
    for (const p of items) { const m = p.name?.match(/^live\/(.+)$/); if (m && p.ready && !/_(low|rtc)$/.test(m[1])) livePathMap[m[1]] = p; }
    const liveStreamers = Object.entries(livePathMap).map(([key, p]: [string, any]) => ({
      ...(_streamerMap[key] || { key, name: key.toUpperCase(), color: 'var(--crl-accent)', ava: key[0]?.toUpperCase() }),
      _viewers: p.readers?.length ?? 0,
    }));
    if (liveStreamers.length) {
      const cards = liveStreamers.map((s: any) => liveCard(s, s._viewers)).join('');
      sections.push(relSection('En vivo ahora', `${liveStreamers.length} streamers`, '/multiplayer/', 'Multiplayer', cards));
    }
  } catch {}

  // 2. Más del mismo canal
  try {
    const enc = encodeURIComponent(`channel='${channel}'&&id!='${currentId}'`);
    const r = await fetch(`${PB}/api/collections/vods/records?filter=${enc}&sort=-date&perPage=8&fields=id,channel,filename,thumb,duration,date,title`);
    const j = await r.json();
    const vods = j.items || [];
    if (vods.length) {
      const s = streamerInfo(channel);
      const cards = vods.map(relCard).join('');
      sections.push(relSection(`Más de ${s.name}`, `${vods.length} VODs`, `/vods/?ch=${channel}`, 'Ver todos', cards));
    }
  } catch {}

  // 3. De otros canales
  try {
    const enc = encodeURIComponent(`channel!='${channel}'`);
    const r = await fetch(`${PB}/api/collections/vods/records?filter=${enc}&sort=-date&perPage=10&fields=id,channel,filename,thumb,duration,date,title`);
    const j = await r.json();
    const vods = j.items || [];
    // one per channel, max 6
    const seen = new Set<string>();
    const unique = vods.filter((v: any) => { if (seen.has(v.channel)) return false; seen.add(v.channel); return true; }).slice(0, 6);
    if (unique.length) {
      const cards = unique.map(relCard).join('');
      sections.push(relSection('De otros canales', '', '/vods/', 'Ver todos', cards));
    }
  } catch {}

  if (sections.length) {
    document.getElementById('related')!.innerHTML = sections.join('');
  }
}

</script>

