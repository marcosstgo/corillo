---
import SiteShell from '../../layouts/SiteShell.astro';
---
<SiteShell
  title="CORILLO — VODs y transmisiones pasadas"
  description="Explora transmisiones pasadas y VODs de los streamers de CORILLO, una plataforma independiente desde Puerto Rico."
  canonical="https://corillo.live/vods/"
  ogTitle="CORILLO — VODs y transmisiones pasadas"
  ogDescription="Explora transmisiones pasadas y VODs de los streamers de CORILLO, una plataforma independiente desde Puerto Rico."
>
  <fragment slot="head">
    <meta name="theme-color" content="var(--crl-ink)" />
    <link rel="stylesheet" href="/assets/vods2.css?v=1">
  </fragment>

<main class="h2-page va-page">
  <header class="h2-page-hd">
    <h1>VODs</h1>
    <p>Todas las transmisiones grabadas del corillo, para verlas cuando quieras.</p>
    <div class="va-stats" id="vaStats"><span class="sk-label" role="status">Cargando…</span><span class="sk sk-line" style="width:210px" aria-hidden="true"></span></div>
  </header>

  <div class="va-controls">
    <div class="va-pills" id="filters" role="group" aria-label="Filtrar por canal">
      <button class="va-pill active" data-channel="all">Todos</button>
    </div>
    <label class="va-search">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input id="vodSearch" type="search" placeholder="Buscar transmisión" aria-label="Buscar transmisión" autocomplete="off" spellcheck="false">
    </label>
  </div>

  <div class="va-featured" id="vaFeatured">
    <div class="va-fcard" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:24px"></div><div class="va-fcard-info"><span class="sk sk-line lg" style="width:75%"></span><span class="sk sk-line" style="width:34%"></span></div></div>
    <div class="va-side"><div class="va-scard" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:12px"></div><div class="va-scard-body sk-stack"><span class="sk sk-line" style="width:40%"></span><span class="sk sk-line" style="width:85%"></span><span class="sk sk-line" style="width:50%"></span></div></div><div class="va-scard" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:12px"></div><div class="va-scard-body sk-stack"><span class="sk sk-line" style="width:40%"></span><span class="sk sk-line" style="width:85%"></span><span class="sk sk-line" style="width:50%"></span></div></div></div>
  </div>

  <section>
    <div class="va-section-hd" id="vaSecHd">
      <h2>Archivo</h2>
      <span class="va-section-count" id="vaSecCount"></span>
    </div>
    <div class="va-grid" id="vodGrid">
      <div class="va-card" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:16px"></div><div class="va-card-body"><span class="sk sk-line" style="width:82%"></span><span class="sk sk-line" style="width:46%"></span></div></div>
      <div class="va-card" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:16px"></div><div class="va-card-body"><span class="sk sk-line" style="width:82%"></span><span class="sk sk-line" style="width:46%"></span></div></div>
      <div class="va-card" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:16px"></div><div class="va-card-body"><span class="sk sk-line" style="width:82%"></span><span class="sk sk-line" style="width:46%"></span></div></div>
      <div class="va-card" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:16px"></div><div class="va-card-body"><span class="sk sk-line" style="width:82%"></span><span class="sk sk-line" style="width:46%"></span></div></div>
      <div class="va-card" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:16px"></div><div class="va-card-body"><span class="sk sk-line" style="width:82%"></span><span class="sk sk-line" style="width:46%"></span></div></div>
      <div class="va-card" aria-hidden="true"><div class="sk sk-thumb" style="border-radius:16px"></div><div class="va-card-body"><span class="sk sk-line" style="width:82%"></span><span class="sk sk-line" style="width:46%"></span></div></div>
    </div>
  </section>
</main>

<script>
const PB = 'https://pb.corillo.live';

function fmtDuration(s: number) {
  if (!s) return '—';
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const ss = Math.floor(s % 60);
  if (h > 0) return `${h}h ${m.toString().padStart(2,'0')}m`;
  return `${m}:${ss.toString().padStart(2,'0')}`;
}

function fmtDate(iso: string) {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('es-PR', { day: 'numeric', month: 'short', year: 'numeric' });
}

const streamerMap: Record<string, any> = {};

async function loadStreamers() {
  try {
    const r = await fetch('/api/streamers', { signal: AbortSignal.timeout(5000) });
    if (r.ok) { const list = await r.json(); for (const s of list) streamerMap[s.key] = s; }
  } catch {}
  if (!Object.keys(streamerMap).length) {
    for (const s of ((window as any).STREAMERS || [])) { if (s.key) streamerMap[s.key] = s; }
  }
}

function si(ch: string) {
  return streamerMap[ch] || { key: ch, name: ch.toUpperCase(), color: 'var(--crl-accent)', ava: ch[0]?.toUpperCase() };
}

function avaHtml(s: any, size = 20) {
  const bg = s.color || 'var(--crl-accent)';
  const inner = s.avatar_url
    ? `<img src="${s.avatar_url}" alt="" loading="lazy">`
    : (s.ava || s.name?.[0] || '?').toUpperCase();
  return `<span class="va-face" style="background:${bg};width:${size}px;height:${size}px;font-size:${Math.round(size*.42)}px">${inner}</span>`;
}

let allVods: any[] = [];
let activeFilter = 'all';
let searchQ = '';
const hasHover = window.matchMedia('(hover: hover)').matches;

async function loadVods() {
  await loadStreamers();
  try {
    const r = await fetch(`${PB}/api/collections/vods/records?sort=-date&perPage=200`);
    const data = await r.json();
    allVods = data.items || [];
  } catch { allVods = []; }

  buildFilters();
  const initCh = new URLSearchParams(location.search).get('ch');
  if (initCh && initCh !== 'all') setFilter(initCh);
  else renderAll();

  const statsEl = document.getElementById('vaStats')!;
  if (!allVods.length) {
    statsEl.innerHTML = `<span>Aún no hay transmisiones grabadas</span>`;
  } else {
    const channels = new Set(allVods.map(v => v.channel)).size;
    statsEl.innerHTML =
      `<span><strong>${allVods.length}</strong> ${allVods.length !== 1 ? 'transmisiones' : 'transmisión'}</span>` +
      `<span><strong>${channels}</strong> canal${channels !== 1 ? 'es' : ''}</span>`;
  }
}

function buildFilters() {
  const channels = [...new Set(allVods.map(v => v.channel))] as string[];
  const container = document.getElementById('filters')!;
  channels.forEach(ch => {
    const s = si(ch);
    const btn = document.createElement('button');
    btn.className = 'va-pill';
    btn.dataset.channel = ch;
    btn.innerHTML = `<i style="background:${s.color||'var(--crl-accent)'}"></i>${s.name}`;
    container.appendChild(btn);
  });
  container.addEventListener('click', (e: Event) => {
    const pill = (e.target as Element).closest('.va-pill') as HTMLElement | null;
    if (pill) setFilter(pill.dataset.channel!);
  });
}

function setFilter(ch: string) {
  activeFilter = ch;
  document.querySelectorAll('.va-pill').forEach(b => {
    b.classList.toggle('active', (b as HTMLElement).dataset.channel === ch);
  });
  renderAll();
}

/* ── Piezas comunes ── */
function thumbHtml(vod: any, s: any, lazy: boolean, previewClass = '') {
  const bg = s.color || 'var(--crl-accent)';
  const preview = (vod.preview && hasHover)
    ? `<video src="${vod.preview}" muted playsinline preload="none" loop></video>` : '';
  return `<div class="va-thumb">
    <div class="va-thumb-fallback" style="background:${bg}">${(s.ava||s.name[0]).toUpperCase()}</div>
    ${vod.thumb ? `<img src="${vod.thumb}" alt="" loading="${lazy ? 'lazy' : 'eager'}" onerror="this.style.display='none'">` : ''}
    ${preview}
    ${vod.duration ? `<span class="va-dur">${fmtDuration(vod.duration)}</span>` : ''}
  </div>`;
}
const vodLabel = (vod: any, _s: any) => vod.title || `Transmisión del ${new Date(vod.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'long' })}`;

/* ── Destacado grande ── */
function renderFcard(vod: any) {
  const s = si(vod.channel);
  return `<article class="va-fcard" data-id="${vod.id}" tabindex="0" role="link" aria-label="${vodLabel(vod, s)}">
    ${thumbHtml(vod, s, false)}
    <div class="va-fcard-info">
      <div class="va-fcard-ch">${avaHtml(s, 32)} ${s.name}</div>
      <div class="va-fcard-title">${vodLabel(vod, s)}</div>
      <div class="va-meta">${fmtDate(vod.date)}</div>
    </div>
  </article>`;
}

/* ── Laterales ── */
function renderScard(vod: any) {
  const s = si(vod.channel);
  return `<article class="va-scard" data-id="${vod.id}" tabindex="0" role="link" aria-label="${vodLabel(vod, s)}">
    ${thumbHtml(vod, s, false)}
    <div class="va-scard-body">
      <div class="va-scard-ch">${s.name}</div>
      <div class="va-scard-title">${vodLabel(vod, s)}</div>
      <div class="va-meta">${fmtDate(vod.date)}</div>
    </div>
  </article>`;
}

/* ── Archivo ── */
function renderCard(vod: any) {
  const s = si(vod.channel);
  return `<article class="va-card" data-id="${vod.id}" tabindex="0" role="link" aria-label="${vodLabel(vod, s)}">
    ${thumbHtml(vod, s, true)}
    <div class="va-card-body">
      <div class="va-card-title">${vodLabel(vod, s)}</div>
      <div class="va-card-by">${avaHtml(s, 20)} ${s.name} · ${fmtDate(vod.date)}</div>
    </div>
  </article>`;
}

function renderAll() {
  const featEl  = document.getElementById('vaFeatured')!;
  const gridEl  = document.getElementById('vodGrid')!;
  const secHd   = document.getElementById('vaSecHd')!;
  const secCount = document.getElementById('vaSecCount')!;

  let list = activeFilter === 'all' ? allVods : allVods.filter(v => v.channel === activeFilter);
  if (searchQ) {
    const q = searchQ.toLowerCase();
    list = list.filter(v => {
      const s = si(v.channel);
      return (v.title||'').toLowerCase().includes(q) ||
             (s.name||'').toLowerCase().includes(q) ||
             (v.channel||'').toLowerCase().includes(q);
    });
  }

  if (!list.length) {
    featEl.classList.add('hidden');
    secHd.style.display = 'none';
    gridEl.innerHTML = `<p class="va-empty">No hay transmisiones que coincidan${activeFilter !== 'all' ? ' para este canal' : ''}.</p>`;
    return;
  }

  const useFeature = activeFilter === 'all' && !searchQ && list.length >= 3;

  if (useFeature) {
    const [feat, sc1, sc2, ...rest] = list;
    featEl.classList.remove('hidden');
    featEl.innerHTML =
      renderFcard(feat) +
      `<div class="va-side">${renderScard(sc1)}${sc2 ? renderScard(sc2) : ''}</div>`;

    if (rest.length) {
      secHd.style.display = 'flex';
      secCount.textContent = `${rest.length} más`;
      gridEl.innerHTML = rest.map(renderCard).join('');
    } else {
      secHd.style.display = 'none';
      gridEl.innerHTML = '';
    }
  } else {
    featEl.classList.add('hidden');
    secHd.style.display = 'flex';
    secCount.textContent = `${list.length} ${list.length !== 1 ? 'transmisiones' : 'transmisión'}`;
    gridEl.innerHTML = list.map(renderCard).join('');
  }

  /* ── Wire clicks ── */
  [featEl, gridEl].forEach(wrap => {
    wrap.querySelectorAll('[data-id]').forEach(el => {
      const go = () => { location.href = `/vods/v/?id=${(el as HTMLElement).dataset.id}`; };
      el.addEventListener('click', go);
      el.addEventListener('keydown', (e: Event) => { const k = (e as KeyboardEvent).key; if (k === 'Enter' || k === ' ') { e.preventDefault(); go(); } });
    });
  });

  /* ── Wire preview hovers ── */
  if (hasHover) {
    [featEl, gridEl].forEach(wrap => {
      wrap.querySelectorAll('[data-id]').forEach(el => {
        const vid = el.querySelector('video') as HTMLVideoElement | null;
        if (!vid) return;
        el.addEventListener('mouseenter', () => vid.play().catch(() => {}));
        el.addEventListener('mouseleave', () => { vid.pause(); vid.currentTime = 0; });
      });
    });
  }
}

/* ── Search ── */
const searchEl = document.getElementById('vodSearch') as HTMLInputElement | null;
if (searchEl) {
  searchEl.addEventListener('input', (e: Event) => {
    searchQ = (e.target as HTMLInputElement).value.toLowerCase().trim();
    renderAll();
  });
}

loadVods();
</script>

</SiteShell>
