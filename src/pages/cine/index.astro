---
/* /cine/ (1-nov-2026): estreno destacado, lo que está pegao, cartelera en PR, próximos estrenos y cine puertorriqueño. */
import SiteShell from '../../layouts/SiteShell.astro';
import PeliCard from '../../components/cine/PeliCard.astro';
import BanderaPR from '../../components/cine/BanderaPR.astro';

import { hechoEnPR, pegao, cartelera, proximos, fechaLarga, actualizado } from '../../data/cine';

const [pr, top, enCine, vienen] = await Promise.all([hechoEnPR(), pegao(), cartelera(), proximos()]);
const hoy = new Date().toISOString().slice(0, 10);
// Destacado: el próximo estreno boricua si hay uno en las próximas 3 semanas; si no, el estreno grande más cercano.
const prPronto = [...pr].reverse().find(p => p.fondo && p.estreno && p.estreno >= hoy && (new Date(p.estreno).valueOf() - Date.now()) < 21 * 864e5);
const destacado = prPronto || vienen.find(p => p.fondo) || top.find(p => p.fondo) || pr.find(p => p.fondo);
const ld = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Cine — CORILLO', url: 'https://corillo.live/cine/',
  description: 'Estrenos de cine en Puerto Rico, lo que está de moda y el cine puertorriqueño.',
  mainEntity: { '@type': 'ItemList', itemListElement: [...pr, ...vienen, ...enCine].slice(0, 30).map((p, i) => ({
    '@type': 'ListItem', position: i + 1, url: `https://corillo.live/cine/${p.slug}/`, name: p.title })) },
};
---
<SiteShell title="Cine en Puerto Rico: estrenos, cartelera y cine boricua | CORILLO"
           description="Qué hay en el cine en Puerto Rico, los próximos estrenos con fecha de PR, lo que está pegao y lo mejor del cine puertorriqueño, con tráilers y dónde verlas."
           canonical="https://corillo.live/cine/" ogImage={destacado?.fondo}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/cine.css?v=2">
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <div class="cn">
    {destacado && (
      <a class="cn-dest" href={`/cine/${destacado.slug}/`}>
        {destacado.fondo && <img src={destacado.fondo} alt="" fetchpriority="high" decoding="async" />}
        <span class="cn-dest-txt">
          <span class="cn-tags">
            {destacado.pr && <span class="cn-tag pr"><BanderaPR size={11} /> Cine puertorriqueño</span>}
            {destacado.estreno && <span class="cn-tag hot">{destacado.estreno > hoy ? `Estrena el ${fechaLarga(destacado.estreno)}` : `En cines desde el ${fechaLarga(destacado.estreno)}`}</span>}
          </span>
          <b>{destacado.title}</b>
          <span class="cn-dest-sub">{destacado.resumen}</span>
          <span class="play-btn">Ver ficha y tráiler</span>
        </span>
      </a>
    )}

    <header class="cn-hd">
      <h1>Cine</h1>
      <p>Lo que hay en el cine en Puerto Rico, lo que viene, y lo nuestro: el cine hecho en la isla, siempre al frente.</p>
    </header>

    {pr.length > 0 && (
      <section class="cn-bloque cn-bloque-pr">
        <div class="cn-bloque-hd"><h2><BanderaPR size={22} /> Hecho en Puerto Rico</h2><a href="/cine/pr/">Todo el cine boricua</a></div>
        <div class="cn-fila">{pr.slice(0, 12).map((p, i) => <PeliCard p={p} eager={i < 4} />)}</div>
      </section>
    )}

    {top.length > 0 && (
      <section class="cn-bloque">
        <div class="cn-bloque-hd"><h2><i class="fa-solid fa-fire" aria-hidden="true"></i> Lo que está pegao</h2><small>Lo más visto y comentado esta semana</small></div>
        <div class="cn-fila">{top.slice(0, 18).map(p => <PeliCard p={p} />)}</div>
      </section>
    )}

    {enCine.length > 0 && (
      <section class="cn-bloque">
        <div class="cn-bloque-hd"><h2><i class="fa-solid fa-ticket" aria-hidden="true"></i> En cartelera en Puerto Rico</h2><a href="https://caribbeancinemas.com/" target="_blank" rel="noopener">Horarios en Caribbean Cinemas</a></div>
        <div class="cn-fila">{enCine.slice(0, 24).map(p => <PeliCard p={p} />)}</div>
      </section>
    )}

    {vienen.length > 0 && (
      <section class="cn-bloque">
        <div class="cn-bloque-hd"><h2><i class="fa-regular fa-calendar" aria-hidden="true"></i> Próximos estrenos</h2><small>Con la fecha de Puerto Rico</small></div>
        <div class="cn-fila">{vienen.slice(0, 24).map(p => <PeliCard p={p} />)}</div>
      </section>
    )}

    {!top.length && !enCine.length && (
      <p class="cn-nota cn-pronto">La cartelera general (lo que está pegao, lo que hay en el cine y lo que viene) se está conectando. Mientras, aquí está el cine boricua.</p>
    )}

    <aside class="cn-attr" aria-label="Fuente de los datos">
      <a href="https://www.themoviedb.org/" target="_blank" rel="noopener nofollow"><img src="/assets/cine/tmdb-logo.svg" alt="TMDB" width="140" height="18" loading="lazy" /></a>
      <p class="cn-nota">
        {actualizado && <>Cartelera actualizada el {fechaLarga(actualizado.slice(0, 10))}. </>}
        Este sitio usa TMDB y la API de TMDB, pero no está avalado, certificado ni aprobado por TMDB.
        <span lang="en">(This website uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.)</span>
        Las fichas del cine puertorriqueño las escribe Corillo con fuentes de la prensa de Puerto Rico.
      </p>
    </aside>
  </div>
</SiteShell>
