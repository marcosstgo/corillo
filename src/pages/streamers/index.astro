---
import SiteShell from '../../layouts/SiteShell.astro';
---
<SiteShell
  title="CORILLO — Streamers en Puerto Rico"
  description="Conoce a los streamers de CORILLO, una plataforma de streaming independiente creada en Puerto Rico."
  canonical="https://corillo.live/streamers/"
>
  <fragment slot="head">
    <meta name="theme-color" content="#06143f" />
    <link rel="stylesheet" href="/assets/streamers2.css?v=2">
  </fragment>

<main class="h2-page sr-page">
  <header class="h2-page-hd">
    <h1>Streamers</h1>
    <p>Los creadores que hacen vibrar la plataforma desde Puerto Rico y más allá.</p>
    <div class="sr-stats" id="heroStats" hidden>
      <span><strong id="statTotal">0</strong> canales</span>
      <span class="is-on"><strong id="statLive">0</strong> en vivo</span>
      <span><strong id="statViewers">0</strong> viendo ahora</span>
    </div>
  </header>

  <section class="sr-live-wrap" id="liveRailWrap" aria-label="En vivo ahora">
    <h2 class="sr-live-title">En vivo ahora</h2>
    <div class="sr-live-rail" id="liveRail"></div>
  </section>

  <div class="sr-tools">
    <div class="sr-filters" id="filterRow" role="group" aria-label="Filtrar por categoría">
      <button class="filter-btn active" data-cat="">Todos</button>
      <button class="filter-btn" data-cat="Gaming">Gaming</button>
      <button class="filter-btn" data-cat="Just Chatting">Just Chatting</button>
      <button class="filter-btn" data-cat="Tecnología">Tecnología</button>
      <button class="filter-btn" data-cat="Podcast">Podcast</button>
    </div>
    <label class="sr-search">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input id="searchInput" type="search" placeholder="Buscar streamer" aria-label="Buscar streamer" autocomplete="off" spellcheck="false">
    </label>
    <div class="sr-view" role="group" aria-label="Distribución de la lista">
      <button type="button" class="sr-view-btn" data-cols="2" aria-pressed="true" title="Dos columnas" aria-label="Dos columnas"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i></button>
      <button type="button" class="sr-view-btn" data-cols="1" aria-pressed="false" title="Una columna" aria-label="Una columna"><i class="fa-solid fa-list" aria-hidden="true"></i></button>
    </div>
  </div>

  <div class="sr-list" id="grid" data-cols="2">
    <span class="sk-label" role="status">Cargando streamers…</span>
    <div class="sk-sr" aria-hidden="true"><span class="sk sk-face"></span><div class="sk-stack"><span class="sk sk-line lg" style="width:min(340px,62%)"></span><span class="sk sk-line" style="width:min(220px,40%)"></span></div><span class="sk sk-pill"></span></div>
    <div class="sk-sr" aria-hidden="true"><span class="sk sk-face"></span><div class="sk-stack"><span class="sk sk-line lg" style="width:min(340px,62%)"></span><span class="sk sk-line" style="width:min(220px,40%)"></span></div><span class="sk sk-pill"></span></div>
    <div class="sk-sr" aria-hidden="true"><span class="sk sk-face"></span><div class="sk-stack"><span class="sk sk-line lg" style="width:min(340px,62%)"></span><span class="sk sk-line" style="width:min(220px,40%)"></span></div><span class="sk sk-pill"></span></div>
    <div class="sk-sr" aria-hidden="true"><span class="sk sk-face"></span><div class="sk-stack"><span class="sk sk-line lg" style="width:min(340px,62%)"></span><span class="sk sk-line" style="width:min(220px,40%)"></span></div><span class="sk sk-pill"></span></div>
    <div class="sk-sr" aria-hidden="true"><span class="sk sk-face"></span><div class="sk-stack"><span class="sk sk-line lg" style="width:min(340px,62%)"></span><span class="sk sk-line" style="width:min(220px,40%)"></span></div><span class="sk sk-pill"></span></div>
  </div>
<script is:inline>try{if(localStorage.getItem('corillo-streamers-cols')==='1')document.getElementById('grid').dataset.cols='1';}catch(e){}</script>
</main>

<script>
(function () {
  const POLL_MS = 15000;
  const PB_URL  = 'https://pb.corillo.live';

  const grid = document.getElementById('grid');

  let streamers  = [];
  let liveSet    = new Set();
  let viewersMap = {};
  let lastVods   = {};
  let searchQ    = '';
  let filterCat  = '';
  let thumbTick  = Math.floor(Date.now() / 60000);

  /* ── Helpers ── */
  function relTime(dateStr) {
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 2)  return 'Hace un momento';
    if (mins < 60) return `Hace ${mins}m`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24)  return `Hace ${hrs}h`;
    const days = Math.floor(hrs / 24);
    if (days === 1) return 'Ayer';
    if (days < 7)  return `Hace ${days} días`;
    return `Hace ${Math.floor(days / 7)} sem`;
  }

  /* ── Fila de streamer ── */
  function cardHTML(s) {
    const live    = liveSet.has(s.key);
    const viewers = viewersMap[s.key] || 0;
    const last    = lastVods[s.key];
    const face = s.avatar_url
      ? `<img src="${s.avatar_url}" alt="" loading="lazy" onerror="this.remove()">`
      : (s.ava || s.name[0]);
    const social = (href, icon, label) => `<a href="${href}" class="sr-social" target="_blank" rel="noopener" aria-label="${label}" onclick="event.stopPropagation()"><i class="fa-brands fa-${icon}"></i></a>`;
    const socials = [
      s.twitch    ? social(`https://twitch.tv/${s.twitch}`, 'twitch', 'Twitch de ' + s.name) : '',
      s.instagram ? social(`https://instagram.com/${s.instagram}`, 'instagram', 'Instagram de ' + s.name) : '',
      s.tiktok    ? social(`https://tiktok.com/@${s.tiktok}`, 'tiktok', 'TikTok de ' + s.name) : '',
    ].join('');
    const meta = live
      ? `En vivo · ${viewers} viendo${s.stream_title ? ` <span>— ${s.stream_title}</span>` : ''}`
      : (last ? `Última transmisión: ${last.toLowerCase()}` : '');
    return `<article class="sr${live ? ' is-live' : ''}" data-href="/${s.key}/" data-key="${s.key}" role="link" tabindex="0" aria-label="${s.name}${live ? ', en vivo' : ''}">
      <div class="sr-face" style="background:${s.color || '#1e3a4a'}">${face}</div>
      <div class="sr-main">
        <h2 class="sr-name">${s.name}</h2>
        ${s.sub || s.category ? `<p class="sr-sub">${s.sub || s.category}</p>` : ''}
        ${s.bio && s.bio.trim() !== (s.sub || '').trim() ? `<p class="sr-bio">${s.bio}</p>` : ''}
        ${meta ? `<p class="sr-meta">${meta}</p>` : ''}
      </div>
      <div class="sr-side">${socials}<span class="sr-go">${live ? 'Ver en vivo' : 'Ver canal'}</span></div>
    </article>`;
  }

  /* ── Render ── */
  function render() {
    let list = streamers.filter(s => {
      if (filterCat && s.category !== filterCat) return false;
      if (!searchQ) return true;
      return s.name.toLowerCase().includes(searchQ) || (s.key || '').toLowerCase().includes(searchQ);
    });

    // Live primero, luego alfabético
    list = [...list].sort((a, b) => {
      const al = liveSet.has(a.key) ? 1 : 0;
      const bl = liveSet.has(b.key) ? 1 : 0;
      if (bl !== al) return bl - al;
      return (a.name || '').localeCompare(b.name || '');
    });

    if (!list.length) {
      grid.innerHTML = `<p class="sr-empty">Ningún streamer coincide con tu búsqueda.</p>`;
      return;
    }

    grid.innerHTML = list.map(cardHTML).join('');

    grid.querySelectorAll('.sr[data-href]').forEach(card => {
      card.addEventListener('click', e => {
        if (e.target.closest('a')) return;
        window.location.href = card.dataset.href;
      });
      card.addEventListener('keydown', e => {
        if ((e.key === 'Enter' || e.key === ' ') && !e.target.closest('a')) {
          e.preventDefault();
          window.location.href = card.dataset.href;
        }
      });
    });
  }

  /* ── Stats ── */
  function updateStats() {
    const liveCount    = [...liveSet].filter(k => streamers.some(s => s.key === k)).length;
    const totalViewers = Object.entries(viewersMap)
      .filter(([k]) => streamers.some(s => s.key === k))
      .reduce((a, [, v]) => a + v, 0);

    document.getElementById('statTotal').textContent   = streamers.filter(s => s.key).length;
    document.getElementById('statLive').textContent    = liveCount;
    document.getElementById('statViewers').textContent = totalViewers;
    document.getElementById('heroStats').hidden = false;
  }

  /* ── Rail "en vivo ahora" ── */
  function renderLiveRail() {
    const railWrap = document.getElementById('liveRailWrap');
    const rail     = document.getElementById('liveRail');
    const live = streamers.filter(s => s.key && liveSet.has(s.key));

    if (!live.length) { railWrap.classList.remove('show'); rail.innerHTML = ''; return; }

    rail.innerHTML = live.map(s => {
      const viewers = viewersMap[s.key] || 0;
      return `<a class="sr-live" href="/${s.key}/">
        <div class="sr-live-thumb" style="background:${s.color || '#1e3a4a'}">
          <img src="/assets/thumbs/${s.key}.jpg?t=${thumbTick}" onerror="this.style.display='none'" alt="">
          <span class="sr-chip live">En vivo</span>
          <span class="sr-chip n">${viewers} viendo</span>
        </div>
        <strong>${s.name}</strong>
      </a>`;
    }).join('');
    railWrap.classList.add('show');
  }

  /* ── Poll ── */
  async function poll() {
    try {
      const res   = await fetch('/mediamtx-api/v3/paths/list', { signal: AbortSignal.timeout(5000) });
      // Variantes derivadas (_low 720p ABR, _rtc WebRTC) no son streamers.
      const items = ((await res.json()).items || []).filter(p => !/_(low|rtc)$/.test(p.name));
      liveSet     = new Set(items.filter(p => p.ready).map(p => p.name.replace('live/', '')));
      viewersMap  = {};
      for (const p of items) {
        const m = p.name.match(/^live\/(.+)$/);
        if (m) viewersMap[m[1]] = p.readers?.length || 0;
      }
      thumbTick = Math.floor(Date.now() / 60000);
      updateStats();
      renderLiveRail();
      render();
    } catch {}
  }

  /* ── Last VODs ── */
  async function loadLastVods() {
    try {
      const r = await fetch(
        `${PB_URL}/api/collections/vods/records?sort=-date&perPage=100&fields=channel,date`,
        { signal: AbortSignal.timeout(5000) }
      );
      const items = (await r.json()).items || [];
      const seen  = new Set();
      for (const v of items) {
        if (!seen.has(v.channel)) {
          seen.add(v.channel);
          lastVods[v.channel] = relTime(v.date);
        }
      }
      render();
    } catch {}
  }

  /* ── Distribución: 2 columnas (por defecto) o 1; se recuerda la elección ── */
  (function () {
    const btns = document.querySelectorAll('.sr-view-btn');
    const set = (cols, save) => {
      grid.dataset.cols = cols;
      btns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.cols === cols)));
      if (save) { try { localStorage.setItem('corillo-streamers-cols', cols); } catch (e) {} }
    };
    set(grid.dataset.cols === '1' ? '1' : '2', false);
    btns.forEach(b => b.addEventListener('click', () => set(b.dataset.cols === '1' ? '1' : '2', true)));
  })();

  /* ── Search ── */
  document.getElementById('searchInput').addEventListener('input', e => {
    searchQ = e.target.value.toLowerCase().trim();
    render();
  });
  // buscador global del menú: filtra aquí en vivo y también entra con ?q=
  window.addEventListener('crl-search', e => {
    searchQ = String(e.detail || '');
    document.getElementById('searchInput').value = searchQ;
    render();
  });
  const q0 = new URLSearchParams(location.search).get('q');
  if (q0) { document.getElementById('searchInput').value = q0; searchQ = q0.toLowerCase().trim(); }

  /* ── Filters ── */
  document.getElementById('filterRow').addEventListener('click', e => {
    const btn = e.target.closest('.filter-btn');
    if (!btn) return;
    filterCat = btn.dataset.cat;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b === btn));
    render();
  });

  /* ── Init ── */
  async function init() {
    try {
      const r = await fetch('/api/streamers', { signal: AbortSignal.timeout(5000) });
      streamers = r.ok ? await r.json() : (window.STREAMERS || []).filter(s => s.key && !s.soon);
    } catch {
      streamers = (window.STREAMERS || []).filter(s => s.key && !s.soon);
    }

    render();
    await poll();
    loadLastVods();
    setInterval(poll, POLL_MS);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) poll(); });
  }

  init();
})();
</script>

</SiteShell>
