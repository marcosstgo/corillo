---
import SiteShell from '../../layouts/SiteShell.astro';
---
<SiteShell
  title="CORILLO — Streamers en Puerto Rico"
  description="Conoce a los streamers de CORILLO, una plataforma de streaming independiente creada en Puerto Rico."
  canonical="https://corillo.live/streamers/"
>
  <fragment slot="head">
    <meta name="theme-color" content="#060608" />
    <style is:global>
      /* ── Hero ── */
      .hero{text-align:center;padding:64px 24px 32px;max-width:1400px;margin:0 auto}
      .hero-label{font-family:var(--crl-mono);font-size:.85rem;letter-spacing:.2em;color:var(--crl-accent);margin-bottom:12px}
      .hero-title{font-family:var(--crl-display);font-size:clamp(3rem,8vw,6rem);line-height:1;color:var(--crl-white);margin:0 0 16px;letter-spacing:.02em}
      .hero-sub{color:var(--crl-muted);font-size:.95rem;max-width:480px;margin:0 auto 20px}

      .hero-stats{
        display:none;align-items:center;justify-content:center;gap:10px;
        font-family:var(--crl-mono);font-size:.82rem;letter-spacing:.06em;
        color:var(--crl-muted);margin-bottom:18px;
      }
      .hero-stats.show{display:flex}
      .hero-stats strong{color:var(--crl-white)}
      .hero-stats .s-live-num{color:#ef4444}
      .hero-stats .sep{opacity:.35}

      .live-pill{
        display:inline-flex;align-items:center;gap:7px;
        background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);
        color:#ef4444;font-family:var(--crl-mono);font-size:.85rem;
        letter-spacing:.1em;padding:6px 14px;border-radius:99px;opacity:0;transition:opacity .3s;
      }
      .live-pill.show{opacity:1}
      .live-pill .dot{width:7px;height:7px;border-radius:50%;background:#ef4444;animation:crl-blink 1.2s ease-in-out infinite}

      /* ── Search ── */
      .search-row{max-width:1400px;margin:0 auto;padding:0 24px 24px}
      .search-box{position:relative;max-width:380px}
      .search-box i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--crl-muted);font-size:.85rem;pointer-events:none}
      .search-box input{
        width:100%;background:var(--crl-surface);border:1px solid var(--crl-border);
        border-radius:10px;padding:10px 14px 10px 38px;
        font-family:var(--crl-mono);font-size:.85rem;color:var(--crl-white);
        outline:none;transition:border-color .2s;box-sizing:border-box;
      }
      .search-box input:focus{border-color:var(--crl-accent)}
      .search-box input::placeholder{color:var(--crl-muted)}

      /* ── Grid ── */
      .grid-wrap{max-width:1400px;margin:0 auto;padding:0 24px 80px}

      /* ── Cards ── */
      .s-card{
        background:var(--crl-surface);border:1px solid var(--crl-border);
        border-radius:16px;overflow:hidden;
        display:flex;flex-direction:column;
        cursor:pointer;text-decoration:none;
        transition:transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s,border-color .25s;
        position:relative;
      }
      .s-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.15)}
      .s-card.is-live{border-color:rgba(239,68,68,.35)}
      .s-card.is-live:hover{box-shadow:0 16px 48px rgba(239,68,68,.18)}
      .s-card:not(.is-live):hover{box-shadow:0 16px 48px rgba(0,0,0,.5)}
      .s-card.soon{opacity:.45;pointer-events:none;background:rgba(255,255,255,.02)}

      /* Live thumbnail hero inside card */
      .s-card-hero{width:100%;aspect-ratio:16/9;overflow:hidden;position:relative;background:#070c10;flex-shrink:0}
      .s-card-hero img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease}
      .s-card:hover .s-card-hero img{transform:scale(1.04)}
      .s-card-hero-overlay{position:absolute;inset:0;background:linear-gradient(to top,#0c1117 0%,transparent 65%)}

      .s-card-accent{height:3px;width:100%;flex-shrink:0}

      .s-card-top{padding:20px 20px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
      .s-avatar{width:64px;height:64px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(255,255,255,.1)}
      .s-avatar-fallback{
        width:64px;height:64px;border-radius:50%;flex-shrink:0;
        display:flex;align-items:center;justify-content:center;
        font-family:var(--crl-display);font-size:1.8rem;
        color:rgba(255,255,255,.9);border:2px solid rgba(255,255,255,.08);
      }
      .s-badges{display:flex;flex-direction:column;align-items:flex-end;gap:5px}
      .s-live-badge{
        display:none;align-items:center;gap:5px;
        background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.4);
        color:#ef4444;font-family:var(--crl-mono);font-size:.62rem;letter-spacing:.08em;
        padding:4px 9px;border-radius:99px;
      }
      .s-live-badge .dot{width:5px;height:5px;border-radius:50%;background:#ef4444;animation:crl-blink 1.2s ease-in-out infinite}
      .is-live .s-live-badge{display:flex}
      .s-viewers{font-family:var(--crl-mono);font-size:.8rem;color:var(--crl-muted);letter-spacing:.05em;display:none}
      .is-live .s-viewers{display:block}

      .s-card-body{padding:14px 20px 16px;flex:1;display:flex;flex-direction:column;gap:6px}
      .s-name{font-family:var(--crl-display);font-size:1.6rem;letter-spacing:.04em;color:var(--crl-white);line-height:1;margin:0}
      .s-sub{font-family:var(--crl-mono);font-size:.8rem;letter-spacing:.08em;color:var(--crl-accent);margin:0}
      .s-bio{font-size:.83rem;color:var(--crl-muted);line-height:1.55;margin:2px 0 0;flex:1}
      .s-stream-title{font-family:var(--crl-mono);font-size:.72rem;color:var(--crl-accent);margin:2px 0 0}
      .s-last-live{
        display:flex;align-items:center;gap:5px;
        font-family:var(--crl-mono);font-size:.72rem;color:var(--crl-muted);
        margin:2px 0 0;
      }
      .s-last-live i{opacity:.55;font-size:.65rem}

      .s-card-footer{padding:0 20px 18px;display:flex;align-items:center;justify-content:space-between;gap:10px}
      .s-socials{display:flex;gap:7px}
      .s-social-btn{
        width:30px;height:30px;border-radius:7px;
        border:1px solid var(--crl-border);background:transparent;
        color:var(--crl-muted);font-size:.85rem;
        display:flex;align-items:center;justify-content:center;
        text-decoration:none;transition:color .2s,border-color .2s,background .2s;
      }
      .s-social-btn:hover{color:var(--crl-white);border-color:var(--crl-muted);background:rgba(255,255,255,.05)}
      .s-social-btn.twitch:hover{color:#9147ff;border-color:#9147ff}
      .s-social-btn.instagram:hover{color:#e1306c;border-color:#e1306c}
      .s-social-btn.tiktok:hover{color:#69c9d0;border-color:#69c9d0}

      .s-watch-btn{
        font-family:var(--crl-mono);font-size:.8rem;letter-spacing:.06em;
        padding:7px 14px;border-radius:8px;
        border:1px solid var(--crl-border);background:transparent;
        color:var(--crl-white);text-decoration:none;white-space:nowrap;
        transition:background .2s,border-color .2s;
      }
      .s-watch-btn:hover{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.2)}
      .is-live .s-watch-btn{background:#ef4444;border-color:#ef4444;color:#fff}
      .is-live .s-watch-btn:hover{background:#dc2626;border-color:#dc2626}

      /* Empty state */
      .s-empty{
        grid-column:1/-1;text-align:center;padding:48px 24px;
        font-family:var(--crl-mono);font-size:.85rem;letter-spacing:.1em;
        color:var(--crl-muted);text-transform:uppercase;
      }

      @media(max-width:600px){
        .hero{padding:40px 16px 24px}
        .search-row,.grid-wrap{padding-left:16px;padding-right:16px}
        .s-card-top{padding:14px 14px 0}
        .s-avatar,.s-avatar-fallback{width:48px;height:48px;font-size:1.4rem}
        .s-card-body{padding:10px 14px 12px}
        .s-name{font-size:1.3rem}
        .s-bio,.s-socials{display:none}
        .s-card-footer{padding:0 14px 12px}
      }
    </style>
  </fragment>

<main>
  <div class="hero">
    <div class="hero-label">CORILLO · PLATAFORMA INDEPENDIENTE</div>
    <h1 class="hero-title">STREAMERS</h1>
    <p class="hero-sub">Los creadores que hacen vibrar la plataforma desde Puerto Rico y más allá.</p>
    <div class="hero-stats" id="heroStats">
      <span><strong id="statTotal">0</strong> streamers</span>
      <span class="sep">·</span>
      <span><strong id="statLive" class="s-live-num">0</strong> en vivo</span>
      <span class="sep">·</span>
      <span><strong id="statViewers">0</strong> viewers</span>
    </div>
    <div class="live-pill" id="livePill">
      <span class="dot"></span>
      <span id="liveCount">0</span> EN VIVO
    </div>
  </div>

  <div class="search-row">
    <div class="search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input id="searchInput" type="search" placeholder="Buscar streamer..." autocomplete="off" spellcheck="false">
    </div>
  </div>

  <div class="grid-wrap">
    <div class="crl-grid crl-grid-auto" id="grid"></div>
  </div>
</main>

<script>
(function () {
  const POLL_MS = 15000;
  const PB_URL  = 'https://pb.corillo.live';

  const grid = document.getElementById('grid');

  let streamers  = [];
  let liveSet    = new Set();
  let viewersMap = {};
  let lastVods   = {};
  let searchQ    = '';
  let thumbTick  = Math.floor(Date.now() / 60000);

  /* ── Helpers ── */
  function relTime(dateStr) {
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 2)  return 'Hace un momento';
    if (mins < 60) return `Hace ${mins}m`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24)  return `Hace ${hrs}h`;
    const days = Math.floor(hrs / 24);
    if (days === 1) return 'Ayer';
    if (days < 7)  return `Hace ${days} días`;
    return `Hace ${Math.floor(days / 7)} sem`;
  }

  /* ── Card HTML ── */
  function cardHTML(s) {
    if (s.soon) return `
      <div class="s-card soon">
        <div class="s-card-accent" style="background:${s.color}"></div>
        <div class="s-card-top">
          <div class="s-avatar-fallback" style="background:${s.color}">?</div>
        </div>
        <div class="s-card-body">
          <p class="s-name">???</p>
          <p class="s-sub">${s.sub || 'Próximamente'}</p>
        </div>
      </div>`;

    const live    = liveSet.has(s.key);
    const viewers = viewersMap[s.key] || 0;
    const last    = lastVods[s.key];

    const avatar = s.avatar_url
      ? `<img class="s-avatar" src="${s.avatar_url}" alt="${s.name}" loading="lazy">`
      : `<div class="s-avatar-fallback" style="background:${s.color}">${s.ava}</div>`;

    const socials = [
      s.twitch    ? `<a href="https://twitch.tv/${s.twitch}" class="s-social-btn twitch" target="_blank" rel="noopener" onclick="event.stopPropagation()"><i class="fa-brands fa-twitch"></i></a>` : '',
      s.instagram ? `<a href="https://instagram.com/${s.instagram}" class="s-social-btn instagram" target="_blank" rel="noopener" onclick="event.stopPropagation()"><i class="fa-brands fa-instagram"></i></a>` : '',
      s.tiktok    ? `<a href="https://tiktok.com/@${s.tiktok}" class="s-social-btn tiktok" target="_blank" rel="noopener" onclick="event.stopPropagation()"><i class="fa-brands fa-tiktok"></i></a>` : '',
    ].join('');

    return `<div class="s-card${live ? ' is-live' : ''}" data-href="/${s.key}/" data-key="${s.key}" role="link" tabindex="0">
      ${live ? `<div class="s-card-hero">
        <img src="/assets/thumbs/${s.key}.jpg?t=${thumbTick}" onerror="this.style.display='none'" alt="">
        <div class="s-card-hero-overlay"></div>
      </div>` : ''}
      <div class="s-card-accent" style="background:${s.color}"></div>
      <div class="s-card-top">
        ${avatar}
        <div class="s-badges">
          <span class="s-live-badge"><span class="dot"></span>EN VIVO</span>
          <span class="s-viewers">${viewers} viewer${viewers !== 1 ? 's' : ''}</span>
        </div>
      </div>
      <div class="s-card-body">
        <h2 class="s-name">${s.name}</h2>
        ${s.sub ? `<p class="s-sub">${s.sub}</p>` : ''}
        ${live && s.stream_title ? `<p class="s-stream-title">▶ ${s.stream_title}</p>` : ''}
        ${s.bio ? `<p class="s-bio crl-clamp-3">${s.bio}</p>` : ''}
        ${!live && last ? `<p class="s-last-live"><i class="fa-regular fa-clock"></i> ${last}</p>` : ''}
      </div>
      <div class="s-card-footer">
        <div class="s-socials">${socials}</div>
        <span class="s-watch-btn">${live ? '▶ VER EN VIVO →' : 'VER CANAL →'}</span>
      </div>
    </div>`;
  }

  /* ── Render ── */
  function render() {
    let list = streamers.filter(s => {
      if (!searchQ) return true;
      return s.name.toLowerCase().includes(searchQ) || (s.key || '').toLowerCase().includes(searchQ);
    });

    // Live primero, luego alfabético
    list = [...list].sort((a, b) => {
      const al = liveSet.has(a.key) ? 1 : 0;
      const bl = liveSet.has(b.key) ? 1 : 0;
      if (bl !== al) return bl - al;
      return (a.name || '').localeCompare(b.name || '');
    });

    // Soon al final (solo cuando no hay búsqueda)
    const soonItems = searchQ ? [] : (window.STREAMERS || []).filter(s => s.soon);

    if (!list.length && !soonItems.length) {
      grid.innerHTML = `<div class="s-empty"><i class="fa-solid fa-satellite-dish" style="font-size:2rem;margin-bottom:12px;display:block;opacity:.3"></i>Sin resultados</div>`;
      return;
    }

    grid.innerHTML = [...list, ...soonItems].map(cardHTML).join('');

    grid.querySelectorAll('.s-card[data-href]').forEach(card => {
      card.addEventListener('click', e => {
        if (e.target.closest('a')) return;
        window.location.href = card.dataset.href;
      });
      card.addEventListener('keydown', e => {
        if ((e.key === 'Enter' || e.key === ' ') && !e.target.closest('a')) {
          e.preventDefault();
          window.location.href = card.dataset.href;
        }
      });
    });
  }

  /* ── Stats ── */
  function updateStats() {
    const liveCount    = [...liveSet].filter(k => streamers.some(s => s.key === k)).length;
    const totalViewers = Object.entries(viewersMap)
      .filter(([k]) => streamers.some(s => s.key === k))
      .reduce((a, [, v]) => a + v, 0);

    document.getElementById('statTotal').textContent   = streamers.filter(s => s.key).length;
    document.getElementById('statLive').textContent    = liveCount;
    document.getElementById('statViewers').textContent = totalViewers;
    document.getElementById('heroStats').classList.add('show');
    document.getElementById('liveCount').textContent   = String(liveCount);
    document.getElementById('livePill').classList.toggle('show', liveCount > 0);
  }

  /* ── Poll ── */
  async function poll() {
    try {
      const res   = await fetch('/mediamtx-api/v3/paths/list', { signal: AbortSignal.timeout(5000) });
      const items = (await res.json()).items || [];
      liveSet     = new Set(items.filter(p => p.ready).map(p => p.name.replace('live/', '')));
      viewersMap  = {};
      for (const p of items) {
        const m = p.name.match(/^live\/(.+)$/);
        if (m) viewersMap[m[1]] = p.readers?.length || 0;
      }
      thumbTick = Math.floor(Date.now() / 60000);
      updateStats();
      render();
    } catch {}
  }

  /* ── Last VODs ── */
  async function loadLastVods() {
    try {
      const r = await fetch(
        `${PB_URL}/api/collections/vods/records?sort=-date&perPage=100&fields=channel,date`,
        { signal: AbortSignal.timeout(5000) }
      );
      const items = (await r.json()).items || [];
      const seen  = new Set();
      for (const v of items) {
        if (!seen.has(v.channel)) {
          seen.add(v.channel);
          lastVods[v.channel] = relTime(v.date);
        }
      }
      render();
    } catch {}
  }

  /* ── Search ── */
  document.getElementById('searchInput').addEventListener('input', e => {
    searchQ = e.target.value.toLowerCase().trim();
    render();
  });

  /* ── Init ── */
  async function init() {
    try {
      const r = await fetch('/chat-api/streamers', { signal: AbortSignal.timeout(5000) });
      streamers = r.ok ? await r.json() : (window.STREAMERS || []).filter(s => s.key && !s.soon);
    } catch {
      streamers = (window.STREAMERS || []).filter(s => s.key && !s.soon);
    }

    render();
    await poll();
    loadLastVods();
    setInterval(poll, POLL_MS);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) poll(); });
  }

  init();
})();
</script>

</SiteShell>
