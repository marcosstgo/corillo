/* ── Barras negras del stream en la portada (pedido de Marcos, 31-oct-2026) ──
   Si el stream trae barras negras arriba y abajo (juego ultrawide dentro de un lienzo 16:9), en la portada se
   hace zoom justo lo necesario para que el video llene el espacio. Solo aquí: en el canal se ve completo.
   Cada 3 s se dibuja un cuadro en un lienzo de 64×36 y se miden las filas casi negras de arriba y de abajo.
   Se aplica solo si dos medidas seguidas coinciden, y nunca en escenas oscuras (menús, noche). */
const recorte = { timer: null, previo: null, lienzo: null };

function medirBarras(vid) {
  if (!vid.videoWidth || vid.paused) return null;
  const W = 64, H = 36;
  const c = recorte.lienzo || (recorte.lienzo = Object.assign(document.createElement('canvas'), { width: W, height: H }));
  const ctx = c.getContext('2d', { willReadFrequently: true });
  let px;
  try { ctx.drawImage(vid, 0, 0, W, H); px = ctx.getImageData(0, 0, W, H).data; } catch { return null; }  // video sin CORS
  const filas = [];
  let total = 0;
  for (let y = 0; y < H; y++) {
    let s = 0;
    for (let x = 0; x < W; x++) { const i = (y * W + x) * 4; s += px[i] * 0.299 + px[i + 1] * 0.587 + px[i + 2] * 0.114; }
    filas.push(s / W); total += s / W;
  }
  if (total / H < 20) return null;                      // escena oscura: no se puede saber
  const NEGRO = 14;
  let a = 0, b = H - 1;
  while (a < H / 3 && filas[a] < NEGRO) a++;
  while (b > (2 * H) / 3 && filas[b] < NEGRO) b--;
  return { arriba: a / H, abajo: (H - 1 - b) / H };
}

function aplicarRecorte(vid, m) {
  const sinBarras = !m || (m.arriba < 0.04 && m.abajo < 0.04);
  if (sinBarras) { vid.style.transform = ''; return; }
  const wrap = vid.parentElement;
  const W = wrap.clientWidth, H = wrap.clientHeight, vw = vid.videoWidth, vh = vid.videoHeight;
  const s0 = Math.max(W / vw, H / vh);                  // escala de object-fit: cover
  const alto = vh * (1 - m.arriba - m.abajo);           // alto del contenido sin barras, en píxeles del video
  const k = Math.min(1.8, Math.max(1, H / (alto * s0)));
  const centro = (m.arriba - m.abajo) / 2 * vh * s0;    // si las barras no son iguales, centrar el contenido
  vid.style.transform = `translateY(${(-centro * k).toFixed(1)}px) scale(${k.toFixed(3)})`;
}

function iniciarRecorte(vid) {
  clearInterval(recorte.timer);
  recorte.previo = null;
  vid.style.transition = 'transform .8s ease';
  vid.style.transform = '';
  recorte.timer = setInterval(() => {
    const m = medirBarras(vid);
    if (!m) return;
    const p = recorte.previo;
    if (p && Math.abs(p.arriba - m.arriba) < 0.03 && Math.abs(p.abajo - m.abajo) < 0.03) aplicarRecorte(vid, m);
    recorte.previo = m;
  }, 3000);
}

function setupHls(key) {
  const vid  = document.getElementById('featuredVideo');
  const wrap = document.getElementById('featuredVideoWrap');
  vid.crossOrigin = 'anonymous';   // para poder medir las barras negras (media.corillo.live manda CORS)
  iniciarRecorte(vid);

  vid.pause();
  vid.src = '';
  if (hlsInstance) { hlsInstance.destroy(); hlsInstance = null; }
  wrap.classList.remove('playing');

  const url = `https://media.corillo.live/live/${encodeURIComponent(key)}/index.m3u8`;

  if (vid.canPlayType('application/vnd.apple.mpegurl')) {
    vid.src = url;
    vid.play().catch(() => {});
    // Solo tapamos la miniatura cuando el video de verdad está reproduciendo
    vid.addEventListener('playing', () => { if (featuredKey === key) wrap.classList.add('playing'); }, { once: true });
    vid.addEventListener('error',   () => wrap.classList.remove('playing'), { once: true });
    return;
  }

  // Navegadores sin HLS nativo (Chrome/Firefox/Android): cargar hls.js bajo demanda
  ensureHls().then(() => {
    if (featuredKey !== key) return;          // cambió de canal mientras cargaba el script
    if (!window.Hls?.isSupported()) return;
    hlsInstance = new window.Hls({ lowLatencyMode: true, maxBufferLength: 8 });
    hlsInstance.loadSource(url);
    hlsInstance.attachMedia(vid);
    hlsInstance.on(window.Hls.Events.MANIFEST_PARSED, () => {
      vid.play().catch(() => {});
      wrap.classList.add('playing');
    });
    hlsInstance.on(window.Hls.Events.ERROR, (_, data) => {
      if (data.fatal) wrap.classList.remove('playing');
    });
  }).catch(() => {});
}

/* ── Rotation ────────────────────────────────────────── */
function fadeToFeatured(key) {
  const wrap = document.getElementById('featuredVideoWrap');
  wrap.style.transition = 'opacity .28s';
  wrap.style.opacity = '0.4';
  setTimeout(() => {
    setFeaturedLive(key, lastPaths);
    wrap.style.opacity = '1';
    setTimeout(() => { wrap.style.transition = ''; wrap.style.opacity = ''; }, 350);
  }, 280);
  startProgressBar();
}

function armRotateTimer() {
  clearInterval(rotateTimer);
  if (livePlayers.length < 2) return;
  rotateTimer = setInterval(() => {
    rotateIdx = (rotateIdx + 1) % livePlayers.length;
    fadeToFeatured(livePlayers[rotateIdx]);
  }, ROTATE_MS);
}

function jumpToFeatured(key) {
  const idx = livePlayers.indexOf(key);
  if (idx < 0 || key === featuredKey) return;
  rotateIdx = idx;
  fadeToFeatured(key);
  armRotateTimer();
}

function renderFeaturedDots(keys) {
  const wrap = document.getElementById('featuredDots');
  if (!wrap) return;
  if (keys.length < 2) { wrap.style.display = 'none'; wrap.innerHTML = ''; return; }
  wrap.style.display = '';
  wrap.innerHTML = keys.map(k => `<button class="dot" data-key="${k}" aria-label="Ver ${k}"></button>`).join('');
  wrap.querySelectorAll('.dot').forEach(btn => {
    btn.addEventListener('click', () => jumpToFeatured(btn.dataset.key));
  });
  updateFeaturedDots(featuredKey);
}

function updateFeaturedDots(key) {
  document.querySelectorAll('#featuredDots .dot').forEach(btn => {
    btn.classList.toggle('on', btn.dataset.key === key);
  });
}

function startRotation(live, paths) {
  clearInterval(rotateTimer);
  livePlayers = live.map(s => s.key);
  if (!livePlayers.length) return;

  renderFeaturedDots(livePlayers);

  // Set initial featured
  const preferredIdx = featuredKey ? livePlayers.indexOf(featuredKey) : -1;
  rotateIdx = preferredIdx >= 0 ? preferredIdx : 0;
  const firstKey = livePlayers[rotateIdx];
  if (firstKey !== featuredKey) setFeaturedLive(firstKey, paths);

  startProgressBar();
  armRotateTimer();
}

/* ── Live section ────────────────────────────────────── */
function renderLiveSection(live, paths) {
  const section = document.getElementById('liveSection');
  const rail    = document.getElementById('liveRail');
  const countEl = document.getElementById('liveCountEl');
  if (!section) return;

  if (!live.length) { section.style.display = 'none'; return; }

  section.style.display = '';
  if (countEl) countEl.textContent = live.length;

  // Rango por audiencia real — el streamer #1 ancla el rail
  const ranked = [...live].sort((a, b) => getViewers(paths, b.key) - getViewers(paths, a.key));

  const t = Math.floor(Date.now() / 60000);
  rail.innerHTML = ranked.map(s => {
    const viewers = getViewers(paths, s.key);
    return `<a class="h2-live" href="/${s.key}/">
      <div class="h2-live-thumb" style="background:${s.color || '#1e3a4a'}">
        <img src="https://media.corillo.live/assets/thumbs/${s.key}.jpg?t=${t}" alt="" onerror="this.style.display='none'">
        <span class="h2-chip live">En vivo</span>
        <span class="h2-chip viewers"><i class="fa-solid fa-eye"></i> ${viewers}</span>
      </div>
      <div class="h2-live-meta">
        <span class="h2-mini-face" style="background:${s.color || '#1e3a4a'}">${faceInner(s)}</span>
        <div><strong>${s.name}</strong><small>${s.stream_title || s.sub || 'corillo.live'}</small></div>
      </div>
    </a>`;
  }).join('');
}

function renderChannelGrid(paths) {
  const liveSet = getLiveSet(paths);
  const grid    = document.getElementById('channelGrid');

  let list = STREAMERS.filter(s => !s.soon);
  if (searchQuery) {
    list = list.filter(s =>
      s.name.toLowerCase().includes(searchQuery) ||
      s.key.toLowerCase().includes(searchQuery)
    );
  }
  // En vivo primero; el resto conserva el orden del roster
  list = [...list].sort((a, b) => (liveSet.has(b.key) ? 1 : 0) - (liveSet.has(a.key) ? 1 : 0));

  if (!list.length) {
    grid.innerHTML = `<p class="h2-empty">No hay canales que coincidan con “${searchQuery}”.</p>`;
    return;
  }

  const person = s => {
    const live    = liveSet.has(s.key);
    const viewers = live ? getViewers(paths, s.key) : 0;
    const face = s.avatar_url
      ? `<img src="${s.avatar_url}" alt="" loading="lazy" onerror="this.remove()">`
      : `<span class="h2-initial">${s.ava || s.name[0]}</span>`;
    return `<a class="h2-person${live ? ' is-live' : ''}" href="/${s.key}/">
      <span class="h2-person-img" style="background:${s.color || '#1e3a4a'}">${face}</span>
      ${live ? `<span class="h2-chip live">En vivo · ${viewers}</span>` : ''}
      <span class="h2-person-txt"><strong>${s.name}</strong><small>${live ? (s.stream_title || 'Transmitiendo ahora') : (s.sub || 'corillo.live')}</small></span>
    </a>`;
  };

  grid.innerHTML = list.map(person).join('');
}

async function poll() {
  const now    = Date.now();
  const paths  = await fetchPaths();
  lastPaths    = paths;
  const liveSet = getLiveSet(paths);
  const live    = STREAMERS.filter(s => liveSet.has(s.key));
  const offline = STREAMERS.filter(s => !liveSet.has(s.key));
  const total   = STREAMERS.length;

  // Attach viewer counts to live streamers for ticker
  const liveWithViewers = live.map(s => ({ ...s, _viewers: getViewers(paths, s.key) }));

  document.getElementById('liveCountEl').textContent = live.length;
  document.getElementById('totalCountEl').textContent = STREAMERS.filter(s => !s.soon).length;

  // Live section + channel grid
  renderLiveSection(live, paths);
  renderChannelGrid(paths);

  // Featured player
  if (live.length > 0) {
    if (featuredKey === undefined || featuredKey === null || !liveSet.has(featuredKey)) {
      clearInterval(rotateTimer);
      rotateTimer = null;
      startRotation(live, paths);
    } else {
      statsBase.viewers = getViewers(paths, featuredKey);
      const vEl = document.getElementById('featuredViewersMeta');
      if (vEl) vEl.textContent = statsBase.viewers;
    }
  } else {
    if (featuredKey !== null) {
      clearInterval(rotateTimer);
      rotateTimer = null;
      setFeaturedOffline();
    }
  }
}

/* ── Init ────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', async () => {
  const onScroll = () => document.body.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Search input vive en el SiteShell; aquí escuchamos el evento que dispara.
  window.addEventListener('crl-search', e => {
    searchQuery = (e.detail || '').toLowerCase();
    renderChannelGrid(lastPaths);
  });

  // Cargar roster completo desde PocketBase — fuente de verdad única
  try {
    const r = await fetch('https://api.corillo.live/api/streamers', { signal: AbortSignal.timeout(5000) });
    if (r.ok) {
      const fresh = await r.json();
      const soonEntries = (window.STREAMERS || []).filter(s => s.soon);
      STREAMERS.length = 0;
      for (const s of fresh) STREAMERS.push(s);
      for (const s of soonEntries) STREAMERS.push(s);
    }
  } catch {}

  await poll();

  setInterval(poll, POLL_MS);

  // Refresh live thumbnails every 60s without full re-render
  setInterval(() => {
    const t = Math.floor(Date.now() / 60000);
    document.querySelectorAll('.h2-live-thumb img').forEach(img => {
      img.src = img.src.replace(/\?t=\d+/, `?t=${t}`);
    });
  }, 60000);

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) { cache.t = 0; poll(); }
  });
});
</script>



