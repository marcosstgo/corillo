---
import SiteShell from '../layouts/SiteShell.astro';
---
<SiteShell
  title="CORILLO — Stream Platform"
  description="Plataforma de streaming independiente desde Puerto Rico. Sin algoritmos, sin baneos."
  canonical="https://corillo.live/"
  ogTitle="CORILLO — Stream Platform"
  ogDescription="Plataforma de streaming independiente desde Puerto Rico. Sin algoritmos, sin baneos arbitrarios. Solo tú, tu setup y tu audiencia."
  pageClass="page-home"
>
  <fragment slot="head">
    <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/home2.css?v=1">
    <script is:inline>document.documentElement.setAttribute('data-theme','dark');</script>
  </fragment>

<!-- ticker elements kept hidden for JS compat -->
<div id="tickerWrap" style="display:none" aria-hidden="true">
  <span id="tickerCount"></span>
  <div id="tickerContent"></div>
</div>

<h1 class="h2-sr">Corillo, plataforma de streaming independiente de Puerto Rico</h1>

<!-- HERO: a sangre, el nombre es el titular -->
<section class="h2-stage" aria-label="Destacado">
  <div class="featured">
    <div class="featured-video" id="featuredVideoWrap">
      <video id="featuredVideo" autoplay muted playsinline></video>
      <div class="sim-stream offline" id="simStream"></div>
      <div class="h2-scrim"></div>

      <div class="h2-hero">
        <div class="featured-top-left h2-status" id="featuredTopLeft">
          <span class="live-badge offline" id="liveBadge">Sin transmisión</span>
        </div>
        <div class="sim-title" id="simTitle">Corillo</div>
        <p class="sim-sub" id="simSub">Streaming independiente desde Puerto Rico</p>
        <div class="h2-who">
          <div class="featured-streamer">
            <div class="featured-ava" id="featuredAva" style="background:#1e3a4a">C</div>
            <div class="featured-text">
              <div class="featured-name" id="featuredNameEl">Corillo</div>
              <div class="featured-sub" id="featuredSubEl">Puerto Rico</div>
            </div>
          </div>
          <div class="featured-actions" id="featuredActions">
            <a href="/vods/" class="play-btn">Ver VODs</a>
            <a href="/join/" class="icon-btn" title="Crear canal"><i class="fa-solid fa-plus"></i></a>
          </div>
        </div>
      </div>

      <div class="rotate-bar" id="rotateBar"></div>
      <div class="featured-dots" id="featuredDots" style="display:none"></div>
    </div>
  </div>
</section>

<main class="h2-main" id="mainLayout">

  <!-- EN VIVO AHORA (solo aparece si hay alguien transmitiendo) -->
  <section class="h2-sec" id="liveSection" style="display:none">
    <div class="h2-sec-hd">
      <h2>En vivo ahora</h2>
      <span class="h2-count"><span id="liveCountEl">0</span> transmitiendo</span>
    </div>
    <div class="h2-live-rail" id="liveRail"><!-- rendered by JS --></div>
  </section>

  <!-- PONTE AL DÍA -->
  <section class="h2-sec" id="vodsSection">
    <div class="h2-sec-hd">
      <h2>Ponte al día</h2>
      <a href="/vods/" class="h2-more-link">Ver todos los VODs</a>
    </div>
    <div class="h2-vods" id="vodsCarousel">
      <span class="sk-label" role="status">Cargando transmisiones…</span>
      <div class="h2-vod is-lead" aria-hidden="true">
        <div class="sk sk-thumb" style="border-radius:24px"></div>
        <div class="h2-vod-body"><span class="sk sk-face" style="width:52px;height:52px"></span><div class="sk-stack"><span class="sk sk-line lg" style="width:70%"></span><span class="sk sk-line" style="width:32%"></span></div></div>
      </div>
      <div class="h2-vod-list" aria-hidden="true">
        <div class="h2-vod"><div class="sk sk-thumb" style="border-radius:12px"></div><div class="sk-stack"><span class="sk sk-line" style="width:88%"></span><span class="sk sk-line" style="width:45%"></span></div></div>
        <div class="h2-vod"><div class="sk sk-thumb" style="border-radius:12px"></div><div class="sk-stack"><span class="sk sk-line" style="width:88%"></span><span class="sk sk-line" style="width:45%"></span></div></div>
        <div class="h2-vod"><div class="sk sk-thumb" style="border-radius:12px"></div><div class="sk-stack"><span class="sk sk-line" style="width:88%"></span><span class="sk sk-line" style="width:45%"></span></div></div>
      </div>
    </div>
  </section>

  <!-- EL CORILLO -->
  <section class="h2-sec">
    <div class="h2-sec-hd">
      <h2>El corillo</h2>
      <span class="h2-count"><span id="totalCountEl">0</span> streamers</span>
      <a href="/streamers/" class="h2-more-link">Ver todos</a>
    </div>
    <div class="h2-people" id="channelGrid">
      <span class="sk-label" role="status">Cargando el corillo…</span>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
    </div>
  </section>

  <!-- REELS -->
  <section class="h2-sec" id="reelsStrip" style="display:none">
    <div class="h2-sec-hd">
      <h2>Reels</h2>
      <a href="/reels/" class="h2-more-link">Ver todos</a>
    </div>
    <div class="h2-reels" id="reelsTrack"></div>
  </section>

  <!-- INVITACIÓN -->
  <section class="h2-join">
    <h2>¿Tienes algo que transmitir?</h2>
    <p>Sin algoritmos y sin baneos arbitrarios. Solo tú, tu setup y tu audiencia.</p>
    <a href="/join/">Crear mi canal</a>
  </section>

</main>

<script>
const POLL_MS     = 15000;
const API_TIMEOUT = 5000;
const CACHE_MS    = 8000;
const ROTATE_MS   = 6000;
const VOD_TTL     = 120000;
const PB_URL      = 'https://pb.corillo.live';

const STREAMERS = (window.STREAMERS || []).filter(s => !s.soon);
const _hover    = window.matchMedia('(hover: hover)').matches;

let cache        = { t: 0, data: null };
let hlsInstance  = null;
let hlsLoadPromise = null;
// Carga hls.min.js (149KB gz) solo bajo demanda. Safari usa HLS nativo y nunca lo descarga.
function ensureHls() {
  if (window.Hls) return Promise.resolve();
  if (hlsLoadPromise) return hlsLoadPromise;
  hlsLoadPromise = new Promise((resolve, reject) => {
    const s = document.createElement('script');
    s.src = '/assets/hls.min.js';
    s.onload = () => resolve();
    s.onerror = reject;
    document.head.appendChild(s);
  });
  return hlsLoadPromise;
}
let searchQuery  = '';
let featuredKey  = undefined; // undefined=unset, null=offline, string=live channel
let rotateTimer  = null;
let statsTimer   = null;
let rafId        = null;
let rotateStart  = null;
let livePlayers  = [];
let rotateIdx    = 0;
let lastPaths    = [];
let statsBase    = { bitrate: 5200, latency: 2.4, viewers: 0 };
let vodList      = [];
let vodRotateIdx = 0;
let vodRotateTimer = null;
let cardBitrates = {}; // key → stable bitrate for card display

let _recentVods     = [];
let _vodThumbMap = {};
let _vodLoadedAt    = 0;
let _gridState      = null;

/* ── Utils ────────────────────────────────────────────── */
function getLiveSet(paths) {
  const s = new Set();
  for (const p of paths) {
    if (!p.ready) continue;
    const m = p.name.match(/^live\/([^/]+)$/);
    if (m && !/(_(low|rtc))$/.test(m[1])) s.add(m[1]);
  }
  return s;
}

function getViewers(paths, key) {
  const p = paths.find(p => p.name === 'live/' + key);
  return p ? (p.readers?.length ?? 0) : 0;
}

function getReadyTime(paths, key) {
  const p = paths.find(p => p.name === 'live/' + key);
  return p?.readyTime ? new Date(p.readyTime).getTime() : null;
}

function jitter(base, variance) {
  return Math.round(base + (Math.random() - 0.5) * 2 * variance);
}

function fmtDuration(s) {
  if (!s) return '';
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  return h > 0
    ? `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`
    : `${m}:${String(sec).padStart(2,'0')}`;
}

function fmtUptime(ms) {
  const s = Math.floor(ms / 1000);
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
  return [h, m, ss].map(n => String(n).padStart(2,'0')).join(':');
}

function fmtKbps(b) {
  return b >= 1000 ? (b/1000).toFixed(1) + 'M' : b + 'K';
}

function relativeTime(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 2)  return 'Hace un momento';
  if (mins < 60) return `Hace ${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Hace ${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'Ayer';
  if (days < 7)  return `Hace ${days} días`;
  return `Hace ${Math.floor(days / 7)} sem`;
}

/* ── API ─────────────────────────────────────────────── */
async function fetchPaths() {
  const now = Date.now();
  if (cache.data && now - cache.t < CACHE_MS) return cache.data;
  const ctrl = new AbortController();
  const tid  = setTimeout(() => ctrl.abort(), API_TIMEOUT);
  try {
    const r = await fetch('/mediamtx-api/v3/paths/list', { signal: ctrl.signal });
    clearTimeout(tid);
    const j = await r.json();
    cache = { t: now, data: j.items || [] };
  } catch {
    clearTimeout(tid);
    if (!cache.data) cache.data = [];
  }
  return cache.data;
}

async function fetchRecentVods(limit) {
  try {
    const r = await fetch(
      `${PB_URL}/api/collections/vods/records?sort=-date&perPage=${limit}&fields=id,channel,filename,thumb,preview,duration,date`,
      { signal: AbortSignal.timeout(5000) }
    );
    return (await r.json()).items || [];
  } catch { return []; }
}

async function loadVodData() {
  // Fetch ligero de todos los VODs para el mapa de thumbnails (solo channel+thumb)
  const thumbFetch = fetch(
    `${PB_URL}/api/collections/vods/records?sort=-date&perPage=500&fields=channel,thumb`,
    { signal: AbortSignal.timeout(6000) }
  ).then(r => r.json()).then(j => j.items || []).catch(() => []);

  // Fetch con todos los campos para el carousel de recientes
  const [thumbItems, recentVods] = await Promise.all([thumbFetch, fetchRecentVods(50)]);

  // Mapa completo: un thumb por canal, usando el VOD más reciente de cada uno
  _vodThumbMap = {};
  for (const v of thumbItems) {
    if (v.thumb && !_vodThumbMap[v.channel]) _vodThumbMap[v.channel] = v.thumb;
  }

  // Carousel: deduplicado por canal, máx 6
  const seen = new Set();
  _recentVods = recentVods.filter(v => {
    if (seen.has(v.channel)) return false;
    seen.add(v.channel);
    return true;
  }).slice(0, 6);

  _vodLoadedAt = Date.now();
}

/* Rostro redondo: foto si hay, inicial sobre el color del canal si no */
function faceInner(s) {
  return s.avatar_url
    ? `<img src="${s.avatar_url}" alt="" loading="lazy" onerror="this.remove()">`
    : (s.ava || s.name[0]);
}
function streamerOf(channel) {
  return STREAMERS.find(x => x.key === channel) || {
    key: channel, name: channel.toUpperCase(),
    color: 'linear-gradient(135deg,#1a2a3a,#0a1c52)', ava: channel[0].toUpperCase()
  };
}

/* VODs: el más reciente va grande; el resto, en cola a la derecha */
function vodCard(vod, lead) {
  const s   = streamerOf(vod.channel);
  const dur = vod.duration ? fmtDuration(vod.duration) : '';
  const preview = _hover && vod.preview
    ? `<video class="h2-preview" src="${vod.preview}?v=2" muted playsinline preload="none" loop></video>` : '';
  return `<a href="/vods/v/?id=${vod.id}" class="h2-vod${lead ? ' is-lead' : ''}">
    <div class="h2-vod-thumb">
      ${vod.thumb
        ? `<img src="${vod.thumb}?v=2" alt="" loading="${lead ? 'eager' : 'lazy'}" onerror="this.style.display='none'">`
        : `<div class="h2-vod-initial" style="background:${s.color || '#1e3a4a'}">${s.ava || s.name[0]}</div>`}
      ${preview}
      ${dur ? `<span class="h2-dur">${dur}</span>` : ''}
    </div>
    <div class="h2-vod-body">
      <span class="h2-mini-face" style="background:${s.color || '#1e3a4a'}">${faceInner(s)}</span>
      <div><strong>${s.name}</strong><small>${relativeTime(vod.date)}</small></div>
    </div>
  </a>`;
}
function vodCards(vods) {
  const box = document.getElementById('vodsCarousel');
  const even = vods.length <= 3;                 // pocos VODs: cuadrícula pareja
  box.classList.toggle('is-even', even);
  box.style.setProperty('--n', vods.length);
  if (even) return vods.map(v => vodCard(v, false)).join('');
  const [lead, ...rest] = vods;                  // 4+: uno grande + cola
  return vodCard(lead, true) + `<div class="h2-vod-list">${rest.map(v => vodCard(v, false)).join('')}</div>`;
}

function attachPreviewListeners(container) {
  if (!_hover) return;
  container.querySelectorAll('.h2-preview').forEach(vid => {
    const card = vid.closest('.h2-vod');
    if (!card) return;
    card.addEventListener('mouseenter', () => vid.play().catch(() => { vid.style.display = 'none'; }));
    card.addEventListener('mouseleave', () => { vid.pause(); vid.currentTime = 0; });
  });
}

/* ── Chat label ──────────────────────────────────────── */
function updateChatLabel(key) {
  const el = document.querySelector('.chat-panel .panel-title');
  if (!el) return;
  el.innerHTML = `<i class="fa-solid fa-comments"></i> Chat · #${key || 'corillo'}`;
}

/* ── Ticker ──────────────────────────────────────────── */
function renderTicker(liveChannels) {
  const wrap    = document.getElementById('tickerWrap');
  const content = document.getElementById('tickerContent');
  const countEl = document.getElementById('tickerCount');
  if (!wrap) return;
  if (!liveChannels.length) {
    wrap.style.visibility = 'hidden';
    return;
  }
  wrap.style.visibility = '';
  countEl.textContent = liveChannels.length;
  const items = [...liveChannels, ...liveChannels].map(s => {
    const v = s._viewers || 0;
    return `<span class="ticker-item">
      <span class="chan">${s.name}</span>
      <span>${s.sub?.split('·')[0]?.trim() || 'En vivo'}</span>
      ${v > 0 ? `<span class="stat">${v} viewers</span>` : ''}
      <span class="ticker-sep">//</span>
    </span>`;
  }).join('');
  content.innerHTML = items;
}

/* ── Stats animation ─────────────────────────────────── */
function startStatsAnimation(viewers, paths) {
  let uptimeStart = Date.now();
  if (featuredKey) {
    const rt = getReadyTime(paths, featuredKey);
    if (rt) uptimeStart = rt;
  }

  stopStatsAnimation();

  function tick() {
    const uptime = Date.now() - uptimeStart;
    const uptEl = document.getElementById('featuredUptime');
    if (uptEl) uptEl.textContent = fmtUptime(uptime);
  }

  tick();
  statsTimer = setInterval(tick, 1000);
}

function stopStatsAnimation() {
  clearInterval(statsTimer);
  statsTimer = null;
}

/* ── Progress bar ────────────────────────────────────── */
function startProgressBar() {
  cancelAnimationFrame(rafId);
  const bar = document.getElementById('rotateBar');
  if (!bar) return;
  bar.style.transition = 'none';
  bar.style.width = '0%';
  rotateStart = performance.now();
  function tick(now) {
    const pct = Math.min(100, ((now - rotateStart) / ROTATE_MS) * 100);
    bar.style.width = pct + '%';
    if (pct < 100) rafId = requestAnimationFrame(tick);
  }
  rafId = requestAnimationFrame(tick);
}

/* ── Featured player ─────────────────────────────────── */
function setFeaturedLive(key, paths) {
  const s = STREAMERS.find(x => x.key === key) || { key, name: key.toUpperCase(), color: '#1e3a4a', ava: key[0].toUpperCase(), sub: 'corillo.live' };
  const viewers = getViewers(paths, key);

  featuredKey = key;
  statsBase.viewers = viewers;

  updateChatLabel(key);
  updateFeaturedDots(key);

  // Sim stream
  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream';
  // miniatura en vivo mientras el video carga (evita el hueco negro)
  sim.style.backgroundImage = `url('/assets/thumbs/${key}.jpg?t=${Math.floor(Date.now() / 60000)}')`;
  document.getElementById('simTitle').textContent = s.name.split('_')[0];
  document.getElementById('simSub').textContent = s.stream_title || '';

  // Top overlay
  document.getElementById('featuredTopLeft').innerHTML = `
    <span class="live-badge" id="liveBadge">En vivo</span>
    <span class="featured-meta"><i class="fa-solid fa-eye"></i> <span id="featuredViewersMeta">${viewers}</span></span>
    <span class="featured-meta"><i class="fa-regular fa-clock"></i> <span id="featuredUptime">00:00:00</span></span>
  `;

  // Bottom overlay
  const ava = document.getElementById('featuredAva');
  ava.style.background = s.color || '#1e3a4a';
  ava.innerHTML = s.avatar_url
    ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">`
    : (s.ava || s.name[0]);

  document.getElementById('featuredNameEl').textContent = s.name;
  const subEl = document.getElementById('featuredSubEl');
  subEl.innerHTML = (s.host ? '<span class="host-tag">HOST</span>' : '') + (s.sub || 'corillo.live · Puerto Rico');

  document.getElementById('featuredActions').innerHTML = `
    <a href="/${key}/" class="play-btn">Ver en vivo</a>
    ${s.twitch ? `<a href="https://twitch.tv/${s.twitch}" target="_blank" rel="noopener" class="icon-btn" title="Twitch"><i class="fab fa-twitch"></i></a>` : ''}
    <button class="icon-btn" title="Fullscreen" id="featFsBtn"><i class="fa-solid fa-expand"></i></button>
  `;

  document.getElementById('featFsBtn')?.addEventListener('click', () => {
    const vid = document.getElementById('featuredVideo');
    if (vid?.requestFullscreen) vid.requestFullscreen().catch(() => {});
  });

  // HLS setup
  setupHls(key);

  // Stats
  startStatsAnimation(viewers, paths);
}

async function setFeaturedOffline() {
  featuredKey = null;
  renderFeaturedDots([]);

  // Stop HLS
  const vid = document.getElementById('featuredVideo');
  vid.pause();
  vid.src = '';
  if (hlsInstance) { hlsInstance.destroy(); hlsInstance = null; }
  document.getElementById('featuredVideoWrap').classList.remove('playing');
  stopStatsAnimation();
  clearInterval(vodRotateTimer);
  vodRotateTimer = null;
  vodRotateIdx   = 0;

  updateChatLabel(null);

  // Load VODs if not cached yet
  if (!vodList.length) {
    const raw = await fetchRecentVods(20);
    const seen = new Set();
    vodList = raw.filter(v => {
      if (seen.has(v.channel)) return false;
      seen.add(v.channel);
      return true;
    }).slice(0, 8);
  }

  if (!vodList.length) {
    showFeaturedOfflineStatic();
    return;
  }

  showFeaturedVod(vodList[0]);
  if (vodList.length > 1) {
    startProgressBar();
    vodRotateTimer = setInterval(() => {
      vodRotateIdx = (vodRotateIdx + 1) % vodList.length;
      showFeaturedVod(vodList[vodRotateIdx]);
      startProgressBar();
    }, ROTATE_MS);
  }
}

function showFeaturedVod(vod) {
  const s = STREAMERS.find(x => x.key === vod.channel) || {
    key: vod.channel, name: vod.channel.toUpperCase(),
    color: 'linear-gradient(135deg,#1a2a3a,#0a1c52)',
    ava: vod.channel[0].toUpperCase(), sub: 'corillo.live'
  };

  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream offline' + (vod.thumb ? ' has-thumb' : '');
  sim.style.backgroundImage = vod.thumb ? `url('${vod.thumb}?v=2')` : '';
  sim.style.animation = 'none'; void sim.offsetWidth; sim.style.animation = '';   // reinicia el zoom lento con cada VOD
  document.getElementById('simTitle').textContent = s.name.split('_')[0];
  document.getElementById('simSub').textContent = `Última transmisión · ${relativeTime(vod.date).toLowerCase()}`;

  document.getElementById('featuredTopLeft').innerHTML = `
    <span class="live-badge offline">Sin transmisión</span>
    ${vod.date ? `<span class="featured-meta"><i class="fa-regular fa-clock"></i> ${relativeTime(vod.date)}</span>` : ''}
    ${vod.duration ? `<span class="featured-meta"><i class="fa-solid fa-film"></i> ${fmtDuration(vod.duration)}</span>` : ''}
  `;

  const featAva = document.getElementById('featuredAva');
  featAva.style.background = s.color || '#1e3a4a';
  featAva.innerHTML = s.avatar_url
    ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">`
    : (s.ava || s.name[0]);
  document.getElementById('featuredNameEl').textContent = s.name;
  document.getElementById('featuredSubEl').innerHTML =
    (s.host ? '<span class="host-tag">HOST</span>' : '') + (s.sub || 'corillo.live · Puerto Rico');

  document.getElementById('featuredActions').innerHTML = `
    <a href="/vods/v/?id=${vod.id}" class="play-btn">Ver VOD</a>
    <a href="/${vod.channel}/" class="icon-btn" title="Ir al canal"><i class="fa-solid fa-tower-broadcast"></i></a>
  `;
}

function showFeaturedOfflineStatic() {
  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream offline';
  sim.style.backgroundImage = '';
  document.getElementById('simTitle').textContent = 'Sin transmisión';
  document.getElementById('simSub').textContent = 'Todos los canales están fuera de línea';
  document.getElementById('featuredTopLeft').innerHTML =
    '<span class="live-badge offline">Sin transmisión</span>';
  document.getElementById('featuredAva').style.background = '#1e3a4a';
  document.getElementById('featuredAva').textContent = 'C';
  document.getElementById('featuredNameEl').textContent = 'Corillo';
  document.getElementById('featuredSubEl').textContent = 'Puerto Rico · Sin stream activo';
  document.getElementById('featuredActions').innerHTML = `
    <a href="/vods/" class="play-btn">Ver VODs</a>
    <a href="/join/" class="icon-btn" title="Crear canal"><i class="fa-solid fa-plus"></i></a>
  `;
}

function setupHls(key) {
  const vid  = document.getElementById('featuredVideo');
  const wrap = document.getElementById('featuredVideoWrap');

  vid.pause();
  vid.src = '';
  if (hlsInstance) { hlsInstance.destroy(); hlsInstance = null; }
  wrap.classList.remove('playing');

  const url = `/live/${encodeURIComponent(key)}/index.m3u8`;

  if (vid.canPlayType('application/vnd.apple.mpegurl')) {
    vid.src = url;
    vid.play().catch(() => {});
    // Solo tapamos la miniatura cuando el video de verdad está reproduciendo
    vid.addEventListener('playing', () => { if (featuredKey === key) wrap.classList.add('playing'); }, { once: true });
    vid.addEventListener('error',   () => wrap.classList.remove('playing'), { once: true });
    return;
  }

  // Navegadores sin HLS nativo (Chrome/Firefox/Android): cargar hls.js bajo demanda
  ensureHls().then(() => {
    if (featuredKey !== key) return;          // cambió de canal mientras cargaba el script
    if (!window.Hls?.isSupported()) return;
    hlsInstance = new window.Hls({ lowLatencyMode: true, maxBufferLength: 8 });
    hlsInstance.loadSource(url);
    hlsInstance.attachMedia(vid);
    hlsInstance.on(window.Hls.Events.MANIFEST_PARSED, () => {
      vid.play().catch(() => {});
      wrap.classList.add('playing');
    });
    hlsInstance.on(window.Hls.Events.ERROR, (_, data) => {
      if (data.fatal) wrap.classList.remove('playing');
    });
  }).catch(() => {});
}

/* ── Rotation ────────────────────────────────────────── */
function fadeToFeatured(key) {
  const wrap = document.getElementById('featuredVideoWrap');
  wrap.style.transition = 'opacity .28s';
  wrap.style.opacity = '0.4';
  setTimeout(() => {
    setFeaturedLive(key, lastPaths);
    wrap.style.opacity = '1';
    setTimeout(() => { wrap.style.transition = ''; wrap.style.opacity = ''; }, 350);
  }, 280);
  startProgressBar();
}

function armRotateTimer() {
  clearInterval(rotateTimer);
  if (livePlayers.length < 2) return;
  rotateTimer = setInterval(() => {
    rotateIdx = (rotateIdx + 1) % livePlayers.length;
    fadeToFeatured(livePlayers[rotateIdx]);
  }, ROTATE_MS);
}

function jumpToFeatured(key) {
  const idx = livePlayers.indexOf(key);
  if (idx < 0 || key === featuredKey) return;
  rotateIdx = idx;
  fadeToFeatured(key);
  armRotateTimer();
}

function renderFeaturedDots(keys) {
  const wrap = document.getElementById('featuredDots');
  if (!wrap) return;
  if (keys.length < 2) { wrap.style.display = 'none'; wrap.innerHTML = ''; return; }
  wrap.style.display = '';
  wrap.innerHTML = keys.map(k => `<button class="dot" data-key="${k}" aria-label="Ver ${k}"></button>`).join('');
  wrap.querySelectorAll('.dot').forEach(btn => {
    btn.addEventListener('click', () => jumpToFeatured(btn.dataset.key));
  });
  updateFeaturedDots(featuredKey);
}

function updateFeaturedDots(key) {
  document.querySelectorAll('#featuredDots .dot').forEach(btn => {
    btn.classList.toggle('on', btn.dataset.key === key);
  });
}

function startRotation(live, paths) {
  clearInterval(rotateTimer);
  livePlayers = live.map(s => s.key);
  if (!livePlayers.length) return;

  renderFeaturedDots(livePlayers);

  // Set initial featured
  const preferredIdx = featuredKey ? livePlayers.indexOf(featuredKey) : -1;
  rotateIdx = preferredIdx >= 0 ? preferredIdx : 0;
  const firstKey = livePlayers[rotateIdx];
  if (firstKey !== featuredKey) setFeaturedLive(firstKey, paths);

  startProgressBar();
  armRotateTimer();
}

/* ── Live section ────────────────────────────────────── */
function renderLiveSection(live, paths) {
  const section = document.getElementById('liveSection');
  const rail    = document.getElementById('liveRail');
  const countEl = document.getElementById('liveCountEl');
  if (!section) return;

  if (!live.length) { section.style.display = 'none'; return; }

  section.style.display = '';
  if (countEl) countEl.textContent = live.length;

  // Rango por audiencia real — el streamer #1 ancla el rail
  const ranked = [...live].sort((a, b) => getViewers(paths, b.key) - getViewers(paths, a.key));

  const t = Math.floor(Date.now() / 60000);
  rail.innerHTML = ranked.map(s => {
    const viewers = getViewers(paths, s.key);
    return `<a class="h2-live" href="/${s.key}/">
      <div class="h2-live-thumb" style="background:${s.color || '#1e3a4a'}">
        <img src="/assets/thumbs/${s.key}.jpg?t=${t}" alt="" onerror="this.style.display='none'">
        <span class="h2-chip live">En vivo</span>
        <span class="h2-chip viewers"><i class="fa-solid fa-eye"></i> ${viewers}</span>
      </div>
      <div class="h2-live-meta">
        <span class="h2-mini-face" style="background:${s.color || '#1e3a4a'}">${faceInner(s)}</span>
        <div><strong>${s.name}</strong><small>${s.stream_title || s.sub || 'corillo.live'}</small></div>
      </div>
    </a>`;
  }).join('');
}

function renderChannelGrid(paths) {
  const liveSet = getLiveSet(paths);
  const grid    = document.getElementById('channelGrid');

  let list = STREAMERS.filter(s => !s.soon);
  if (searchQuery) {
    list = list.filter(s =>
      s.name.toLowerCase().includes(searchQuery) ||
      s.key.toLowerCase().includes(searchQuery)
    );
  }
  // En vivo primero; el resto conserva el orden del roster
  list = [...list].sort((a, b) => (liveSet.has(b.key) ? 1 : 0) - (liveSet.has(a.key) ? 1 : 0));

  if (!list.length) {
    grid.innerHTML = `<p class="h2-empty">No hay canales que coincidan con “${searchQuery}”.</p>`;
    return;
  }

  const person = s => {
    const live    = liveSet.has(s.key);
    const viewers = live ? getViewers(paths, s.key) : 0;
    const face = s.avatar_url
      ? `<img src="${s.avatar_url}" alt="" loading="lazy" onerror="this.remove()">`
      : `<span class="h2-initial">${s.ava || s.name[0]}</span>`;
    return `<a class="h2-person${live ? ' is-live' : ''}" href="/${s.key}/">
      <span class="h2-person-img" style="background:${s.color || '#1e3a4a'}">${face}</span>
      ${live ? `<span class="h2-chip live">En vivo · ${viewers}</span>` : ''}
      <span class="h2-person-txt"><strong>${s.name}</strong><small>${live ? (s.stream_title || 'Transmitiendo ahora') : (s.sub || 'corillo.live')}</small></span>
    </a>`;
  };

  grid.innerHTML = list.map(person).join('');
}

function renderVodsRow() {
  const box = document.getElementById('vodsCarousel');
  if (!box) return;
  if (!_recentVods.length) {
    box.innerHTML = '<p class="h2-empty">Todavía no hay transmisiones grabadas.</p>';
    return;
  }
  box.innerHTML = vodCards(_recentVods);
  attachPreviewListeners(box);
}

async function poll() {
  const now    = Date.now();
  const needVods = now - _vodLoadedAt > VOD_TTL;
  const tasks  = [fetchPaths()];
  if (needVods) tasks.push(loadVodData());
  const [paths] = await Promise.all(tasks);
  if (needVods) renderVodsRow();
  lastPaths    = paths;
  const liveSet = getLiveSet(paths);
  const live    = STREAMERS.filter(s => liveSet.has(s.key));
  const offline = STREAMERS.filter(s => !liveSet.has(s.key));
  const total   = STREAMERS.length;

  // Attach viewer counts to live streamers for ticker
  const liveWithViewers = live.map(s => ({ ...s, _viewers: getViewers(paths, s.key) }));

  document.getElementById('liveCountEl').textContent = live.length;
  document.getElementById('totalCountEl').textContent = STREAMERS.filter(s => !s.soon).length;

  // Live section + channel grid
  renderLiveSection(live, paths);
  renderChannelGrid(paths);

  // Featured player
  if (live.length > 0) {
    if (featuredKey === undefined || featuredKey === null || !liveSet.has(featuredKey)) {
      clearInterval(rotateTimer);
      rotateTimer = null;
      startRotation(live, paths);
    } else {
      statsBase.viewers = getViewers(paths, featuredKey);
      const vEl = document.getElementById('featuredViewersMeta');
      if (vEl) vEl.textContent = statsBase.viewers;
    }
  } else {
    if (featuredKey !== null) {
      clearInterval(rotateTimer);
      rotateTimer = null;
      setFeaturedOffline();
    }
  }
}

/* ── Reels strip ─────────────────────────────────────── */
async function loadReelsStrip() {
  try {
    const res  = await fetch(`${PB_URL}/api/collections/reels/records?filter=${encodeURIComponent('public=true')}&sort=-date&perPage=6`);
    const data = await res.json();
    const items = data.items || [];
    if (!items.length) return;
    const strip = document.getElementById('reelsStrip');
    const track = document.getElementById('reelsTrack');
    items.forEach(r => {
      const dur = r.duration ? fmtDuration(r.duration) : '';
      const a = document.createElement('a');
      a.className = 'h2-reel';
      a.href = `/reels/?start=${r.id}`;
      if (r.thumb) a.style.backgroundImage = `url('${r.thumb}')`;
      a.innerHTML = `${dur ? `<em>${dur}</em>` : ''}<span>${streamerOf(r.channel).name}</span>`;
      track.appendChild(a);
    });
    strip.style.display = '';
  } catch {}
}

/* ── Init ────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', async () => {
  const onScroll = () => document.body.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Search input vive en el SiteShell; aquí escuchamos el evento que dispara.
  window.addEventListener('crl-search', e => {
    searchQuery = (e.detail || '').toLowerCase();
    renderChannelGrid(lastPaths);
  });

  // Cargar roster completo desde PocketBase — fuente de verdad única
  try {
    const r = await fetch('/api/streamers', { signal: AbortSignal.timeout(5000) });
    if (r.ok) {
      const fresh = await r.json();
      const soonEntries = (window.STREAMERS || []).filter(s => s.soon);
      STREAMERS.length = 0;
      for (const s of fresh) STREAMERS.push(s);
      for (const s of soonEntries) STREAMERS.push(s);
    }
  } catch {}

  await poll();

  loadReelsStrip();

  setInterval(poll, POLL_MS);

  // Refresh live thumbnails every 60s without full re-render
  setInterval(() => {
    const t = Math.floor(Date.now() / 60000);
    document.querySelectorAll('.h2-live-thumb img').forEach(img => {
      img.src = img.src.replace(/\?t=\d+/, `?t=${t}`);
    });
  }, 60000);

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) { cache.t = 0; poll(); }
  });
});
</script>


