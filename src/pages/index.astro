---
import SiteShell from '../layouts/SiteShell.astro';
import { loadOfertas, allFree, fmtDay } from '../data/ofertas';
const OF = loadOfertas();
const OFREE = allFree(OF);   // juegos gratis de Epic (los escribe scripts/update-deals.py); si no hay, la franja no se muestra

/* ── Vitrina del hero (idea de Marcos, 31-oct-2026) ──
   Cuando nadie está en vivo, el hero rota lo más reciente del Corillo: noticias, videos, juegos gratis y la mejor
   oferta de equipo, cada uno con su imagen. Si alguien sale en vivo, el stream la reemplaza (ver startVitrina/stopVitrina).
   El orden sale de src/data/vitrina.js; los videos los añade el navegador con esas mismas reglas. */
import { getCollection } from 'astro:content';
import { ordenarVitrina, cuando, vigente } from '../data/vitrina.js';
import { catOf } from '../data/news';
import PeliCard from '../components/cine/PeliCard.astro';
import { hechoEnPR, pegao, cartelera, proximos } from '../data/cine';
type Slide = { kind: 'nota' | 'gratis' | 'equipo'; kicker: string; title: string; sub: string; href: string; cta: string; img: string; img2?: string; meta?: string; fecha?: number; hasta?: string };
const NOTAS = (await getCollection('noticias')).filter(p => p.data.image).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const nota = (p: typeof NOTAS[number]): Slide => ({
  kind: 'nota', kicker: p.data.badgeLabel, title: p.data.heroTitle, sub: p.data.heroSub || p.data.summary || '',
  href: `/noticias/${p.id}/`, cta: 'Leer la nota', img: p.data.image!, meta: cuando(p.data.pubDate.valueOf()), fecha: p.data.pubDate.valueOf(),
});
const grande = (g: typeof OFREE[number]) => {      // la imagen de la tienda en alta resolución (con la normal de respaldo)
  const m = g.image?.match(/steam\/apps\/(\d+)\//);
  if (m) return { img: `https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/${m[1]}/library_hero.jpg`, img2: g.image! };
  if (g.image?.includes('epicgames.com')) return { img: g.image.replace(/h=\d+/, 'h=900').replace(/w=\d+/, 'w=1600'), img2: g.image };
  return { img: g.image! };
};
const gratis = (g: typeof OFREE[number]): Slide => ({
  kind: 'gratis', kicker: `Gratis en ${g.store === 'epic' ? 'Epic Games' : 'Steam'}`, title: g.title,
  sub: [g.original ? `Normalmente ${g.original}` : '', g.ends ? `gratis hasta el ${fmtDay(g.ends)}` : 'gratis por tiempo limitado'].filter(Boolean).join(' · '),
  href: '/ofertas/gratis/', cta: 'Reclámalo gratis', ...grande(g), meta: 'Juego gratis', hasta: g.ends,
});
const EQUIPO = [...OF.equipo].filter(x => x.image).sort((a, b) => (b.score || 0) - (a.score || 0));
const equipo = (x: typeof EQUIPO[number]): Slide => ({
  kind: 'equipo', kicker: `${x.catLabel} en oferta`, title: x.title.length > 72 ? x.title.slice(0, 70).replace(/\s+\S*$/, '') + '…' : x.title,
  sub: [`${x.price} en ${x.retailer}`, x.save ? `ahorras ${x.save}` : '', x.freeShip ? 'envío gratis' : ''].filter(Boolean).join(' · '),
  href: `/ofertas/o/${x.slug}/`, cta: 'Ver la oferta', img: x.image!, meta: 'Envía a Puerto Rico',
});
const GRATIS = OFREE.filter(g => g.image && vigente(g.ends)).slice(0, 2);
const VITRINA: Slide[] = ordenarVitrina([
  ...NOTAS.slice(0, 2).map(nota), ...GRATIS.slice(0, 1).map(gratis), ...EQUIPO.slice(0, 1).map(equipo), ...GRATIS.slice(1).map(gratis),
]);

/* ── Lo que hay debajo del slider (2-nov-2026): noticias, cine y ofertas. Todo sale en el HTML, con enlaces reales para Google. ── */
const NOTICIAS = NOTAS.slice(0, 4);

// Cine: lo boricua que viene o está en sala va primero (siempre al frente); luego los estrenos del próximo mes y lo más visto en sala.
const hoyISO = new Date().toISOString().slice(0, 10);
const [pelisPR, pelisTop, pelisEnCine, pelisVienen] = await Promise.all([hechoEnPR(), pegao(), cartelera(), proximos()]);
const enUnMes = (p: { estreno?: string }) => !!p.estreno && new Date(p.estreno).valueOf() - Date.now() < 30 * 864e5;
const enSala = new Set(pelisEnCine.map(p => p.slug));
const PELIS = [...new Map([
  ...pelisPR.filter(p => (p.estreno && p.estreno > hoyISO && enUnMes(p)) || enSala.has(p.slug)).sort((a, b) => (a.estreno || '').localeCompare(b.estreno || '')),
  ...pelisVienen.filter(enUnMes),
  ...pelisTop.filter(p => enSala.has(p.slug)),
].filter(p => p.afiche || p.fondo).map(p => [p.slug, p])).values()].slice(0, 10);

// Ofertas de la semana: lo gratis, una de equipo (la que no está ya en el slider) y los mejores descuentos de juegos bien reseñados.
type Oferta = { title: string; img: string; href: string; externo: boolean; precio: string; antes?: string | null; chip: string; lugar: string; hasta?: string; producto?: boolean };
const OFERTAS_MAX = 4;
const juegosOferta = [...OF.steam].filter(d => d.image && (d.rating ?? 0) >= 85 && (d.reviews ?? 0) >= 500).sort((a, b) => (b.pct ?? 0) - (a.pct ?? 0));
const equipoOferta = EQUIPO[1] || EQUIPO[0];
const OFERTAS_HOME: Oferta[] = [
  ...GRATIS.map((g): Oferta => ({ title: g.title, img: g.image!, href: '/ofertas/gratis/', externo: false, precio: 'Gratis', antes: g.original, chip: 'Gratis',
    lugar: g.ends ? `${g.store === 'epic' ? 'Epic Games' : 'Steam'} · hasta el ${fmtDay(g.ends)}` : (g.store === 'epic' ? 'Epic Games' : 'Steam'), hasta: g.ends })),
  ...(equipoOferta ? [{ title: equipoOferta.title, img: equipoOferta.image!, href: `/ofertas/o/${equipoOferta.slug}/`, externo: false, precio: equipoOferta.price,
    chip: 'Equipo', lugar: `${equipoOferta.retailer}${equipoOferta.save ? ` · ahorras ${equipoOferta.save}` : ''}`, producto: true }] : []),
  ...juegosOferta.slice(0, OFERTAS_MAX).map((d): Oferta => ({ title: d.title, img: d.image!, href: d.url, externo: true, precio: d.price!, antes: d.original, chip: `-${d.pct}%`,
    lugar: `Steam${d.rating ? ` · ${d.rating}% positivas` : ''}` })),
].slice(0, OFERTAS_MAX);
---
<SiteShell
  title="Corillo: plataforma de streaming de Puerto Rico"
  description="Transmisiones en vivo, videos, noticias, cine y ofertas, hecho en Puerto Rico. Sin algoritmos y sin baneos arbitrarios."
  canonical="https://corillo.live/"
  ogTitle="Corillo: plataforma de streaming de Puerto Rico"
  ogDescription="Transmisiones en vivo, videos, noticias, cine y ofertas, hecho en Puerto Rico."
  pageClass="page-home"
>
  <fragment slot="head">
    <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/home2.css?v=7">
    <link rel="stylesheet" href="/assets/cine.css?v=2">
    <script is:inline>document.documentElement.setAttribute('data-theme','dark');</script>
  </fragment>

<!-- ticker elements kept hidden for JS compat -->
<div id="tickerWrap" style="display:none" aria-hidden="true">
  <span id="tickerCount"></span>
  <div id="tickerContent"></div>
</div>

<h1 class="h2-sr">Corillo, plataforma de streaming independiente de Puerto Rico</h1>

<!-- HERO: a sangre, el nombre es el titular -->
<section class="h2-stage" aria-label="Destacado">
  <div class="featured">
    <div class={`featured-video${VITRINA.length ? ' is-vitrina' : ''}`} id="featuredVideoWrap">
      <video id="featuredVideo" autoplay muted playsinline></video>
      <div class="sim-stream offline" id="simStream"></div>
      {VITRINA.length > 0 && (
      <div class="h2-vitrina" id="vitrina" aria-roledescription="carrusel" aria-label="Lo nuevo en Corillo">
        {VITRINA.map((v, i) => (
          <article class={`h2-vt h2-vt--${v.kind}${i === 0 ? ' on' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'} aria-roledescription="slide" aria-label={`${i + 1} de ${VITRINA.length}`} data-fecha={v.fecha} data-hasta={v.hasta}>
            <div class="h2-vt-bg">
              <img src={v.img} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async"
                   data-img2={v.img2} onerror="if(this.dataset.img2&&this.src!==this.dataset.img2){this.src=this.dataset.img2}" />
            </div>
            {v.kind === 'equipo' && <div class="h2-vt-prod"><img src={v.img} alt={v.title} loading="lazy" decoding="async" /></div>}
            <div class="h2-vt-txt">
              <div class="h2-status"><span class="live-badge offline">{v.kicker}</span>{v.meta && <span class="featured-meta" data-cuando={v.fecha ? '' : undefined}>{v.meta}</span>}</div>
              <h2 class="h2-vt-title"><a href={v.href} tabindex={i === 0 ? 0 : -1}>{v.title}</a></h2>
              {v.sub && <p class="h2-vt-sub">{v.sub}</p>}
              <div class="featured-actions">
                <a href={v.href} class="play-btn" tabindex={i === 0 ? 0 : -1}>{v.cta}</a>
                <a href="/streamers/" class="icon-btn" title="Ver streamers" tabindex={i === 0 ? 0 : -1}><i class="fa-solid fa-tower-broadcast"></i></a>
              </div>
            </div>
          </article>
        ))}
        <div class="h2-vt-nav" role="tablist" aria-label="Cambiar destacado">
          {VITRINA.map((v, i) => <button type="button" class={`h2-vt-dot${i === 0 ? ' on' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${i + 1}: ${v.title}`}><span></span></button>)}
        </div>
      </div>
      )}
      <div class="h2-scrim"></div>

      <div class="h2-hero">
        <div class="featured-top-left h2-status" id="featuredTopLeft">
          <span class="live-badge offline" id="liveBadge">Sin transmisión</span>
        </div>
        <div class="sim-title" id="simTitle">Corillo</div>
        <p class="sim-sub" id="simSub">Streaming independiente desde Puerto Rico</p>
        <div class="h2-who">
          <div class="featured-streamer">
            <div class="featured-ava" id="featuredAva" style="background:#1e3a4a">C</div>
            <div class="featured-text">
              <div class="featured-name" id="featuredNameEl">Corillo</div>
              <div class="featured-sub" id="featuredSubEl">Puerto Rico</div>
            </div>
          </div>
          <div class="featured-actions" id="featuredActions">
            <a href="/streamers/" class="play-btn">Ver streamers</a>
            <a href="/join/" class="icon-btn" title="Crear canal"><i class="fa-solid fa-plus"></i></a>
          </div>
        </div>
      </div>

      <div class="rotate-bar" id="rotateBar"></div>
      <div class="featured-dots" id="featuredDots" style="display:none"></div>
    </div>
  </div>
</section>

<main class="h2-main" id="mainLayout">

  <!-- EN VIVO AHORA (solo aparece si hay alguien transmitiendo) -->
  <section class="h2-sec" id="liveSection" style="display:none">
    <div class="h2-sec-hd">
      <h2>En vivo ahora</h2>
      <span class="h2-count"><span id="liveCountEl">0</span> transmitiendo</span>
    </div>
    <div class="h2-live-rail" id="liveRail"><!-- rendered by JS --></div>
  </section>

  <!-- NOTICIAS -->
  {NOTICIAS.length > 0 && (
  <section class="h2-sec" aria-labelledby="secNoticias">
    <div class="h2-sec-hd">
      <h2 id="secNoticias">Noticias</h2>
      <a href="/noticias/" class="h2-more-link">Ver todas</a>
    </div>
    <div class="h2-nt">
      {NOTICIAS.map((p, i) => {
        const c = catOf(p.data);
        return (
          <a class={`h2-nt-card${i === 0 ? ' is-lead' : ''}`} href={`/noticias/${p.id}/`} style={`--tc:${c.color}`}>
            <span class="h2-nt-pic"><img src={p.data.image} alt="" width="1600" height="900" loading="lazy" decoding="async" /></span>
            <span class="h2-nt-txt">
              <small><b>{c.label}</b> · <time datetime={p.data.pubDate.toISOString()} data-rel={p.data.pubDate.valueOf()}>{cuando(p.data.pubDate.valueOf())}</time></small>
              <strong>{p.data.cardTitle || p.data.heroTitle}</strong>
              {i === 0 && <span class="h2-nt-sum">{p.data.summary}</span>}
            </span>
          </a>
        );
      })}
    </div>
  </section>
  )}

  <!-- CINE -->
  {PELIS.length > 0 && (
  <section class="h2-sec" aria-labelledby="secCine">
    <div class="h2-sec-hd">
      <h2 id="secCine">Cine</h2>
      <span class="h2-count">Estrenos y cartelera en Puerto Rico</span>
      <a href="/cine/" class="h2-more-link">Ver la cartelera</a>
    </div>
    <div class="cn-fila">
      {PELIS.map(p => <PeliCard p={p} />)}
    </div>
    <p class="h2-credito">Datos e imágenes de películas: <a href="/cine/">TMDB</a>.</p>
  </section>
  )}

  <!-- OFERTAS DE LA SEMANA -->
  {OFERTAS_HOME.length > 0 && (
  <section class="h2-sec" id="secOfertas" aria-labelledby="secOfertasT">
    <div class="h2-sec-hd">
      <h2 id="secOfertasT">Ofertas de esta semana</h2>
      <span class="h2-count">Juegos y equipo</span>
      <a href="/ofertas/" class="h2-more-link">Ver todas</a>
    </div>
    <div class="h2-of">
      {OFERTAS_HOME.map(o => (
        <a class={`h2-of-card${o.producto ? ' is-producto' : ''}`} href={o.href} data-hasta={o.hasta} {...(o.externo ? { target: '_blank', rel: 'nofollow noopener' } : {})}>
          <span class="h2-of-pic"><img src={o.img} alt={`Imagen de ${o.title}`} width="460" height="259" loading="lazy" decoding="async" /><span class={`h2-of-chip${o.precio === 'Gratis' ? ' is-gratis' : ''}`}>{o.chip}</span></span>
          <span class="h2-of-txt">
            <strong>{o.title}</strong>
            <span class="h2-of-precio"><b>{o.precio}</b>{o.antes && <s>{o.antes}</s>}</span>
            <small>{o.lugar}</small>
          </span>
        </a>
      ))}
    </div>
  </section>
  )}

  <!-- INVITACIÓN -->
  <section class="h2-join">
    <h2>¿Tienes algo que transmitir?</h2>
    <p>Sin algoritmos y sin baneos arbitrarios. Solo tú, tu setup y tu audiencia.</p>
    <a href="/join/">Crear mi canal</a>
  </section>

</main>

<script>
import { ordenarVitrina, conservarVisible, cuando, vigente } from '../data/vitrina.js';
const POLL_MS     = 15000;
const API_TIMEOUT = 5000;
const CACHE_MS    = 8000;
const ROTATE_MS   = 6000;
const PB_URL      = 'https://pb.corillo.live';

const STREAMERS = (window.STREAMERS || []).filter(s => !s.soon);
const _hover    = window.matchMedia('(hover: hover)').matches;

let cache        = { t: 0, data: null };
let hlsInstance  = null;
let hlsLoadPromise = null;
// Carga hls.min.js (149KB gz) solo bajo demanda. Safari usa HLS nativo y nunca lo descarga.
function ensureHls() {
  if (window.Hls) return Promise.resolve();
  if (hlsLoadPromise) return hlsLoadPromise;
  hlsLoadPromise = new Promise((resolve, reject) => {
    const s = document.createElement('script');
    s.src = '/assets/hls.min.js';
    s.onload = () => resolve();
    s.onerror = reject;
    document.head.appendChild(s);
  });
  return hlsLoadPromise;
}
let featuredKey  = undefined; // undefined=unset, null=offline, string=live channel
let rotateTimer  = null;
let statsTimer   = null;
let rafId        = null;
let rotateStart  = null;
let livePlayers  = [];
let rotateIdx    = 0;
let lastPaths    = [];
let statsBase    = { bitrate: 5200, latency: 2.4, viewers: 0 };
let vodList      = [];
let vodRotateIdx = 0;
let vodRotateTimer = null;
let cardBitrates = {}; // key → stable bitrate for card display

let _gridState      = null;

/* ── Utils ────────────────────────────────────────────── */
function getLiveSet(paths) {
  const s = new Set();
  for (const p of paths) {
    if (!p.ready) continue;
    const m = p.name.match(/^live\/([^/]+)$/);
    if (m && !/(_(low|rtc))$/.test(m[1])) s.add(m[1]);
  }
  return s;
}

function getViewers(paths, key) {
  return window.corilloEspectadores(paths, key);
}

function getReadyTime(paths, key) {
  const p = paths.find(p => p.name === 'live/' + key);
  return p?.readyTime ? new Date(p.readyTime).getTime() : null;
}

function jitter(base, variance) {
  return Math.round(base + (Math.random() - 0.5) * 2 * variance);
}

function fmtDuration(s) {
  if (!s) return '';
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  return h > 0
    ? `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`
    : `${m}:${String(sec).padStart(2,'0')}`;
}

function fmtUptime(ms) {
  const s = Math.floor(ms / 1000);
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
  return [h, m, ss].map(n => String(n).padStart(2,'0')).join(':');
}

function fmtKbps(b) {
  return b >= 1000 ? (b/1000).toFixed(1) + 'M' : b + 'K';
}

function relativeTime(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 2)  return 'Hace un momento';
  if (mins < 60) return `Hace ${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Hace ${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'Ayer';
  if (days < 7)  return `Hace ${days} días`;
  return `Hace ${Math.floor(days / 7)} sem`;
}

/* ── API ─────────────────────────────────────────────── */
async function fetchPaths() {
  const now = Date.now();
  if (cache.data && now - cache.t < CACHE_MS) return cache.data;
  const ctrl = new AbortController();
  const tid  = setTimeout(() => ctrl.abort(), API_TIMEOUT);
  try {
    const r = await fetch('https://media.corillo.live/mediamtx-api/v3/paths/list', { signal: ctrl.signal });
    clearTimeout(tid);
    const j = await r.json();
    cache = { t: now, data: j.items || [] };
  } catch {
    clearTimeout(tid);
    if (!cache.data) cache.data = [];
  }
  return cache.data;
}

async function fetchRecentVods(limit) {
  try {
    const r = await fetch(
      `${PB_URL}/api/collections/vods/records?sort=-date&perPage=${limit}&fields=id,channel,filename,thumb,preview,duration,date`,
      { signal: AbortSignal.timeout(5000) }
    );
    return (await r.json()).items || [];
  } catch { return []; }
}

/* Rostro redondo: foto si hay, inicial sobre el color del canal si no */
function faceInner(s) {
  return s.avatar_url
    ? `<img src="${s.avatar_url}" alt="" loading="lazy" onerror="this.remove()">`
    : (s.ava || s.name[0]);
}
function streamerOf(channel) {
  return STREAMERS.find(x => x.key === channel) || {
    key: channel, name: channel.toUpperCase(),
    color: 'linear-gradient(135deg,#1a2a3a,#0a1c52)', ava: channel[0].toUpperCase()
  };
}

/* ── Chat label ──────────────────────────────────────── */
function updateChatLabel(key) {
  const el = document.querySelector('.chat-panel .panel-title');
  if (!el) return;
  el.innerHTML = `<i class="fa-solid fa-comments"></i> Chat · #${key || 'corillo'}`;
}

/* ── Ticker ──────────────────────────────────────────── */
function renderTicker(liveChannels) {
  const wrap    = document.getElementById('tickerWrap');
  const content = document.getElementById('tickerContent');
  const countEl = document.getElementById('tickerCount');
  if (!wrap) return;
  if (!liveChannels.length) {
    wrap.style.visibility = 'hidden';
    return;
  }
  wrap.style.visibility = '';
  countEl.textContent = liveChannels.length;
  const items = [...liveChannels, ...liveChannels].map(s => {
    const v = s._viewers || 0;
    return `<span class="ticker-item">
      <span class="chan">${s.name}</span>
      <span>${s.sub?.split('·')[0]?.trim() || 'En vivo'}</span>
      ${v > 0 ? `<span class="stat">${v} viewers</span>` : ''}
      <span class="ticker-sep">//</span>
    </span>`;
  }).join('');
  content.innerHTML = items;
}

/* ── Stats animation ─────────────────────────────────── */
function startStatsAnimation(viewers, paths) {
  let uptimeStart = Date.now();
  if (featuredKey) {
    const rt = getReadyTime(paths, featuredKey);
    if (rt) uptimeStart = rt;
  }

  stopStatsAnimation();

  function tick() {
    const uptime = Date.now() - uptimeStart;
    const uptEl = document.getElementById('featuredUptime');
    if (uptEl) uptEl.textContent = fmtUptime(uptime);
  }

  tick();
  statsTimer = setInterval(tick, 1000);
}

function stopStatsAnimation() {
  clearInterval(statsTimer);
  statsTimer = null;
}

/* ── Progress bar ────────────────────────────────────── */
function startProgressBar() {
  cancelAnimationFrame(rafId);
  const bar = document.getElementById('rotateBar');
  if (!bar) return;
  bar.style.transition = 'none';
  bar.style.width = '0%';
  rotateStart = performance.now();
  function tick(now) {
    const pct = Math.min(100, ((now - rotateStart) / ROTATE_MS) * 100);
    bar.style.width = pct + '%';
    if (pct < 100) rafId = requestAnimationFrame(tick);
  }
  rafId = requestAnimationFrame(tick);
}

/* ── Featured player ─────────────────────────────────── */
function setFeaturedLive(key, paths) {
  const s = STREAMERS.find(x => x.key === key) || { key, name: key.toUpperCase(), color: '#1e3a4a', ava: key[0].toUpperCase(), sub: 'corillo.live' };
  const viewers = getViewers(paths, key);

  featuredKey = key;
  statsBase.viewers = viewers;
  stopVitrina();

  updateChatLabel(key);
  updateFeaturedDots(key);

  // Sim stream
  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream';
  // miniatura en vivo mientras el video carga (evita el hueco negro)
  sim.style.backgroundImage = `url('https://media.corillo.live/assets/thumbs/${key}.jpg?t=${Math.floor(Date.now() / 60000)}')`;
  document.getElementById('simTitle').textContent = s.name.split('_')[0];
  document.getElementById('simSub').textContent = s.stream_title || '';

  // Top overlay
  document.getElementById('featuredTopLeft').innerHTML = `
