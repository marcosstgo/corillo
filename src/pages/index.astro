---
import SiteShell from '../layouts/SiteShell.astro';
import { loadOfertas, allFree, fmtDay } from '../data/ofertas';
const OF = loadOfertas();
const OFREE = allFree(OF);   // juegos gratis de Epic (los escribe scripts/update-deals.py); si no hay, la franja no se muestra

/* ── Vitrina del hero (idea de Marcos, 31-oct-2026) ──
   Cuando nadie está en vivo, el hero rota lo más reciente del Corillo: la noticia nueva, los juegos gratis y la mejor
   oferta de equipo, cada uno con su imagen. Si alguien sale en vivo, el stream la reemplaza (ver startVitrina/stopVitrina). */
import { getCollection } from 'astro:content';
type Slide = { kind: 'nota' | 'gratis' | 'equipo'; kicker: string; title: string; sub: string; href: string; cta: string; img: string; img2?: string; meta?: string };
const NOTAS = (await getCollection('noticias')).filter(p => p.data.image).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const hace = (d: Date) => {
  const dias = Math.floor((Date.now() - d.valueOf()) / 864e5);
  return dias <= 0 ? 'Hoy' : dias === 1 ? 'Ayer' : d.toLocaleDateString('es-PR', { day: 'numeric', month: 'long', timeZone: 'America/Puerto_Rico' });
};
const nota = (p: typeof NOTAS[number]): Slide => ({
  kind: 'nota', kicker: p.data.badgeLabel, title: p.data.heroTitle, sub: p.data.heroSub || p.data.summary || '',
  href: `/noticias/${p.id}/`, cta: 'Leer la nota', img: p.data.image!, meta: hace(p.data.pubDate),
});
const grande = (g: typeof OFREE[number]) => {      // la imagen de la tienda en alta resolución (con la normal de respaldo)
  const m = g.image?.match(/steam\/apps\/(\d+)\//);
  if (m) return { img: `https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/${m[1]}/library_hero.jpg`, img2: g.image! };
  if (g.image?.includes('epicgames.com')) return { img: g.image.replace(/h=\d+/, 'h=900').replace(/w=\d+/, 'w=1600'), img2: g.image };
  return { img: g.image! };
};
const gratis = (g: typeof OFREE[number]): Slide => ({
  kind: 'gratis', kicker: `Gratis en ${g.store === 'epic' ? 'Epic Games' : 'Steam'}`, title: g.title,
  sub: [g.original ? `Normalmente ${g.original}` : '', g.ends ? `gratis hasta el ${fmtDay(g.ends)}` : 'gratis por tiempo limitado'].filter(Boolean).join(' · '),
  href: '/ofertas/gratis/', cta: 'Reclámalo gratis', ...grande(g), meta: 'Juego gratis',
});
const EQUIPO = [...OF.equipo].filter(x => x.image).sort((a, b) => (b.score || 0) - (a.score || 0));
const equipo = (x: typeof EQUIPO[number]): Slide => ({
  kind: 'equipo', kicker: `${x.catLabel} en oferta`, title: x.title.length > 72 ? x.title.slice(0, 70).replace(/\s+\S*$/, '') + '…' : x.title,
  sub: [`${x.price} en ${x.retailer}`, x.save ? `ahorras ${x.save}` : '', x.freeShip ? 'envío gratis' : ''].filter(Boolean).join(' · '),
  href: `/ofertas/o/${x.slug}/`, cta: 'Ver la oferta', img: x.image!, meta: 'Envía a Puerto Rico',
});
const VITRINA: Slide[] = [
  NOTAS[0] && nota(NOTAS[0]), OFREE[0]?.image && gratis(OFREE[0]), EQUIPO[0] && equipo(EQUIPO[0]),
  OFREE[1]?.image && gratis(OFREE[1]), NOTAS[1] && nota(NOTAS[1]),
].filter(Boolean) as Slide[];
---
<SiteShell
  title="CORILLO — Stream Platform"
  description="Plataforma de streaming independiente desde Puerto Rico. Sin algoritmos, sin baneos."
  canonical="https://corillo.live/"
  ogTitle="CORILLO — Stream Platform"
  ogDescription="Plataforma de streaming independiente desde Puerto Rico. Sin algoritmos, sin baneos arbitrarios. Solo tú, tu setup y tu audiencia."
  pageClass="page-home"
>
  <fragment slot="head">
    <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/home2.css?v=6">
    <script is:inline>document.documentElement.setAttribute('data-theme','dark');</script>
  </fragment>

<!-- ticker elements kept hidden for JS compat -->
<div id="tickerWrap" style="display:none" aria-hidden="true">
  <span id="tickerCount"></span>
  <div id="tickerContent"></div>
</div>

<h1 class="h2-sr">Corillo, plataforma de streaming independiente de Puerto Rico</h1>

<!-- HERO: a sangre, el nombre es el titular -->
<section class="h2-stage" aria-label="Destacado">
  <div class="featured">
    <div class={`featured-video${VITRINA.length ? ' is-vitrina' : ''}`} id="featuredVideoWrap">
      <video id="featuredVideo" autoplay muted playsinline></video>
      <div class="sim-stream offline" id="simStream"></div>
      {VITRINA.length > 0 && (
      <div class="h2-vitrina" id="vitrina" aria-roledescription="carrusel" aria-label="Lo nuevo en Corillo">
        {VITRINA.map((v, i) => (
          <article class={`h2-vt h2-vt--${v.kind}${i === 0 ? ' on' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'} aria-roledescription="slide" aria-label={`${i + 1} de ${VITRINA.length}`}>
            <div class="h2-vt-bg">
              <img src={v.img} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding="async"
                   data-img2={v.img2} onerror="if(this.dataset.img2&&this.src!==this.dataset.img2){this.src=this.dataset.img2}" />
            </div>
            {v.kind === 'equipo' && <div class="h2-vt-prod"><img src={v.img} alt={v.title} loading="lazy" decoding="async" /></div>}
            <div class="h2-vt-txt">
              <div class="h2-status"><span class="live-badge offline">{v.kicker}</span>{v.meta && <span class="featured-meta">{v.meta}</span>}</div>
              <h2 class="h2-vt-title"><a href={v.href} tabindex={i === 0 ? 0 : -1}>{v.title}</a></h2>
              {v.sub && <p class="h2-vt-sub">{v.sub}</p>}
              <div class="featured-actions">
                <a href={v.href} class="play-btn" tabindex={i === 0 ? 0 : -1}>{v.cta}</a>
                <a href="/streamers/" class="icon-btn" title="Ver streamers" tabindex={i === 0 ? 0 : -1}><i class="fa-solid fa-tower-broadcast"></i></a>
              </div>
            </div>
          </article>
        ))}
        {VITRINA.length > 1 && (
        <div class="h2-vt-nav" role="tablist" aria-label="Cambiar destacado">
          {VITRINA.map((v, i) => <button type="button" class={`h2-vt-dot${i === 0 ? ' on' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${i + 1}: ${v.title}`}><span></span></button>)}
        </div>
        )}
      </div>
      )}
      <div class="h2-scrim"></div>

      <div class="h2-hero">
        <div class="featured-top-left h2-status" id="featuredTopLeft">
          <span class="live-badge offline" id="liveBadge">Sin transmisión</span>
        </div>
        <div class="sim-title" id="simTitle">Corillo</div>
        <p class="sim-sub" id="simSub">Streaming independiente desde Puerto Rico</p>
        <div class="h2-who">
          <div class="featured-streamer">
            <div class="featured-ava" id="featuredAva" style="background:#1e3a4a">C</div>
            <div class="featured-text">
              <div class="featured-name" id="featuredNameEl">Corillo</div>
              <div class="featured-sub" id="featuredSubEl">Puerto Rico</div>
            </div>
          </div>
          <div class="featured-actions" id="featuredActions">
            <a href="/streamers/" class="play-btn">Ver streamers</a>
            <a href="/join/" class="icon-btn" title="Crear canal"><i class="fa-solid fa-plus"></i></a>
          </div>
        </div>
      </div>

      <div class="rotate-bar" id="rotateBar"></div>
      <div class="featured-dots" id="featuredDots" style="display:none"></div>
    </div>
  </div>
</section>

<main class="h2-main" id="mainLayout">

  <!-- EN VIVO AHORA (solo aparece si hay alguien transmitiendo) -->
  <section class="h2-sec" id="liveSection" style="display:none">
    <div class="h2-sec-hd">
      <h2>En vivo ahora</h2>
      <span class="h2-count"><span id="liveCountEl">0</span> transmitiendo</span>
    </div>
    <div class="h2-live-rail" id="liveRail"><!-- rendered by JS --></div>
  </section>

  <!-- EL CORILLO -->
  <section class="h2-sec">
    <div class="h2-sec-hd">
      <h2>El corillo</h2>
      <span class="h2-count"><span id="totalCountEl">0</span> streamers</span>
      <a href="/streamers/" class="h2-more-link">Ver todos</a>
    </div>
    <div class="h2-people" id="channelGrid">
      <span class="sk-label" role="status">Cargando el corillo…</span>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
      <div class="sk sk-person"></div>
    </div>
  </section>

  <!-- GRATIS ESTA SEMANA (solo si hay datos reales) -->
  {OFREE.length > 0 && (
  <section class="h2-sec" id="gratisStrip" data-free-strip>
    <div class="h2-sec-hd">
      <h2>Gratis esta semana</h2>
      <span class="h2-count">en Epic y Steam</span>
      <a href="/ofertas/" class="h2-more-link">Ver todas las ofertas</a>
    </div>
    <div class="h2-fr">
      {OFREE.slice(0, 3).map((g) => (
        <a class="h2-fr-card" href="/ofertas/gratis/" data-end={g.ends ? new Date(g.ends).getTime() : ''}>
          {g.image && <img src={g.image} alt={`Portada de ${g.title}`} width="480" height="270" loading="lazy" />}
          <span class="h2-fr-body"><b>{g.title}</b><span>{g.ends ? `Gratis hasta el ${fmtDay(g.ends)}` : 'Gratis por tiempo limitado'}</span></span>
        </a>
      ))}
    </div>
  </section>
  )}


  <!-- INVITACIÓN -->
  <section class="h2-join">
    <h2>¿Tienes algo que transmitir?</h2>
    <p>Sin algoritmos y sin baneos arbitrarios. Solo tú, tu setup y tu audiencia.</p>
    <a href="/join/">Crear mi canal</a>
  </section>

</main>

<script>
const POLL_MS     = 15000;
const API_TIMEOUT = 5000;
const CACHE_MS    = 8000;
const ROTATE_MS   = 6000;
const PB_URL      = 'https://pb.corillo.live';

const STREAMERS = (window.STREAMERS || []).filter(s => !s.soon);
const _hover    = window.matchMedia('(hover: hover)').matches;

let cache        = { t: 0, data: null };
let hlsInstance  = null;
let hlsLoadPromise = null;
// Carga hls.min.js (149KB gz) solo bajo demanda. Safari usa HLS nativo y nunca lo descarga.
function ensureHls() {
  if (window.Hls) return Promise.resolve();
  if (hlsLoadPromise) return hlsLoadPromise;
  hlsLoadPromise = new Promise((resolve, reject) => {
    const s = document.createElement('script');
    s.src = '/assets/hls.min.js';
    s.onload = () => resolve();
    s.onerror = reject;
    document.head.appendChild(s);
  });
  return hlsLoadPromise;
}
let searchQuery  = '';
let featuredKey  = undefined; // undefined=unset, null=offline, string=live channel
let rotateTimer  = null;
let statsTimer   = null;
let rafId        = null;
let rotateStart  = null;
let livePlayers  = [];
let rotateIdx    = 0;
let lastPaths    = [];
let statsBase    = { bitrate: 5200, latency: 2.4, viewers: 0 };
let vodList      = [];
let vodRotateIdx = 0;
let vodRotateTimer = null;
let cardBitrates = {}; // key → stable bitrate for card display

let _gridState      = null;

/* ── Utils ────────────────────────────────────────────── */
function getLiveSet(paths) {
  const s = new Set();
  for (const p of paths) {
    if (!p.ready) continue;
    const m = p.name.match(/^live\/([^/]+)$/);
    if (m && !/(_(low|rtc))$/.test(m[1])) s.add(m[1]);
  }
  return s;
}

function getViewers(paths, key) {
  return window.corilloEspectadores(paths, key);
}

function getReadyTime(paths, key) {
  const p = paths.find(p => p.name === 'live/' + key);
  return p?.readyTime ? new Date(p.readyTime).getTime() : null;
}

function jitter(base, variance) {
  return Math.round(base + (Math.random() - 0.5) * 2 * variance);
}

function fmtDuration(s) {
  if (!s) return '';
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  return h > 0
    ? `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`
    : `${m}:${String(sec).padStart(2,'0')}`;
}

function fmtUptime(ms) {
  const s = Math.floor(ms / 1000);
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
  return [h, m, ss].map(n => String(n).padStart(2,'0')).join(':');
}

function fmtKbps(b) {
  return b >= 1000 ? (b/1000).toFixed(1) + 'M' : b + 'K';
}

function relativeTime(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 2)  return 'Hace un momento';
  if (mins < 60) return `Hace ${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Hace ${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'Ayer';
  if (days < 7)  return `Hace ${days} días`;
  return `Hace ${Math.floor(days / 7)} sem`;
}

/* ── API ─────────────────────────────────────────────── */
async function fetchPaths() {
  const now = Date.now();
  if (cache.data && now - cache.t < CACHE_MS) return cache.data;
  const ctrl = new AbortController();
  const tid  = setTimeout(() => ctrl.abort(), API_TIMEOUT);
  try {
    const r = await fetch('https://media.corillo.live/mediamtx-api/v3/paths/list', { signal: ctrl.signal });
    clearTimeout(tid);
    const j = await r.json();
    cache = { t: now, data: j.items || [] };
  } catch {
    clearTimeout(tid);
    if (!cache.data) cache.data = [];
  }
  return cache.data;
}

async function fetchRecentVods(limit) {
  try {
    const r = await fetch(
      `${PB_URL}/api/collections/vods/records?sort=-date&perPage=${limit}&fields=id,channel,filename,thumb,preview,duration,date`,
      { signal: AbortSignal.timeout(5000) }
    );
    return (await r.json()).items || [];
  } catch { return []; }
}

/* Rostro redondo: foto si hay, inicial sobre el color del canal si no */
function faceInner(s) {
  return s.avatar_url
    ? `<img src="${s.avatar_url}" alt="" loading="lazy" onerror="this.remove()">`
    : (s.ava || s.name[0]);
}
function streamerOf(channel) {
  return STREAMERS.find(x => x.key === channel) || {
    key: channel, name: channel.toUpperCase(),
    color: 'linear-gradient(135deg,#1a2a3a,#0a1c52)', ava: channel[0].toUpperCase()
  };
}

/* ── Chat label ──────────────────────────────────────── */
function updateChatLabel(key) {
  const el = document.querySelector('.chat-panel .panel-title');
  if (!el) return;
  el.innerHTML = `<i class="fa-solid fa-comments"></i> Chat · #${key || 'corillo'}`;
}

/* ── Ticker ──────────────────────────────────────────── */
function renderTicker(liveChannels) {
  const wrap    = document.getElementById('tickerWrap');
  const content = document.getElementById('tickerContent');
  const countEl = document.getElementById('tickerCount');
  if (!wrap) return;
  if (!liveChannels.length) {
    wrap.style.visibility = 'hidden';
    return;
  }
  wrap.style.visibility = '';
  countEl.textContent = liveChannels.length;
  const items = [...liveChannels, ...liveChannels].map(s => {
    const v = s._viewers || 0;
    return `<span class="ticker-item">
      <span class="chan">${s.name}</span>
      <span>${s.sub?.split('·')[0]?.trim() || 'En vivo'}</span>
      ${v > 0 ? `<span class="stat">${v} viewers</span>` : ''}
      <span class="ticker-sep">//</span>
    </span>`;
  }).join('');
  content.innerHTML = items;
}

/* ── Stats animation ─────────────────────────────────── */
function startStatsAnimation(viewers, paths) {
  let uptimeStart = Date.now();
  if (featuredKey) {
    const rt = getReadyTime(paths, featuredKey);
    if (rt) uptimeStart = rt;
  }

  stopStatsAnimation();

  function tick() {
    const uptime = Date.now() - uptimeStart;
    const uptEl = document.getElementById('featuredUptime');
    if (uptEl) uptEl.textContent = fmtUptime(uptime);
  }

  tick();
  statsTimer = setInterval(tick, 1000);
}

function stopStatsAnimation() {
  clearInterval(statsTimer);
  statsTimer = null;
}

/* ── Progress bar ────────────────────────────────────── */
function startProgressBar() {
  cancelAnimationFrame(rafId);
  const bar = document.getElementById('rotateBar');
  if (!bar) return;
  bar.style.transition = 'none';
  bar.style.width = '0%';
  rotateStart = performance.now();
  function tick(now) {
    const pct = Math.min(100, ((now - rotateStart) / ROTATE_MS) * 100);
    bar.style.width = pct + '%';
    if (pct < 100) rafId = requestAnimationFrame(tick);
  }
  rafId = requestAnimationFrame(tick);
}

/* ── Featured player ─────────────────────────────────── */
function setFeaturedLive(key, paths) {
  const s = STREAMERS.find(x => x.key === key) || { key, name: key.toUpperCase(), color: '#1e3a4a', ava: key[0].toUpperCase(), sub: 'corillo.live' };
  const viewers = getViewers(paths, key);

  featuredKey = key;
  statsBase.viewers = viewers;
  stopVitrina();

  updateChatLabel(key);
  updateFeaturedDots(key);

  // Sim stream
  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream';
  // miniatura en vivo mientras el video carga (evita el hueco negro)
  sim.style.backgroundImage = `url('https://media.corillo.live/assets/thumbs/${key}.jpg?t=${Math.floor(Date.now() / 60000)}')`;
  document.getElementById('simTitle').textContent = s.name.split('_')[0];
  document.getElementById('simSub').textContent = s.stream_title || '';

  // Top overlay
  document.getElementById('featuredTopLeft').innerHTML = `
    <span class="live-badge" id="liveBadge">En vivo</span>
    <span class="featured-meta"><i class="fa-solid fa-eye"></i> <span id="featuredViewersMeta">${viewers}</span></span>
    <span class="featured-meta"><i class="fa-regular fa-clock"></i> <span id="featuredUptime">00:00:00</span></span>
  `;

  // Bottom overlay
  const ava = document.getElementById('featuredAva');
  ava.style.background = s.color || '#1e3a4a';
  ava.innerHTML = s.avatar_url
    ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">`
    : (s.ava || s.name[0]);

  document.getElementById('featuredNameEl').textContent = s.name;
  const subEl = document.getElementById('featuredSubEl');
  subEl.innerHTML = (s.host ? '<span class="host-tag">HOST</span>' : '') + (s.sub || 'corillo.live · Puerto Rico');

  document.getElementById('featuredActions').innerHTML = `
    <a href="/${key}/" class="play-btn">Ver en vivo</a>
    ${s.twitch ? `<a href="https://twitch.tv/${s.twitch}" target="_blank" rel="noopener" class="icon-btn" title="Twitch"><i class="fab fa-twitch"></i></a>` : ''}
    <button class="icon-btn" title="Fullscreen" id="featFsBtn"><i class="fa-solid fa-expand"></i></button>
  `;

  document.getElementById('featFsBtn')?.addEventListener('click', () => {
    const vid = document.getElementById('featuredVideo');
    if (vid?.requestFullscreen) vid.requestFullscreen().catch(() => {});
  });

  // HLS setup
  setupHls(key);

  // Stats
  startStatsAnimation(viewers, paths);
}

/* ── Vitrina (hero sin nadie en vivo): rota noticia, gratis y equipo; se pausa con el mouse encima o con la pestaña oculta ── */
const VT_MS = 7000;
const vt = { idx: 0, timer: null, el: document.getElementById('vitrina') };
function vtShow(i) {
  if (!vt.el) return;
  const slides = vt.el.querySelectorAll('.h2-vt'), dots = vt.el.querySelectorAll('.h2-vt-dot');
  vt.idx = (i + slides.length) % slides.length;
  slides.forEach((sl, k) => {
    const on = k === vt.idx;
    sl.classList.toggle('on', on); sl.setAttribute('aria-hidden', on ? 'false' : 'true');
    sl.querySelectorAll('a').forEach(a => a.tabIndex = on ? 0 : -1);
    if (on) { const im = sl.querySelector('.h2-vt-bg img'); if (im) { im.loading = 'eager'; im.style.animation = 'none'; void im.offsetWidth; im.style.animation = ''; } }
  });
  dots.forEach((d, k) => { d.classList.toggle('on', k === vt.idx); d.setAttribute('aria-selected', k === vt.idx ? 'true' : 'false'); d.style.setProperty('--vt-ms', VT_MS + 'ms'); });
  // la siguiente ya cargando, para que no aparezca en blanco
  const next = slides[(vt.idx + 1) % slides.length]?.querySelector('img'); if (next) next.loading = 'eager';
}
function vtArm() {
  clearInterval(vt.timer);
  if (!vt.el || vt.el.querySelectorAll('.h2-vt').length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  vt.timer = setInterval(() => { if (!document.hidden && !vt.el.matches(':hover')) vtShow(vt.idx + 1); }, VT_MS);
}
function startVitrina() {
  if (!vt.el) return false;
  document.getElementById('featuredVideoWrap').classList.add('is-vitrina');
  vtShow(vt.idx); vtArm();
  return true;
}
function stopVitrina() {
  clearInterval(vt.timer); vt.timer = null;
  document.getElementById('featuredVideoWrap').classList.remove('is-vitrina');
}
if (vt.el) {
  vt.el.querySelectorAll('.h2-vt-dot').forEach((d, k) => { d.onclick = () => { vtShow(k); vtArm(); }; });
  let x0 = null;                                                     // deslizar con el dedo en el celular
  vt.el.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; }, { passive: true });
  vt.el.addEventListener('touchend', e => {
    if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; x0 = null;
    if (Math.abs(dx) > 50) { vtShow(vt.idx + (dx < 0 ? 1 : -1)); vtArm(); }
  });
  vtShow(0); vtArm();
  vtTransmisiones();
}

/* La última transmisión grabada (VOD de los últimos 14 días) entra de PRIMERA en la vitrina, con la mejor imagen del
   video (portada.py en corillo-media), el título, quién la hizo y cuánto dura. Hasta 2, de canales distintos. */
async function vtTransmisiones() {
  const desde = new Date(Date.now() - 14 * 864e5).toISOString().replace('T', ' ');
  let items = [];
  try {
    const r = await fetch(`${PB_URL}/api/collections/vods/records?sort=-date&perPage=10&filter=${encodeURIComponent(`date>="${desde}"`)}&fields=id,channel,title,thumb,duration,date`,
                          { signal: AbortSignal.timeout(5000) });
    items = (await r.json()).items || [];
  } catch { return; }
  const vistos = new Set();
  items = items.filter(v => v.thumb && !vistos.has(v.channel) && vistos.add(v.channel)).slice(0, 2);
  if (!items.length || !vt.el) return;
  let fotos = {};                                   // window.STREAMERS no trae la foto; la lista de corillo-api sí
  try { for (const x of await (await fetch('https://api.corillo.live/api/streamers', { signal: AbortSignal.timeout(4000) })).json()) fotos[x.key] = x; } catch {}
  const e = x => String(x ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const nav = vt.el.querySelector('.h2-vt-nav');
  for (const v of items.reverse()) {
    const s = { ...streamerOf(v.channel), ...(fotos[v.channel] || {}) }, nombre = s.name || v.channel;
    const cara = s.avatar_url ? `<img src="${e(s.avatar_url)}" alt="" onerror="this.remove()">` : e(s.ava || nombre[0]);
    const href = `/vods/v/?id=${encodeURIComponent(v.id)}`;
    const art = document.createElement('article');
    art.className = 'h2-vt h2-vt--vod';
    art.setAttribute('aria-roledescription', 'slide');
    art.innerHTML = `
      <div class="h2-vt-bg"><img src="${e(v.thumb)}" alt="" decoding="async"></div>
      <a class="h2-vt-play" href="${href}" tabindex="-1" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.6c0-1.2 1.3-1.9 2.3-1.3l11.3 7.4c.9.6.9 2 0 2.6L9.3 20.7C8.3 21.3 7 20.6 7 19.4V4.6Z"/></svg></a>
      <div class="h2-vt-txt">
        <div class="h2-status"><span class="live-badge offline">Transmisión</span>
          <span class="featured-meta">${e(relativeTime(v.date))}${v.duration ? ` · ${e(fmtDuration(v.duration))}` : ''}</span></div>
        <a class="h2-vt-who" href="/${e(v.channel)}/" tabindex="-1"><span class="h2-vt-face" style="background:${e(s.color || '#1e3a4a')}">${cara}</span><b>${e(nombre)}</b></a>
        <h2 class="h2-vt-title"><a href="${href}" tabindex="-1">${e(v.title || `Transmisión del ${new Date(v.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'long' })}`)}</a></h2>
        <p class="h2-vt-sub">Lo que te perdiste del stream de ${e(nombre)}. Velo completo cuando quieras.</p>
        <div class="featured-actions">
          <a href="${href}" class="play-btn" tabindex="-1"><i class="fa-solid fa-play"></i> Ver la transmisión</a>
          <a href="/${e(v.channel)}/" class="icon-btn" title="Canal de ${e(nombre)}" tabindex="-1"><i class="fa-solid fa-user"></i></a>
        </div>
      </div>`;
    vt.el.insertBefore(art, vt.el.querySelector('.h2-vt'));
    if (nav) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'h2-vt-dot'; b.setAttribute('role', 'tab');
      b.setAttribute('aria-label', `Transmisión de ${nombre}`); b.innerHTML = '<span></span>';
      nav.prepend(b);
    }
  }
  const slides = vt.el.querySelectorAll('.h2-vt');
  slides.forEach((sl, k) => sl.setAttribute('aria-label', `${k + 1} de ${slides.length}`));
  vt.el.querySelectorAll('.h2-vt-dot').forEach((d, k) => { d.onclick = () => { vtShow(k); vtArm(); }; });
  vtShow(0); vtArm();
}

async function setFeaturedOffline() {
  featuredKey = null;
  renderFeaturedDots([]);

  // Stop HLS
  const vid = document.getElementById('featuredVideo');
  vid.pause();
  vid.src = '';
  if (hlsInstance) { hlsInstance.destroy(); hlsInstance = null; }
  document.getElementById('featuredVideoWrap').classList.remove('playing');
  stopStatsAnimation();
  clearInterval(vodRotateTimer);
  vodRotateTimer = null;
  vodRotateIdx   = 0;

  updateChatLabel(null);

  // Sin nadie en vivo: la vitrina (noticias, gratis, equipo). Los VODs volverán a entrar aquí cuando existan otra vez.
  if (startVitrina()) return;

  // Load VODs if not cached yet
  if (!vodList.length) {
    const raw = await fetchRecentVods(20);
    const seen = new Set();
    vodList = raw.filter(v => {
      if (seen.has(v.channel)) return false;
      seen.add(v.channel);
      return true;
    }).slice(0, 8);
  }

  if (!vodList.length) {
    showFeaturedOfflineStatic();
    return;
  }

  showFeaturedVod(vodList[0]);
  if (vodList.length > 1) {
    startProgressBar();
    vodRotateTimer = setInterval(() => {
      vodRotateIdx = (vodRotateIdx + 1) % vodList.length;
      showFeaturedVod(vodList[vodRotateIdx]);
      startProgressBar();
    }, ROTATE_MS);
  }
}

