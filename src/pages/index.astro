/* ── Vitrina (hero sin nadie en vivo): se pausa con el mouse encima, con el teclado dentro o con la pestaña oculta.
   Las reglas de qué va primero están en src/data/vitrina.js. ── */
const VT_MS = 7000;
const vt = { idx: 0, timer: null, el: document.getElementById('vitrina') };
const vtSlides = () => [...vt.el.querySelectorAll('.h2-vt')];
const vtWrap = () => document.getElementById('featuredVideoWrap');
function vtSiguienteCargando() {                       // la siguiente ya cargando, para que no aparezca en blanco
  const slides = vtSlides(), next = slides[(vt.idx + 1) % slides.length]?.querySelector('img');
  if (next) next.loading = 'eager';
}
function vtShow(i) {
  if (!vt.el) return;
  const slides = vtSlides();
  vt.idx = (i + slides.length) % slides.length;
  slides.forEach((sl, k) => {
    const on = k === vt.idx;
    sl.classList.toggle('on', on); sl.setAttribute('aria-hidden', on ? 'false' : 'true');
    sl.querySelectorAll('a').forEach(a => a.tabIndex = on ? 0 : -1);
    if (on) {
      const im = sl.querySelector('.h2-vt-bg img'); if (im) { im.loading = 'eager'; im.style.animation = 'none'; void im.offsetWidth; im.style.animation = ''; }
      const m = sl.querySelector('[data-cuando]'); if (m && sl.dataset.fecha) m.textContent = cuando(+sl.dataset.fecha) + (m.dataset.cuando || '');   // el HTML puede tener horas o días; data-cuando trae lo que sigue a la fecha
    }
    const d = sl._dot; if (d) { d.classList.toggle('on', on); d.setAttribute('aria-selected', on ? 'true' : 'false'); d.style.setProperty('--vt-ms', VT_MS + 'ms'); }
  });
  vtSiguienteCargando();
}
/* Pone los slides en el orden de las reglas sin tocar el que está en pantalla (ni su imagen ni su barra se reinician). */
function vtAcomodar() {
  const slides = vtSlides(), visible = slides[vt.idx];
  const orden = ordenarVitrina(slides.filter(sl => sl === visible || vigente(sl.dataset.hasta)).map(el => ({ el, fecha: +el.dataset.fecha || 0 }))).map(x => x.el);
  const final = conservarVisible(orden, visible, vt.idx), pos = final.indexOf(visible);
  const nav = vt.el.querySelector('.h2-vt-nav');
  slides.filter(sl => !final.includes(sl)).forEach(sl => { sl._dot?.remove(); sl.remove(); });
  final.forEach((sl, k) => {
    sl.setAttribute('aria-label', `${k + 1} de ${final.length}`);
    if (k === pos) return;
    vt.el.insertBefore(sl, k < pos ? visible : nav);
    if (sl._dot) nav.insertBefore(sl._dot, k < pos ? visible._dot : null);
  });
  vt.idx = pos;
  if (nav) nav.style.display = final.length > 1 ? '' : 'none';
  vtSiguienteCargando();
}
function vtArm() {
  clearInterval(vt.timer); vt.timer = null;
  if (!vt.el || !vtWrap().classList.contains('is-vitrina') || vtSlides().length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  vt.timer = setInterval(() => {
    if (document.hidden || (_hover && vt.el.matches(':hover')) || vt.el.querySelector(':focus-visible')) return;
    vtAcomodar();                                      // saca lo que venció con la página abierta
    vtShow(vt.idx + 1);
  }, VT_MS);
}
function startVitrina() {
  if (!vt.el) return false;
  if (vtWrap().classList.contains('is-vitrina')) return true;   // ya está corriendo: no reiniciarla
  vtWrap().classList.add('is-vitrina');                          // alguien dejó de transmitir: empezar por lo más nuevo
  vtShow(0); vtArm();
  return true;
}
function stopVitrina() {
  clearInterval(vt.timer); vt.timer = null;
  vtWrap().classList.remove('is-vitrina');
}
if (vt.el) {
  const dots = vt.el.querySelectorAll('.h2-vt-dot');
  vtSlides().forEach((sl, k) => { sl._dot = dots[k]; if (dots[k]) dots[k]._slide = sl; });
  vt.el.querySelector('.h2-vt-nav')?.addEventListener('click', e => {
    const sl = e.target.closest('.h2-vt-dot')?._slide;
    if (sl) { vtShow(vtSlides().indexOf(sl)); vtArm(); }
  });
  let x0 = null;                                                     // deslizar con el dedo en el celular
  vt.el.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; }, { passive: true });
  vt.el.addEventListener('touchend', e => {
    if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; x0 = null;
    if (Math.abs(dx) > 50) { vtShow(vt.idx + (dx < 0 ? 1 : -1)); vtArm(); }
  });
  vtAcomodar(); vtShow(0); vtArm();
  vtVideos();
}

/* Los videos (transmisiones grabadas y subidas, últimos 14 días; hasta 2, de canales distintos) entran por su fecha, con la
   mejor imagen del video (portada.py en corillo-media), el título, quién lo hizo y cuánto dura. La colección vods todavía
   no dice si un video se subió o salió de una transmisión, así que el texto sirve para los dos. Si PocketBase no contesta,
   la vitrina sigue con lo que trajo el HTML. */
async function vtVideos() {
  const desde = new Date(Date.now() - 14 * 864e5).toISOString().replace('T', ' ');
  let items = [];
  try {
    const r = await fetch(`${PB_URL}/api/collections/vods/records?sort=-date&perPage=10&filter=${encodeURIComponent(`date>="${desde}"`)}&fields=id,channel,title,thumb,duration,date`,
                          { signal: AbortSignal.timeout(5000) });
    if (!r.ok) return;
    items = (await r.json()).items || [];
  } catch { return; }
  const vistos = new Set();
  items = items.filter(v => v.thumb && !vistos.has(v.channel) && vistos.add(v.channel)).slice(0, 2);
  if (!items.length || !vt.el) return;
  let fotos = {};                                   // window.STREAMERS no trae la foto; la lista de corillo-api sí
  try { for (const x of await (await fetch('https://api.corillo.live/api/streamers', { signal: AbortSignal.timeout(4000) })).json()) fotos[x.key] = x; } catch {}
  const e = x => String(x ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const nav = vt.el.querySelector('.h2-vt-nav');
  for (const v of items) {
    const fecha = new Date(String(v.date).replace(' ', 'T')).getTime();
    const s = { ...streamerOf(v.channel), ...(fotos[v.channel] || {}) }, nombre = s.name || v.channel;
    const cara = s.avatar_url ? `<img src="${e(s.avatar_url)}" alt="" onerror="this.remove()">` : e(s.ava || nombre[0]);
    const href = `/vods/v/?id=${encodeURIComponent(v.id)}`;
    const art = document.createElement('article');
    art.className = 'h2-vt h2-vt--vod';
    art.setAttribute('aria-roledescription', 'slide');
    art.setAttribute('aria-hidden', 'true');
    art.dataset.fecha = fecha || '';
    art.innerHTML = `
      <div class="h2-vt-bg"><img src="${e(v.thumb)}" alt="" decoding="async"></div>
      <a class="h2-vt-play" href="${href}" tabindex="-1" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.6c0-1.2 1.3-1.9 2.3-1.3l11.3 7.4c.9.6.9 2 0 2.6L9.3 20.7C8.3 21.3 7 20.6 7 19.4V4.6Z"/></svg></a>
      <div class="h2-vt-txt">
        <div class="h2-status"><span class="live-badge offline">Video</span>
          <span class="featured-meta" data-cuando="${v.duration ? ` · ${e(fmtDuration(v.duration))}` : ''}">${e(cuando(fecha))}${v.duration ? ` · ${e(fmtDuration(v.duration))}` : ''}</span></div>
        <a class="h2-vt-who" href="/${e(v.channel)}/" tabindex="-1"><span class="h2-vt-face" style="background:${e(s.color || '#1e3a4a')}">${cara}</span><b>${e(nombre)}</b></a>
        <h2 class="h2-vt-title"><a href="${href}" tabindex="-1">${e(v.title || `Video de ${nombre}`)}</a></h2>
        <p class="h2-vt-sub">Lo nuevo de ${e(nombre)} en Corillo. Velo completo cuando quieras.</p>
        <div class="featured-actions">
          <a href="${href}" class="play-btn" tabindex="-1"><i class="fa-solid fa-play"></i> Ver el video</a>
          <a href="/${e(v.channel)}/" class="icon-btn" title="Canal de ${e(nombre)}" tabindex="-1"><i class="fa-solid fa-user"></i></a>
        </div>
      </div>`;
    vt.el.insertBefore(art, nav);
    if (nav) {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'h2-vt-dot'; b.setAttribute('role', 'tab'); b.setAttribute('aria-selected', 'false');
      b.setAttribute('aria-label', `Video de ${nombre}`); b.innerHTML = '<span></span>';
      b.style.setProperty('--vt-ms', VT_MS + 'ms');
      nav.append(b);
      art._dot = b; b._slide = art;
    }
  }
  vtAcomodar();
  if (vtWrap().classList.contains('is-vitrina') && !vt.timer) vtArm();   // una vitrina de un solo slide ahora tiene más
}

