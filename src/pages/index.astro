---
import SiteShell from '../layouts/SiteShell.astro';
---
<SiteShell
  title="CORILLO — Stream Platform"
  description="Plataforma de streaming independiente desde Puerto Rico. Sin algoritmos, sin baneos."
  canonical="https://corillo.live/"
  ogTitle="CORILLO — Stream Platform"
  ogDescription="Plataforma de streaming independiente desde Puerto Rico. Sin algoritmos, sin baneos arbitrarios. Solo tú, tu setup y tu audiencia."
>
  <fragment slot="head">
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.18/dist/hls.min.js" is:inline></script>
    <style is:global>
      /* ── Home-only styles (channel cards, sim-stream, grid-empty, host-tag, rotate-bar) ── */
      .ch-badge-off {
        padding:2px 6px; background:rgba(0,0,0,.6); color:var(--muted);
        font-family:var(--mono); font-size:9px; font-weight:700;
        letter-spacing:1.5px; border-radius:2px;
      }
      .ch-thumb-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:1; }
      .ch-thumb-vod { opacity:.5; filter:saturate(.7); }
      .ch-thumb-glow  { z-index:0; }
      .ch-thumb-noise { z-index:2; }
      .ch-thumb-inner { z-index:0; }
      .ch:hover .ch-thumb-img { transform:scale(1.04); transition:transform .35s ease; }
      .ch-top, .ch-bottom { z-index:3; }

      .sim-stream.has-thumb { background-size:cover; background-position:center; }
      .sim-stream.has-thumb::before {
        content:''; position:absolute; inset:0; z-index:1;
        background:linear-gradient(to top, rgba(0,0,0,.75) 0%, rgba(0,0,0,.35) 55%, rgba(0,0,0,.55) 100%);
      }
      .sim-stream.has-thumb .sim-stream-grid { display:none; }
      .sim-stream.has-thumb > div { z-index:2; }

      .grid-empty {
        display:flex; flex-direction:column; align-items:center;
        padding:48px 24px; gap:14px; border:1px dashed var(--border); border-radius:8px;
        color:var(--muted); font-family:var(--mono); font-size:11px; letter-spacing:2px; text-transform:uppercase;
        grid-column: 1 / -1;
      }
      .grid-empty i { font-size:2rem; opacity:.4; }

      .featured-sub .host-tag { color:var(--live); border:1px solid rgba(232,200,74,.4); padding:1px 6px; border-radius:3px; font-family:var(--mono); font-size:10px; letter-spacing:1.5px; margin-right:6px; display:inline-block; vertical-align:middle; }

      .rotate-bar { position:absolute; bottom:0; left:0; height:2px; background:var(--accent); opacity:.5; width:0; z-index:4; }
    </style>
  </fragment>

<!-- ticker elements kept hidden for JS compat -->
<div id="tickerWrap" style="display:none" aria-hidden="true">
  <span id="tickerCount"></span>
  <div id="tickerContent"></div>
</div>

<!-- MAIN -->
<main class="main" id="mainLayout">

    <!-- FEATURED HERO -->
    <div class="featured">
      <div class="featured-video" id="featuredVideoWrap">
        <video id="featuredVideo" autoplay muted playsinline></video>

        <div class="sim-stream offline" id="simStream">
          <div class="sim-stream-grid"></div>
          <div style="position:relative;z-index:2;text-align:center">
            <div class="sim-title" id="simTitle">CORILLO</div>
            <div class="sim-sub" id="simSub">EN ESPERA DE SEÑAL</div>
          </div>
        </div>

        <!-- Top overlay -->
        <div class="featured-top">
          <div class="featured-top-left" id="featuredTopLeft">
            <span class="live-badge offline" id="liveBadge">Offline</span>
          </div>
        </div>

        <!-- Bottom overlay -->
        <div class="featured-bottom">
          <div class="featured-info">
            <div class="featured-streamer">
              <div class="featured-ava" id="featuredAva" style="background:#1e3a4a">C</div>
              <div class="featured-text">
                <div class="featured-name" id="featuredNameEl">CORILLO</div>
                <div class="featured-sub" id="featuredSubEl">Puerto Rico · Sin stream activo</div>
              </div>
            </div>
            <div class="featured-actions" id="featuredActions">
              <a href="/multiplayer/" class="play-btn"><i class="fa-solid fa-table-cells"></i> Multiplayer</a>
              <a href="/vods/" class="icon-btn" title="VODs"><i class="fa-solid fa-film"></i></a>
            </div>
          </div>
        </div>

        <div class="rotate-bar" id="rotateBar"></div>
      </div>

    </div>

  <!-- EN VIVO -->
  <section class="sec" id="liveSection" style="display:none">
    <div class="sec-hd">
      <span class="sec-name">EN VIVO</span>
      <span class="sec-count"><span id="liveCountEl">0</span> streamers</span>
      <div class="sec-rule"></div>
    </div>
    <div class="live-rail" id="liveRail"><!-- rendered by JS --></div>
  </section>

  <!-- VODs + DIGEST -->
  <div class="bottom-row">
    <div class="vods-col">
      <div class="sec-hd">
        <span class="sec-name" style="font-size:18px">ÚLTIMAS TRANSMISIONES</span>
        <div class="sec-rule"></div>
        <a href="/vods/" class="sec-more">Ver todos →</a>
      </div>
      <div class="cards-carousel" id="vodsCarousel">
        <div style="padding:16px 0;font-family:var(--mono);font-size:10px;color:var(--muted)">Cargando...</div>
      </div>
    </div>
    <aside class="digest-col">
      <div class="panel">
        <div class="panel-header">
          <div class="panel-title"><i class="fa-solid fa-robot"></i> Bot · Digest</div>
          <div class="panel-meta" id="digestAge">Claude</div>
        </div>
        <div class="digest">
          <div class="digest-label">Señal en tiempo real</div>
          <p id="digestText" style="font-size:13px;line-height:1.5">Verificando estado de streams...</p>
        </div>
      </div>
    </aside>
  </div>

  <!-- CANALES -->
  <section class="sec">
    <div class="sec-hd">
      <span class="sec-name">CANALES</span>
      <span class="sec-count"><span id="totalCountEl">0</span> streamers</span>
      <div class="sec-rule"></div>
      <a href="/streamers/" class="sec-more">Ver todos →</a>
    </div>
    <div class="channels" id="channelGrid"><!-- rendered by JS --></div>
  </section>

</main>

<!-- REELS STRIP -->
<div class="reels-strip" id="reelsStrip" style="display:none">
  <div class="reels-strip-hd">
    <span><i class="fa-solid fa-scissors" style="margin-right:6px"></i>Últimos reels</span>
    <div class="section-line"></div>
    <a href="/reels/">Ver todos <i class="fa-solid fa-arrow-right" style="font-size:9px"></i></a>
  </div>
  <div class="reels-strip-track" id="reelsTrack"></div>
</div>

<script>
const POLL_MS     = 15000;
const API_TIMEOUT = 5000;
const CACHE_MS    = 8000;
const ROTATE_MS   = 6000;
const VOD_TTL     = 120000;
const PB_URL      = 'https://pb.corillo.live';

const STREAMERS = (window.STREAMERS || []).filter(s => !s.soon);
const _hover    = window.matchMedia('(hover: hover)').matches;

let cache        = { t: 0, data: null };
let hlsInstance  = null;
let searchQuery  = '';
let featuredKey  = undefined; // undefined=unset, null=offline, string=live channel
let rotateTimer  = null;
let statsTimer   = null;
let rafId        = null;
let rotateStart  = null;
let livePlayers  = [];
let rotateIdx    = 0;
let lastPaths    = [];
let statsBase    = { bitrate: 5200, latency: 2.4, viewers: 0 };
let vodList      = [];
let vodRotateIdx = 0;
let vodRotateTimer = null;
let cardBitrates = {}; // key → stable bitrate for card display

let _recentVods     = [];
let _vodLoadedAt    = 0;
let _gridState      = null;
const _avatarCache  = {};

/* ── Utils ────────────────────────────────────────────── */
function getLiveSet(paths) {
  const s = new Set();
  for (const p of paths) {
    if (!p.ready) continue;
    const m = p.name.match(/^live\/(.+)$/);
    if (m) s.add(m[1]);
  }
  return s;
}

function getViewers(paths, key) {
  const p = paths.find(p => p.name === 'live/' + key);
  return p ? (p.readers?.length ?? 0) : 0;
}

function getReadyTime(paths, key) {
  const p = paths.find(p => p.name === 'live/' + key);
  return p?.readyTime ? new Date(p.readyTime).getTime() : null;
}

function jitter(base, variance) {
  return Math.round(base + (Math.random() - 0.5) * 2 * variance);
}

function fmtDuration(s) {
  if (!s) return '';
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
  return h > 0
    ? `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`
    : `${m}:${String(sec).padStart(2,'0')}`;
}

function fmtUptime(ms) {
  const s = Math.floor(ms / 1000);
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
  return [h, m, ss].map(n => String(n).padStart(2,'0')).join(':');
}

function fmtKbps(b) {
  return b >= 1000 ? (b/1000).toFixed(1) + 'M' : b + 'K';
}

function relativeTime(dateStr) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 2)  return 'Hace un momento';
  if (mins < 60) return `Hace ${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)  return `Hace ${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days === 1) return 'Ayer';
  if (days < 7)  return `Hace ${days} días`;
  return `Hace ${Math.floor(days / 7)} sem`;
}

/* ── API ─────────────────────────────────────────────── */
async function fetchPaths() {
  const now = Date.now();
  if (cache.data && now - cache.t < CACHE_MS) return cache.data;
  const ctrl = new AbortController();
  const tid  = setTimeout(() => ctrl.abort(), API_TIMEOUT);
  try {
    const r = await fetch('/mediamtx-api/v3/paths/list', { signal: ctrl.signal });
    clearTimeout(tid);
    const j = await r.json();
    cache = { t: now, data: j.items || [] };
  } catch {
    clearTimeout(tid);
    if (!cache.data) cache.data = [];
  }
  return cache.data;
}

async function fetchRecentVods(limit) {
  try {
    const r = await fetch(
      `${PB_URL}/api/collections/vods/records?sort=-date&perPage=${limit}&fields=id,channel,filename,thumb,preview,duration,date`,
      { signal: AbortSignal.timeout(5000) }
    );
    return (await r.json()).items || [];
  } catch { return []; }
}

async function loadVodData() {
  const vods = await fetchRecentVods(30);
  const seen = new Set();
  _recentVods = vods.filter(v => {
    if (seen.has(v.channel)) return false;
    seen.add(v.channel);
    return true;
  }).slice(0, 6);
  _vodLoadedAt = Date.now();
}

function vodCards(vods) {
  return vods.map(vod => {
    const s = STREAMERS.find(x => x.key === vod.channel) || {
      key: vod.channel, name: vod.channel.toUpperCase(),
      color: 'linear-gradient(135deg,#1a2a3a,#0a1420)',
      ava: vod.channel[0].toUpperCase()
    };
    const dur     = vod.duration ? fmtDuration(vod.duration) : '';
    const preview = _hover && vod.preview
      ? `<video class="ch-preview-vid" src="${vod.preview}" muted playsinline preload="none" loop></video>` : '';
    return `<a href="/vods/v/?id=${vod.id}" class="ch">
      <div class="ch-thumb">
        <div class="ch-thumb-glow" style="background:${s.color || '#1e3a4a'}"></div>
        <div class="ch-thumb-noise"></div>
        <div class="ch-thumb-inner">${s.ava || s.name[0]}</div>
        ${vod.thumb ? `<img class="ch-thumb-img" src="${vod.thumb}" alt="" onerror="this.style.display='none'" loading="lazy">` : ''}
        ${preview}
        <div class="ch-top"><span class="ch-badge-off">VOD</span></div>
        ${dur ? `<div class="ch-bottom"><span class="ch-bitrate">${dur}</span></div>` : ''}
      </div>
      <div class="ch-body">
        <div class="ch-ava" style="background:${s.color || '#1e3a4a'}">
          <img id="card-ava-${vod.id}" data-channel="${vod.channel}" alt="" style="display:none;width:100%;height:100%;object-fit:cover;border-radius:4px">
          <span id="card-avaf-${vod.id}">${s.ava || s.name[0]}</span>
        </div>
        <div class="ch-info">
          <div class="ch-name">${s.name}</div>
          <div class="ch-sub">${relativeTime(vod.date)}${dur ? ' · ' + dur : ''}</div>
        </div>
      </div>
    </a>`;
  }).join('');
}

function attachPreviewListeners(container) {
  if (!_hover) return;
  container.querySelectorAll('.ch-preview-vid').forEach(vid => {
    const card = vid.closest('.ch');
    if (!card) return;
    card.addEventListener('mouseenter', () => vid.play().catch(() => { vid.style.display = 'none'; }));
    card.addEventListener('mouseleave', () => { vid.pause(); vid.currentTime = 0; });
  });
}

async function loadCardAvatars(ids) {
  for (const id of ids) {
    if (id in _avatarCache) { applyCardAvatar(id, _avatarCache[id]); continue; }
    try {
      const el = document.getElementById('card-ava-' + id);
      const channel = el?.dataset?.channel;
      if (!channel) { _avatarCache[id] = null; continue; }
      const r = await fetch('/api/profile/' + encodeURIComponent(channel));
      if (!r.ok) { _avatarCache[id] = null; continue; }
      const d = await r.json();
      _avatarCache[id] = d.avatar_url || null;
      applyCardAvatar(id, _avatarCache[id]);
    } catch { _avatarCache[id] = null; }
  }
}

function applyCardAvatar(id, url) {
  if (!url) return;
  const img = document.getElementById('card-ava-' + id);
  const fb  = document.getElementById('card-avaf-' + id);
  if (img && img.src !== url) {
    img.src = url;
    img.style.display = 'block';
    if (fb) fb.style.display = 'none';
  }
}

/* ── Chat label ──────────────────────────────────────── */
function updateChatLabel(key) {
  const el = document.querySelector('.chat-panel .panel-title');
  if (!el) return;
  el.innerHTML = `<i class="fa-solid fa-comments"></i> Chat · #${key || 'corillo'}`;
}

/* ── Ticker ──────────────────────────────────────────── */
function renderTicker(liveChannels) {
  const wrap    = document.getElementById('tickerWrap');
  const content = document.getElementById('tickerContent');
  const countEl = document.getElementById('tickerCount');
  if (!wrap) return;
  if (!liveChannels.length) {
    wrap.style.visibility = 'hidden';
    return;
  }
  wrap.style.visibility = '';
  countEl.textContent = liveChannels.length;
  const items = [...liveChannels, ...liveChannels].map(s => {
    const v = s._viewers || 0;
    return `<span class="ticker-item">
      <span class="chan">${s.name}</span>
      <span>${s.sub?.split('·')[0]?.trim() || 'En vivo'}</span>
      ${v > 0 ? `<span class="stat">${v} viewers</span>` : ''}
      <span class="ticker-sep">//</span>
    </span>`;
  }).join('');
  content.innerHTML = items;
}

/* ── Stats animation ─────────────────────────────────── */
function startStatsAnimation(viewers, paths) {
  let uptimeStart = Date.now();
  if (featuredKey) {
    const rt = getReadyTime(paths, featuredKey);
    if (rt) uptimeStart = rt;
  }

  stopStatsAnimation();

  function tick() {
    const uptime = Date.now() - uptimeStart;
    const uptEl = document.getElementById('featuredUptime');
    if (uptEl) uptEl.textContent = fmtUptime(uptime);
  }

  tick();
  statsTimer = setInterval(tick, 1000);
}

function stopStatsAnimation() {
  clearInterval(statsTimer);
  statsTimer = null;
}

/* ── Progress bar ────────────────────────────────────── */
function startProgressBar() {
  cancelAnimationFrame(rafId);
  const bar = document.getElementById('rotateBar');
  if (!bar) return;
  bar.style.transition = 'none';
  bar.style.width = '0%';
  rotateStart = performance.now();
  function tick(now) {
    const pct = Math.min(100, ((now - rotateStart) / ROTATE_MS) * 100);
    bar.style.width = pct + '%';
    if (pct < 100) rafId = requestAnimationFrame(tick);
  }
  rafId = requestAnimationFrame(tick);
}

/* ── Featured player ─────────────────────────────────── */
function setFeaturedLive(key, paths) {
  const s = STREAMERS.find(x => x.key === key) || { key, name: key.toUpperCase(), color: '#1e3a4a', ava: key[0].toUpperCase(), sub: 'corillo.live' };
  const viewers = getViewers(paths, key);

  featuredKey = key;
  statsBase.viewers = viewers;

  updateChatLabel(key);

  // Sim stream
  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream';
  document.getElementById('simTitle').textContent = s.name.split('_')[0];
  document.getElementById('simSub').textContent = s.sub?.split('·').pop()?.trim() || 'Puerto Rico';

  // Top overlay
  document.getElementById('featuredTopLeft').innerHTML = `
    <span class="live-badge" id="liveBadge">En Vivo</span>
    <span class="featured-meta"><i class="fa-solid fa-eye"></i> <span id="featuredViewersMeta">${viewers}</span></span>
    <span class="featured-meta"><i class="fa-regular fa-clock"></i> <span id="featuredUptime">00:00:00</span></span>
  `;

  // Bottom overlay
  const ava = document.getElementById('featuredAva');
  ava.style.background = s.color || '#1e3a4a';
  ava.innerHTML = s.avatar_url
    ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">`
    : (s.ava || s.name[0]);

  document.getElementById('featuredNameEl').textContent = s.name;
  const subEl = document.getElementById('featuredSubEl');
  subEl.innerHTML = (s.host ? '<span class="host-tag">HOST</span>' : '') + (s.sub || 'corillo.live · Puerto Rico');

  document.getElementById('featuredActions').innerHTML = `
    <a href="/${key}/" class="play-btn"><i class="fa-solid fa-play"></i> Ver Ahora</a>
    ${s.twitch ? `<a href="https://twitch.tv/${s.twitch}" target="_blank" rel="noopener" class="icon-btn" title="Twitch"><i class="fab fa-twitch"></i></a>` : ''}
    <button class="icon-btn" title="Fullscreen" id="featFsBtn"><i class="fa-solid fa-expand"></i></button>
  `;

  document.getElementById('featFsBtn')?.addEventListener('click', () => {
    const vid = document.getElementById('featuredVideo');
    if (vid?.requestFullscreen) vid.requestFullscreen().catch(() => {});
  });

  // HLS setup
  setupHls(key);

  // Stats
  startStatsAnimation(viewers, paths);
}

async function setFeaturedOffline() {
  featuredKey = null;

  // Stop HLS
  const vid = document.getElementById('featuredVideo');
  vid.pause();
  vid.src = '';
  if (hlsInstance) { hlsInstance.destroy(); hlsInstance = null; }
  document.getElementById('featuredVideoWrap').classList.remove('playing');
  stopStatsAnimation();
  clearInterval(vodRotateTimer);
  vodRotateTimer = null;
  vodRotateIdx   = 0;

  updateChatLabel(null);

  // Load VODs if not cached yet
  if (!vodList.length) {
    const raw = await fetchRecentVods(20);
    const seen = new Set();
    vodList = raw.filter(v => {
      if (seen.has(v.channel)) return false;
      seen.add(v.channel);
      return true;
    }).slice(0, 8);
  }

  if (!vodList.length) {
    showFeaturedOfflineStatic();
    return;
  }

  showFeaturedVod(vodList[0]);
  if (vodList.length > 1) {
    startProgressBar();
    vodRotateTimer = setInterval(() => {
      vodRotateIdx = (vodRotateIdx + 1) % vodList.length;
      showFeaturedVod(vodList[vodRotateIdx]);
      startProgressBar();
    }, ROTATE_MS);
  }
}

function showFeaturedVod(vod) {
  const s = STREAMERS.find(x => x.key === vod.channel) || {
    key: vod.channel, name: vod.channel.toUpperCase(),
    color: 'linear-gradient(135deg,#1a2a3a,#0a1420)',
    ava: vod.channel[0].toUpperCase(), sub: 'corillo.live'
  };

  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream offline' + (vod.thumb ? ' has-thumb' : '');
  sim.style.backgroundImage = vod.thumb ? `url('${vod.thumb}')` : '';
  document.getElementById('simTitle').textContent = s.name.split('_')[0];
  document.getElementById('simSub').textContent = `ÚLTIMA TRANSMISIÓN · ${relativeTime(vod.date)}`;

  document.getElementById('featuredTopLeft').innerHTML = `
    <span class="live-badge offline">Offline</span>
    ${vod.date ? `<span class="featured-meta"><i class="fa-regular fa-clock"></i> ${relativeTime(vod.date)}</span>` : ''}
    ${vod.duration ? `<span class="featured-meta"><i class="fa-solid fa-film"></i> ${fmtDuration(vod.duration)}</span>` : ''}
  `;

  const featAva = document.getElementById('featuredAva');
  featAva.style.background = s.color || '#1e3a4a';
  featAva.innerHTML = s.avatar_url
    ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">`
    : (s.ava || s.name[0]);
  document.getElementById('featuredNameEl').textContent = s.name;
  document.getElementById('featuredSubEl').innerHTML =
    (s.host ? '<span class="host-tag">HOST</span>' : '') + (s.sub || 'corillo.live · Puerto Rico');

  document.getElementById('featuredActions').innerHTML = `
    <a href="/vods/v/?id=${vod.id}" class="play-btn"><i class="fa-solid fa-play"></i> Ver VOD</a>
    <a href="/${vod.channel}/" class="icon-btn" title="Ir al canal"><i class="fa-solid fa-tower-broadcast"></i></a>
    <a href="/vods/" class="icon-btn" title="Todos los VODs"><i class="fa-solid fa-film"></i></a>
  `;
}

function showFeaturedOfflineStatic() {
  const sim = document.getElementById('simStream');
  sim.className = 'sim-stream offline';
  sim.style.backgroundImage = '';
  document.getElementById('simTitle').textContent = 'SIN STREAM';
  document.getElementById('simSub').textContent = 'TODOS LOS CANALES OFFLINE';
  document.getElementById('featuredTopLeft').innerHTML =
    '<span class="live-badge offline">Offline</span>';
  document.getElementById('featuredAva').style.background = '#1e3a4a';
  document.getElementById('featuredAva').textContent = 'C';
  document.getElementById('featuredNameEl').textContent = 'CORILLO';
  document.getElementById('featuredSubEl').textContent = 'Puerto Rico · Sin stream activo';
  document.getElementById('featuredActions').innerHTML = `
    <a href="/vods/" class="play-btn"><i class="fa-solid fa-film"></i> Ver VODs</a>
    <a href="/join/" class="icon-btn" title="Crear canal"><i class="fa-solid fa-plus"></i></a>
  `;
}

function setupHls(key) {
  const vid  = document.getElementById('featuredVideo');
  const wrap = document.getElementById('featuredVideoWrap');

  vid.pause();
  vid.src = '';
  if (hlsInstance) { hlsInstance.destroy(); hlsInstance = null; }
  wrap.classList.remove('playing');

  const url = `/live/${encodeURIComponent(key)}/index.m3u8`;

  if (vid.canPlayType('application/vnd.apple.mpegurl')) {
    vid.src = url;
    vid.play().catch(() => {});
    wrap.classList.add('playing');
  } else if (window.Hls?.isSupported()) {
    hlsInstance = new window.Hls({ lowLatencyMode: true, maxBufferLength: 8 });
    hlsInstance.loadSource(url);
    hlsInstance.attachMedia(vid);
    hlsInstance.on(window.Hls.Events.MANIFEST_PARSED, () => {
      vid.play().catch(() => {});
      wrap.classList.add('playing');
    });
    hlsInstance.on(window.Hls.Events.ERROR, (_, data) => {
      if (data.fatal) wrap.classList.remove('playing');
    });
  }
}

/* ── Rotation ────────────────────────────────────────── */
function startRotation(live, paths) {
  clearInterval(rotateTimer);
  livePlayers = live.map(s => s.key);
  if (!livePlayers.length) return;

  // Set initial featured
  const preferredIdx = featuredKey ? livePlayers.indexOf(featuredKey) : -1;
  rotateIdx = preferredIdx >= 0 ? preferredIdx : 0;
  const firstKey = livePlayers[rotateIdx];
  if (firstKey !== featuredKey) setFeaturedLive(firstKey, paths);

  if (livePlayers.length === 1) { startProgressBar(); return; }

  startProgressBar();
  rotateTimer = setInterval(() => {
    rotateIdx = (rotateIdx + 1) % livePlayers.length;
    const nextKey = livePlayers[rotateIdx];
    // Fade transition
    const wrap = document.getElementById('featuredVideoWrap');
    wrap.style.transition = 'opacity .28s';
    wrap.style.opacity = '0.4';
    setTimeout(() => {
      setFeaturedLive(nextKey, lastPaths);
      wrap.style.opacity = '1';
      setTimeout(() => { wrap.style.transition = ''; wrap.style.opacity = ''; }, 350);
    }, 280);
    startProgressBar();
  }, ROTATE_MS);
}

/* ── Live section ────────────────────────────────────── */
function renderLiveSection(live, paths) {
  const section = document.getElementById('liveSection');
  const rail    = document.getElementById('liveRail');
  const countEl = document.getElementById('liveCountEl');
  if (!section) return;

  if (!live.length) { section.style.display = 'none'; return; }

  section.style.display = '';
  if (countEl) countEl.textContent = live.length;

  const t = Math.floor(Date.now() / 60000);
  rail.innerHTML = live.map(s => {
    const viewers = getViewers(paths, s.key);
    if (!cardBitrates[s.key]) cardBitrates[s.key] = jitter(5000, 600);
    const bitrate = cardBitrates[s.key];
    return `<a class="ch" href="/${s.key}/">
      <div class="ch-thumb">
        <div class="ch-thumb-glow" style="background:${s.color || '#1e3a4a'}"></div>
        <div class="ch-thumb-noise"></div>
        <div class="ch-thumb-inner">${s.ava || s.name[0]}</div>
        <img class="ch-thumb-img" src="/assets/thumbs/${s.key}.jpg?t=${t}" onerror="this.style.display='none'" alt="">
        <div class="ch-top">
          <span class="ch-live">LIVE</span>
          <span class="ch-viewers"><i class="fa-solid fa-eye"></i>${viewers}</span>
        </div>
        <div class="ch-bottom"><span class="ch-bitrate">${fmtKbps(bitrate)}bps</span></div>
      </div>
      <div class="ch-body">
        <div class="ch-ava ring-live" style="background:${s.color || '#1e3a4a'}">
          <img id="rail-ava-${s.key}" data-channel="${s.key}" alt="" style="display:none;width:100%;height:100%;object-fit:cover;border-radius:4px">
          <span id="rail-avaf-${s.key}">${s.ava || s.name[0]}</span>
        </div>
        <div class="ch-info">
          <div class="ch-name">${s.host ? '<span class="ch-host">H</span>' : ''}${s.name}</div>
          <div class="ch-sub">${s.sub || 'corillo.live'}</div>
        </div>
      </div>
    </a>`;
  }).join('');

  // Cargar avatares del live rail (desde cache o API)
  Promise.allSettled(live.map(async s => {
    const url = s.avatar_url || _avatarCache[s.key] || null;
    if (!url) {
      if (s.key in _avatarCache) return;
      try {
        const r = await fetch('/api/profile/' + encodeURIComponent(s.key));
        if (!r.ok) { _avatarCache[s.key] = null; return; }
        const d = await r.json();
        _avatarCache[s.key] = d.avatar_url || null;
      } catch { _avatarCache[s.key] = null; return; }
    } else {
      _avatarCache[s.key] = url;
    }
    const avatarUrl = _avatarCache[s.key];
    if (!avatarUrl) return;
    const img = document.getElementById('rail-ava-' + s.key);
    const fb  = document.getElementById('rail-avaf-' + s.key);
    if (img) { img.src = avatarUrl; img.style.display = 'block'; }
    if (fb)  fb.style.display = 'none';
  }));
}

/* ── Channel grid ────────────────────────────────────── */
function renderChannelGrid(paths) {
  const liveSet = getLiveSet(paths);
  const grid    = document.getElementById('channelGrid');

  // Last VOD thumb per channel — used as background for offline cards
  const vodThumbs = {};
  _recentVods.forEach(v => { if (v.thumb) vodThumbs[v.channel] = v.thumb; });

  // When live section is active show only offline; search filters both
  let list = liveSet.size > 0
    ? STREAMERS.filter(s => !liveSet.has(s.key))
    : STREAMERS;
  if (searchQuery) {
    list = STREAMERS.filter(s =>
      s.name.toLowerCase().includes(searchQuery) ||
      s.key.toLowerCase().includes(searchQuery)
    );
  }

  const withSoon = searchQuery
    ? list
    : [...list, ...(window.STREAMERS || []).filter(s => s.soon)];

  if (!withSoon.length) {
    const msg = 'No hay canales disponibles';
    grid.innerHTML = `<div class="grid-empty"><i class="fa-solid fa-satellite-dish"></i><p>${msg}</p></div>`;
    return;
  }

  const GRID_LIMIT = 8;
  const visible = searchQuery ? withSoon : withSoon.slice(0, GRID_LIMIT);
  const hasMore  = !searchQuery && withSoon.length > GRID_LIMIT;

  const cardsHtml = visible.map(s => {
    if (s.soon) return `
      <div class="ch soon">
        <div class="ch-thumb">
          <div class="ch-thumb-glow" style="background:${s.color || 'linear-gradient(135deg,#2a2a3a,#1a1a28)'}"></div>
          <div class="ch-thumb-noise"></div>
          <div class="ch-thumb-inner">?</div>
        </div>
        <div class="ch-body">
          <div class="ch-ava" style="background:${s.color || '#1e3a4a'}">${s.ava || '?'}</div>
          <div class="ch-info">
            <div class="ch-name">???</div>
            <div class="ch-sub">${s.sub || 'Próximamente'}</div>
          </div>
        </div>
      </div>`;

    const live    = liveSet.has(s.key);
    const viewers = live ? getViewers(paths, s.key) : 0;
    if (live && !cardBitrates[s.key]) cardBitrates[s.key] = jitter(5000, 600);
    if (!live) delete cardBitrates[s.key];
    const bitrate = cardBitrates[s.key];

    return `
      <a class="ch" href="/${s.key}/">
        <div class="ch-thumb">
          <div class="ch-thumb-glow" style="background:${s.color || '#1e3a4a'}"></div>
          <div class="ch-thumb-noise"></div>
          <div class="ch-thumb-inner">${s.ava || s.name[0]}</div>
          ${live
            ? `<img class="ch-thumb-img" src="/assets/thumbs/${s.key}.jpg?t=${Math.floor(Date.now()/60000)}" onerror="this.style.display='none'" alt="">`
            : vodThumbs[s.key]
              ? `<img class="ch-thumb-img ch-thumb-vod" src="${vodThumbs[s.key]}" alt="" loading="lazy" onerror="this.style.display='none'">`
              : ''
          }
          <div class="ch-top">
            ${live
              ? `<span class="ch-live">LIVE</span><span class="ch-viewers"><i class="fa-solid fa-eye"></i>${viewers}</span>`
              : `<span class="ch-badge-off">OFF</span>`
            }
          </div>
          ${live ? `<div class="ch-bottom"><span class="ch-bitrate">${fmtKbps(bitrate)}bps</span></div>` : ''}
        </div>
        <div class="ch-body">
          <div class="ch-ava ${live ? 'ring-live' : ''}" style="background:${s.color || '#1e3a4a'}">${s.avatar_url ? `<img src="${s.avatar_url}" style="width:100%;height:100%;object-fit:cover;border-radius:4px" alt="">` : (s.ava || s.name[0])}</div>
          <div class="ch-info">
            <div class="ch-name">${s.host ? '<span class="ch-host">H</span>' : ''}${s.name}</div>
            <div class="ch-sub">${s.sub || 'corillo.live'}</div>
          </div>
        </div>
      </a>`;
  }).join('');

  grid.innerHTML = cardsHtml
    + (hasMore ? `<a href="/streamers/" class="ch ch-see-all">
        <div class="ch-thumb">
          <div class="ch-thumb-glow" style="background:linear-gradient(135deg,#1a2a3a,#0a1420)"></div>
          <div class="ch-thumb-noise"></div>
          <div class="ch-thumb-inner" style="font-size:1.6rem"><i class="fa-solid fa-users"></i></div>
        </div>
        <div class="ch-body">
          <div class="ch-ava" style="background:linear-gradient(135deg,#1a2a3a,#0a1420)"><i class="fa-solid fa-arrow-right"></i></div>
          <div class="ch-info">
            <div class="ch-name">Ver todos</div>
            <div class="ch-sub">corillo.live/streamers</div>
          </div>
        </div>
      </a>` : '');
}

function renderVodsRow() {
  const carousel = document.getElementById('vodsCarousel');
  if (!carousel || !_recentVods.length) return;
  carousel.innerHTML = vodCards(_recentVods);
  attachPreviewListeners(carousel);
  const ids = [...carousel.querySelectorAll('[id^="card-ava-"]')].map(el => el.id.replace('card-ava-', ''));
  if (ids.length) loadCardAvatars(ids);
}

/* ── Digest ──────────────────────────────────────────── */
async function loadDigest() {
  try {
    const r = await fetch('/chat-api/digest', { signal: AbortSignal.timeout(5000) });
    const j = await r.json();
    if (j.digest) {
      document.getElementById('digestText').textContent = j.digest;
      document.getElementById('digestAge').textContent  = 'Claude · ahora';
    }
  } catch { /* digest is optional */ }
}

/* ── Main poll ───────────────────────────────────────── */
async function poll() {
  const now    = Date.now();
  const needVods = now - _vodLoadedAt > VOD_TTL;
  const tasks  = [fetchPaths()];
  if (needVods) tasks.push(loadVodData());
  const [paths] = await Promise.all(tasks);
  if (needVods) renderVodsRow();
  lastPaths    = paths;
  const liveSet = getLiveSet(paths);
  const live    = STREAMERS.filter(s => liveSet.has(s.key));
  const offline = STREAMERS.filter(s => !liveSet.has(s.key));
  const total   = STREAMERS.length;

  // Attach viewer counts to live streamers for ticker
  const liveWithViewers = live.map(s => ({ ...s, _viewers: getViewers(paths, s.key) }));

  document.getElementById('liveCountEl').textContent = live.length;
  document.getElementById('totalCountEl').textContent = total;

  // Live section + channel grid
  renderLiveSection(live, paths);
  renderChannelGrid(paths);

  // Featured player
  if (live.length > 0) {
    if (featuredKey === undefined || featuredKey === null || !liveSet.has(featuredKey)) {
      clearInterval(rotateTimer);
      rotateTimer = null;
      startRotation(live, paths);
    } else {
      statsBase.viewers = getViewers(paths, featuredKey);
      const vEl = document.getElementById('featuredViewersMeta');
      if (vEl) vEl.textContent = statsBase.viewers;
    }
  } else {
    if (featuredKey !== null) {
      clearInterval(rotateTimer);
      rotateTimer = null;
      setFeaturedOffline();
    }
  }
}

/* ── Reels strip ─────────────────────────────────────── */
async function loadReelsStrip() {
  try {
    const res  = await fetch(`${PB_URL}/api/collections/reels/records?filter=${encodeURIComponent('public=true')}&sort=-date&perPage=6`);
    const data = await res.json();
    const items = data.items || [];
    if (!items.length) return;
    const strip = document.getElementById('reelsStrip');
    const track = document.getElementById('reelsTrack');
    items.forEach(r => {
      const dur   = r.duration ? fmtDuration(r.duration) : '';
      const thumb = r.thumb ? `background-image:url('${r.thumb}')` : '';
      const a = document.createElement('a');
      a.className = 'reel-card';
      a.href = `/reels/?start=${r.id}`;
      a.innerHTML = `
        <div class="reel-card-thumb" style="${thumb}">
          <div class="reel-card-play"><i class="fa-solid fa-play"></i></div>
          ${dur ? `<div class="reel-card-dur">${dur}</div>` : ''}
        </div>
        <div class="reel-card-info">
          <div class="reel-card-ch">${r.channel.toUpperCase()}</div>
        </div>`;
      track.appendChild(a);
    });
    strip.style.display = '';
  } catch {}
}

/* ── Init ────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', async () => {
  // Search input vive en el SiteShell; aquí escuchamos el evento que dispara.
  window.addEventListener('crl-search', e => {
    searchQuery = (e.detail || '').toLowerCase();
    renderChannelGrid(lastPaths);
  });

  // Cargar roster completo desde PocketBase — fuente de verdad única
  try {
    const r = await fetch('/api/streamers', { signal: AbortSignal.timeout(5000) });
    if (r.ok) {
      const fresh = await r.json();
      const soonEntries = (window.STREAMERS || []).filter(s => s.soon);
      // Preservar host:true del static list para el badge HOST
      const hostKeys = new Set((window.STREAMERS || []).filter(s => s.host).map(s => s.key));
      STREAMERS.length = 0;
      for (const s of fresh) {
        if (hostKeys.has(s.key)) s.host = true;
        STREAMERS.push(s);
      }
      for (const s of soonEntries) STREAMERS.push(s);
    }
  } catch {}

  await poll();

  loadDigest();
  loadReelsStrip();

  setInterval(poll, POLL_MS);

  // Refresh live thumbnails every 60s without full re-render
  setInterval(() => {
    const t = Math.floor(Date.now() / 60000);
    document.querySelectorAll('.ch-thumb-img').forEach(img => {
      img.src = img.src.replace(/\?t=\d+/, `?t=${t}`);
    });
  }, 60000);

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) { cache.t = 0; poll(); }
  });
});
</script>


