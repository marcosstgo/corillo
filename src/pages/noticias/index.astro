---
import SiteShell from '../../layouts/SiteShell.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, catOf, readMinutes } from '../../data/news';
import { DISCORD_PATH } from '../../data/site';

const posts = (await getCollection('noticias')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [lead, ...rest] = posts;
const leadCat = catOf(lead.data);
const counts = Object.fromEntries(CATEGORIES.map(c => [c.id, posts.filter(p => catOf(p.data).id === c.id).length]));
---
<SiteShell
  title="Noticias — CORILLO"
  description="Noticias de gaming y esports, tecnología e IA, streaming y creación de contenido, cultura geek y Puerto Rico. Por CORILLO."
  canonical="https://corillo.live/noticias/"
>
  <fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="CORILLO — Noticias" href="/rss.xml" />
    <style is:global>
      .nw{max-width:1500px;margin:0 auto;padding:clamp(28px,5vw,64px) var(--h2-gutter) 90px}
      .nw-hd h1{margin:0;font:800 clamp(3rem,9vw,7rem)/.88 var(--h2-display);letter-spacing:-.05em;text-transform:none}
      .nw-hd p{margin:18px 0 0;max-width:60ch;color:var(--h2-mute);font:500 clamp(1rem,1.6vw,1.25rem)/1.5 var(--h2-body)}
      .nw-chips{display:flex;gap:8px;flex-wrap:wrap;margin:30px 0 26px}
      .nw-chip{--tc:var(--h2-bone);display:inline-flex;align-items:center;gap:9px;height:44px;padding:0 18px 0 10px;border:0;border-radius:999px;background:color-mix(in srgb,var(--h2-bone) 8%,transparent);color:var(--h2-bone);font:700 .92rem var(--h2-body);cursor:pointer;transition:background .15s,transform .15s}
      .nw-chip i{width:26px;height:26px;display:grid;place-items:center;border-radius:9px;background:color-mix(in srgb,var(--tc) 20%,transparent);color:var(--tc);font-size:.75rem}
      .nw-chip:hover{background:color-mix(in srgb,var(--h2-bone) 14%,transparent)}
      .nw-chip[aria-pressed="true"]{background:var(--h2-bone);color:var(--h2-ink)}
      .nw-chip[aria-pressed="true"] i{background:var(--tc);color:var(--h2-ink)}
      .nw-chip small{opacity:.6;font-weight:700}
      .nw-lead{--tc:var(--h2-cyan);display:grid;gap:18px;padding:clamp(24px,4vw,44px);border-radius:34px;text-decoration:none;color:inherit;
        background:radial-gradient(100% 120% at 100% 0%,color-mix(in srgb,var(--tc) 28%,transparent),transparent 65%),color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line);transition:transform .2s}
      .nw-lead:hover{transform:translateY(-3px)}
      .nw-lead h2{margin:0;max-width:22ch;font:800 clamp(2rem,5vw,4.2rem)/.98 var(--h2-display);letter-spacing:-.04em;text-transform:none}
      .nw-lead p{margin:0;max-width:62ch;color:color-mix(in srgb,var(--h2-bone) 82%,transparent);font:500 1.12rem/1.6 var(--h2-body)}
      .nw-meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap;color:var(--h2-mute);font:600 .88rem var(--h2-body)}
      .nw-cat{display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 13px 0 7px;border-radius:999px;background:color-mix(in srgb,var(--tc) 20%,transparent);color:var(--tc);font:800 .8rem var(--h2-body)}
      .nw-cat i{width:20px;height:20px;display:grid;place-items:center;border-radius:7px;background:var(--tc);color:var(--h2-ink);font-size:.62rem}
      .nw-go{display:inline-flex;align-items:center;gap:10px;justify-self:start;height:48px;padding:0 24px;border-radius:999px;background:var(--h2-cyan);color:var(--h2-ink);font:800 .95rem var(--h2-body)}
      .nw-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:16px;margin-top:16px}
      .nw-card{--tc:var(--h2-cyan);display:grid;align-content:start;gap:14px;padding:24px;border-radius:30px;text-decoration:none;color:inherit;background:color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line);position:relative;overflow:hidden;transition:transform .2s,background .2s}
      .nw-card::before{content:'';position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--tc),transparent)}
      .nw-card:hover{transform:translateY(-4px);background:color-mix(in srgb,var(--h2-bone) 10%,transparent)}
      .nw-card h2{margin:0;font:800 1.4rem/1.15 var(--h2-display);letter-spacing:-.03em;text-transform:none}
      .nw-card p{margin:0;color:var(--h2-mute);font:500 .98rem/1.55 var(--h2-body);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
      .nw-tags{display:flex;gap:6px;flex-wrap:wrap}
      .nw-tags span{padding:4px 10px;border-radius:999px;background:color-mix(in srgb,var(--h2-bone) 8%,transparent);color:var(--h2-mute);font:700 .74rem var(--h2-body)}
      .nw-empty{padding:60px 0;color:var(--h2-mute);font:500 1.1rem var(--h2-body)}
      .nw-dc{--tc:#8b95ff;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-top:44px;padding:26px 30px;border-radius:30px;background:radial-gradient(80% 140% at 0% 0%,rgba(88,101,242,.4),transparent 70%),color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line)}
      .nw-dc b{display:block;font:800 1.4rem var(--h2-display);letter-spacing:-.03em}
      .nw-dc span{color:var(--h2-mute);font:500 1rem var(--h2-body)}
      .nw-dc a{display:inline-flex;align-items:center;gap:10px;height:50px;padding:0 26px;border-radius:999px;background:#5865f2;color:#fff;text-decoration:none;font:800 1rem var(--h2-body)}
      .nw-rss{margin-top:22px;color:var(--h2-mute);font:500 .9rem var(--h2-body)} .nw-rss a{color:var(--h2-bone)}
    </style>
  </fragment>

  <main class="nw">
    <header class="nw-hd">
      <h1>Noticias</h1>
      <p>Lo que importa del gaming y los esports, la tecnología y la IA, el streaming y la creación de contenido, la cultura geek y Puerto Rico. Escrito por CORILLO.</p>
    </header>

    <div class="nw-chips" role="group" aria-label="Filtrar por área">
      <button class="nw-chip" type="button" data-c="" aria-pressed="true"><i class="fa-solid fa-layer-group" aria-hidden="true"></i>Todas <small>{posts.length}</small></button>
      {CATEGORIES.filter(c => counts[c.id] > 0).map(c => (
        <button class="nw-chip" type="button" data-c={c.id} aria-pressed="false" style={`--tc:${c.color}`}><i class={`fa-solid ${c.icon}`} aria-hidden="true"></i>{c.label} <small>{counts[c.id]}</small></button>
      ))}
    </div>

    <a class="nw-lead" id="nwLead" data-cat={leadCat.id} href={`/noticias/${lead.id}/`} style={`--tc:${leadCat.color}`}>
      <div class="nw-meta"><span class="nw-cat"><i class={`fa-solid ${leadCat.icon}`} aria-hidden="true"></i>{leadCat.label}</span><span>{lead.data.date}</span><span>·</span><span>{readMinutes(lead.body)} min</span></div>
      <h2>{lead.data.cardTitle || lead.data.heroTitle}</h2>
      <p>{lead.data.summary}</p>
      <span class="nw-go">Leer la nota <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
    </a>

    <div class="nw-grid" id="nwGrid">
      {rest.map(post => {
        const c = catOf(post.data);
        return (
          <a class="nw-card" data-cat={c.id} href={`/noticias/${post.id}/`} style={`--tc:${c.color}`}>
            <div class="nw-meta"><span class="nw-cat"><i class={`fa-solid ${c.icon}`} aria-hidden="true"></i>{c.label}</span><span>{post.data.date}</span></div>
            <h2>{post.data.cardTitle || post.data.heroTitle}</h2>
            <p>{post.data.summary}</p>
            {post.data.tags && <div class="nw-tags">{post.data.tags.slice(0, 3).map(t => <span>{t}</span>)}</div>}
          </a>
        );
      })}
    </div>
    <p class="nw-empty" id="nwEmpty" hidden>Todavía no hay notas en esta área.</p>

    <div class="nw-dc">
      <div><b>¿Qué opinas? Cuéntanos en el Discord</b><span>El corillo comenta las noticias, pide temas y se junta a jugar.</span></div>
      <a href={DISCORD_PATH}><i class="fa-brands fa-discord" aria-hidden="true"></i> Entrar al Discord</a>
    </div>
    <p class="nw-rss">Sigue las noticias por <a href="/rss.xml">RSS</a>.</p>
  </main>

  <script is:inline>
  (function () {
    var chips = document.querySelectorAll('.nw-chip'), lead = document.getElementById('nwLead'), cards = document.querySelectorAll('.nw-card'), empty = document.getElementById('nwEmpty');
    function apply(c) {
      chips.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.c === c)); });
      var shown = 0;
      [lead].concat([].slice.call(cards)).forEach(function (el) { var ok = !c || el.dataset.cat === c; el.hidden = !ok; if (ok) shown++; });
      empty.hidden = shown > 0;
    }
    chips.forEach(function (b) { b.addEventListener('click', function () { apply(b.dataset.c); history.replaceState(null, '', b.dataset.c ? '?c=' + b.dataset.c : location.pathname); }); });
    var q = new URLSearchParams(location.search).get('c'); if (q) apply(q);
  })();
  </script>
</SiteShell>
