---
import SiteShell from '../../../layouts/SiteShell.astro';
import MercadoNota from '../../../components/MercadoNota.astro';
import { categoria } from '../../../data/categorias';
import { TURNSTILE_SITE_KEY } from '../../../data/site';
import { loadMercado, CONDICION, ENTREGA, nombrePueblo, precio, type Anuncio } from '../../../data/mercado';

export async function getStaticPaths() {
  const R = await loadMercado();
  return R.anuncios.map(a => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props as { a: Anuncio };
const cat = categoria(a.categoria);
const sub = cat?.sub.find(s => s.slug === a.subcategoria);
const pueblo = nombrePueblo(a.pueblo);
const vendido = a.estado === 'vendido';
const desc = `${precio(a.precio)}${a.negociable ? ' (negociable)' : ''} · ${CONDICION[a.condicion]} · ${pueblo}. ${a.descripcion || (a.incluye.length ? 'Incluye: ' + a.incluye.join(', ') + '.' : '')}`.slice(0, 200);
const ld = {
  '@context': 'https://schema.org', '@type': 'Product', name: a.titulo, image: a.fotos, description: a.descripcion || undefined,
  brand: a.marca ? { '@type': 'Brand', name: a.marca } : undefined, model: a.modelo || undefined,
  offers: { '@type': 'Offer', price: a.precio, priceCurrency: 'USD', url: `https://corillo.live/mercado/a/${a.id}/`,
    itemCondition: a.condicion === 'nuevo' ? 'https://schema.org/NewCondition' : a.condicion === 'para-piezas' ? 'https://schema.org/DamagedCondition' : 'https://schema.org/UsedCondition',
    availability: vendido ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock' },
};
---
<SiteShell title={`${a.titulo} — ${precio(a.precio)} en ${pueblo} | Mercado de CORILLO`} description={desc} canonical={`https://corillo.live/mercado/a/${a.id}/`} ogImage={a.og || undefined}>
  <fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {vendido && <meta name="robots" content="noindex" />}
    <link rel="stylesheet" href="/assets/ofertas.css?v=2" />
    <link rel="stylesheet" href="/assets/mercado.css?v=5" />
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  </fragment>

  <main class="of" data-anuncio={a.id} data-turnstile={TURNSTILE_SITE_KEY}>
    <nav class="of-crumb" aria-label="Ruta"><a href="/mercado/">Mercado</a> / {cat && <a href={`/mercado/${cat.slug}/`}>{cat.es}</a>}{sub && <> / {sub.es}</>}</nav>

    <div class="mk-ad">
      <div class="mk-galw">
        <div class="mk-gal" tabindex="0" aria-label={`Fotos (${a.fotos.length})`}>
          {a.fotos.map((f, i) => <img src={f} alt={`${a.titulo}, foto ${i + 1} de ${a.fotos.length}`} width="1200" height="900" loading={i ? 'lazy' : 'eager'} decoding="async" />)}
        </div>
        {a.fotos.length > 1 && <p class="mk-dots">{a.fotos.length} fotos · desliza para verlas</p>}
      </div>

      <div class="mk-info">
        <div class="mk-lists">
          {a.incluye.length > 0 && <div class="mk-list mk-in"><h2>Qué incluye</h2><ul>{a.incluye.map(x => <li>{x}</li>)}</ul></div>}
          {a.falta.length > 0 && <div class="mk-list mk-out"><h2>Qué le falta</h2><ul>{a.falta.map(x => <li>{x}</li>)}</ul></div>}
        </div>
        {a.descripcion && <section class="of-sec" style="margin-top:28px"><h2>Descripción</h2><p class="mk-desc">{a.descripcion}</p></section>}
      </div>

      <aside class="mk-side">
        {a.estado !== 'disponible' && <span class={`mk-state ${a.estado}`}>{vendido ? 'Vendido' : 'Reservado'}</span>}
        <h1>{a.titulo}</h1>
        <div class="of-price"><b>{precio(a.precio)}</b>{a.negociable && !vendido && <em>Negociable</em>}</div>
        <dl class="mk-facts">
          <div><dt>Estado</dt><dd>{CONDICION[a.condicion]}</dd></div>
          <div><dt>Pueblo</dt><dd>{pueblo}</dd></div>
          <div><dt>Entrega</dt><dd>{ENTREGA[a.entrega]}</dd></div>
          {(a.marca || a.modelo) && <div><dt>Marca y modelo</dt><dd>{[a.marca, a.modelo].filter(Boolean).join(' ')}</dd></div>}
        </dl>
        {!vendido && (
          <div class="mk-cta">
            <button class="of-go" type="button" data-contactar>Escribirle al vendedor</button>
            {a.tiene_whatsapp && <button class="of-go mk-alt" type="button" data-wa>Ver WhatsApp</button>}
          </div>
        )}
        <a class="mk-seller" href={a.vendedor.canal || undefined}>
          <span class="mk-ava" style={`--c:${a.vendedor.color || 'var(--h2-cyan)'}`}>{a.vendedor.avatar ? <img src={a.vendedor.avatar} alt="" width="44" height="44" /> : a.vendedor.nombre.slice(0, 1)}</span>
          <span><b>{a.vendedor.nombre}</b><small>{a.vendedor.streamer ? 'Ver su canal en CORILLO' : 'Miembro de CORILLO'}</small></span>
          {a.vendedor.streamer && <span class="mk-badge" style="margin-left:auto">Streamer de CORILLO</span>}
        </a>
        <button class="mk-report" type="button" data-reportar>Reportar este anuncio</button>
      </aside>
    </div>

    <MercadoNota />

    <dialog class="mk-dlg" id="mkContacto" aria-labelledby="mkContactoT">
      <form method="dialog" novalidate>
        <header><h2 id="mkContactoT">Escribirle a {a.vendedor.nombre}</h2><button type="button" class="mk-x" data-cerrar aria-label="Cerrar">&times;</button></header>
        <p class="mk-safe"><strong>Antes de escribir:</strong> CORILLO no participa en la venta. Tu mensaje le llega al vendedor por correo a través de CORILLO, y las respuestas también: ninguno de los dos ve el correo del otro. Encuéntrense de día en un lugar público, revisa el equipo antes de pagar y no envíes dinero por adelantado.</p>
        <label>Tu nombre<input name="nombre" required minlength="2" maxlength="80" autocomplete="name" /></label>
        <label>Tu correo<input name="email" type="email" required maxlength="120" autocomplete="email" /><small>Solo para que el vendedor te pueda contestar.</small></label>
        <label>Mensaje<textarea name="mensaje" required minlength="10" maxlength="2000" rows="4">{`Hola, me interesa: ${a.titulo}. ¿Todavía lo tienes?`}</textarea></label>
        <div class="mk-hp" aria-hidden="true"><label>No llenes este campo<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="mk-ts"></div>
        <p class="mk-out" role="status" hidden></p>
        <button class="of-go" type="submit">Enviar mensaje</button>
      </form>
    </dialog>

    <dialog class="mk-dlg" id="mkWhatsapp" aria-labelledby="mkWhatsappT">
      <form method="dialog">
        <header><h2 id="mkWhatsappT">WhatsApp del vendedor</h2><button type="button" class="mk-x" data-cerrar aria-label="Cerrar">&times;</button></header>
        <p class="mk-safe">Encuéntrense de día en un lugar público, revisa el equipo antes de pagar y no envíes dinero por adelantado.</p>
        <div class="mk-ts"></div>
        <p class="mk-wa" hidden><b></b><a class="of-go" target="_blank" rel="noopener">Abrir WhatsApp</a></p>
        <p class="mk-out" role="status" hidden></p>
      </form>
    </dialog>

    <dialog class="mk-dlg" id="mkReporte" aria-labelledby="mkReporteT">
      <form method="dialog">
        <header><h2 id="mkReporteT">Reportar anuncio</h2><button type="button" class="mk-x" data-cerrar aria-label="Cerrar">&times;</button></header>
        <label>¿Qué pasa?<select name="motivo" required>
          <option value="estafa">Parece una estafa</option>
          <option value="prohibido">Artículo prohibido</option>
          <option value="vendido">Ya se vendió y sigue publicado</option>
          <option value="spam">Spam o anuncio repetido</option>
          <option value="ofensivo">Contenido ofensivo</option>
          <option value="otro">Otra cosa</option>
        </select></label>
        <label>Detalles (opcional)<textarea name="detalle" maxlength="500" rows="3"></textarea></label>
        <div class="mk-ts"></div>
        <p class="mk-out" role="status" hidden></p>
        <button class="of-go" type="submit">Enviar reporte</button>
      </form>
    </dialog>
  </main>
  <script is:inline src="/assets/mercado-anuncio.js?v=1" defer></script>
</SiteShell>
