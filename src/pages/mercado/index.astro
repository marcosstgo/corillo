---
import SiteShell from '../../layouts/SiteShell.astro';
import MercadoCard from '../../components/MercadoCard.astro';
import MercadoNota from '../../components/MercadoNota.astro';
import { loadMercado, categoriasConAnuncios, hoyHay } from '../../data/mercado';

const R = await loadMercado();
const cats = categoriasConAnuncios(R);
const desc = `${hoyHay(R.total)}: cámaras, micrófonos, capture cards, PC y más, de gente de la comunidad de CORILLO. Sin comisiones; el trato es directo con el vendedor.`;
---
<SiteShell title="Mercado: equipo de streaming y gaming usado en Puerto Rico — CORILLO" description={desc} canonical="https://corillo.live/mercado/">
  <fragment slot="head">
    <link rel="stylesheet" href="/assets/ofertas.css?v=2" />
    <link rel="stylesheet" href="/assets/mercado.css?v=5" />
  </fragment>

  <main class="of">
    <header class="of-hd">
      <h1>Mercado</h1>
      <p>Equipo de streaming y gaming usado, de gente de la comunidad. Le compras a alguien que transmite aquí, no a un desconocido.</p>
      <p class="of-stamp">{R.total ? `${R.total} ${R.total === 1 ? 'anuncio disponible' : 'anuncios disponibles'} ahora.` : 'Todavía no hay anuncios: sé el primero.'} <a class="mk-sell" href="/mercado/vender/">Vender algo</a></p>
    </header>

    <nav class="of-chips mk-cats" aria-label="Categorías">
      <a class="of-chip" href="/mercado/" aria-current="page" aria-pressed="true">Todo</a>
      {cats.map(c => <a class="of-chip" href={`/mercado/${c.slug}/`}>{c.es}{c.n > 0 && <span class="mk-n">{c.n}</span>}</a>)}
    </nav>

    <section class="of-sec">
      <h2>Lo más reciente</h2>
      {R.anuncios.length
        ? <div class="of-grid">{R.anuncios.map(a => <MercadoCard a={a} />)}</div>
        : <div class="of-empty" style="margin-top:20px">Todavía no hay anuncios. <a href="/mercado/vender/" style="color:var(--h2-bone)">Publica el primero</a>.</div>}
    </section>

    <MercadoNota />
  </main>
</SiteShell>

