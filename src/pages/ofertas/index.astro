---
import SiteShell from '../../layouts/SiteShell.astro';
import OfertaCard from '../../components/OfertaCard.astro';
import GratisCard from '../../components/GratisCard.astro';
import { loadOfertas, allFree, LISTAS, fmtDay, fmtStamp, offersJsonLd, type Deal } from '../../data/ofertas';
import { loadMercado } from '../../data/mercado';
import { traductor } from '../../i18n';

const D = loadOfertas();
const M = await loadMercado();
const tm = traductor('es');
const free = allFree(D);
const stamp = D.updatedAt ? fmtStamp(D.updatedAt) : null;
const nAll = D.steam.length + D.gog.length + D.humble.length + D.fanatical.length + D.gmg.length + D.gamersgate.length;
const desc = free.length
  ? `Hoy hay ${free.length} ${free.length === 1 ? 'juego gratis' : 'juegos gratis'} y más de ${Math.floor(nAll / 10) * 10} ofertas reales en Steam, GOG, Humble, Fanatical y más. Precios en dólares, actualizados cada hora.`
  : `Ofertas reales de juegos en Steam, GOG, Humble, Fanatical y más, y los juegos gratis de la semana. Precios en dólares, actualizados cada hora.`;
const ld = offersJsonLd([...free, ...D.steam.slice(0, 12), ...D.gog.slice(0, 8)], 'Ofertas de juegos', 'https://corillo.live/ofertas/');
const listas = LISTAS.map(l => ({ ...l, n: l.items(D).length })).filter(l => l.n > 0);
const tileBlurb: Record<string, string> = {
  'minimos-historicos': 'Juegos que hoy están en el precio más bajo que han tenido.',
  'menos-de-5-dolares': 'Buenos juegos por $5 o menos, de varias tiendas.',
  steam: 'Los mejor reseñados con descuento.', gog: 'Juegos sin DRM con descuento.', humble: 'Juegos de PC en oferta.',
  fanatical: 'Juegos de PC en oferta.', 'green-man-gaming': 'Juegos de PC en oferta.', gamersgate: 'Juegos de PC en oferta.',
};
---
<SiteShell title="Ofertas de juegos: gratis de la semana y descuentos en Steam, GOG, Humble y más — CORILLO" description={desc} canonical="https://corillo.live/ofertas/">
  <fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <link rel="stylesheet" href="/assets/ofertas.css?v=2" />
  </fragment>

  <main class="of">
    <header class="of-hd">
      <h1>Ofertas de juegos</h1>
      <p>Los juegos gratis de la semana y las mejores ofertas de varias tiendas, con precios reales y solo de juegos bien reseñados.</p>
      {stamp && <p class="of-stamp">Actualizado el {stamp} (hora de Puerto Rico). Precios en dólares, de la tienda de EE. UU., la que corresponde a Puerto Rico.</p>}
    </header>

    <div class="of-chips" role="group" aria-label="Filtrar">
      <button class="of-chip" type="button" data-f="" aria-pressed="true">Todo</button>
      <button class="of-chip" type="button" data-f="free" aria-pressed="false">Gratis</button>
      <button class="of-chip" type="button" data-f="steam" aria-pressed="false">Steam</button>
      <button class="of-chip" type="button" data-f="gog" aria-pressed="false">GOG</button>
      <button class="of-chip" type="button" data-f="mas" aria-pressed="false">Más tiendas</button>
    </div>

    <section class="of-sec" data-sec="free" id="gratis">
      <h2>Gratis ahora</h2>
      <p>Juegos que puedes reclamar sin pagar. Si los reclamas antes de que termine la promoción, se quedan en tu cuenta. <a href="/ofertas/gratis/">Cómo reclamarlos</a>.</p>
      {free.length ? (
        <div class="of-grid big">{free.map((g: Deal) => <GratisCard g={g} />)}</div>
      ) : <div class="of-empty" style="margin-top:20px">Ahora mismo no hay juegos gratis. Vuelve pronto: Epic los renueva cada semana.</div>}
      {D.soon.length > 0 && (
        <div class="of-soon" aria-label="Próximamente gratis">
          <p style="margin:14px 0 0;color:var(--h2-bone);font:800 1.05rem var(--h2-display)">Próximamente gratis en Epic</p>
          {D.soon.map((g: Deal) => <a href={g.url} target="_blank" rel="nofollow noopener">{g.title}<span>Desde el {fmtDay(g.starts!)}</span></a>)}
        </div>
      )}
    </section>

    {[['steam', 'Steam', D.steam.slice(0, 12), D.steam.length, 'Los juegos con mejor reseña que están en oferta. Solo entran los que tienen al menos 30 % de descuento y 75 % de reseñas positivas.'],
      ['gog', 'GOG', D.gog.slice(0, 8), D.gog.length, 'Juegos sin DRM. Solo entran los que tienen al menos 30 % de descuento y buenas reseñas.']].map(([id, label, list, total, blurb]) => (
      <section class="of-sec" data-sec={id as string} id={id as string}>
        <h2>Ofertas en {label as string}</h2>
        <p>{blurb as string}{D.asOf[id as string] ? ` Actualizado el ${fmtStamp(D.asOf[id as string])}.` : ''}</p>
        {(list as Deal[]).length ? (
          <>
            <div class="of-grid">{(list as Deal[]).map((g: Deal) => <OfertaCard g={g} />)}</div>
            {(total as number) > (list as Deal[]).length && <a class="of-more" href={`/ofertas/${id}/`}>Ver las {total as number} ofertas de {label as string}</a>}
          </>
        ) : <div class="of-empty" style="margin-top:20px">No pudimos cargar las ofertas de {label as string} en este momento. Se vuelven a intentar solas.</div>}
      </section>
    ))}

    <section class="of-sec" data-sec="mas" id="mas">
      <h2>Más ofertas</h2>
      <p>Explora por tipo de oferta o por tienda.</p>
      <div class="of-grid" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr))">
        {listas.map(l => (
          <a class="of-tile" href={`/ofertas/${l.slug}/`}><em>{l.n} {l.n === 1 ? 'juego' : 'juegos'}</em><b>{l.h1}</b><span>{tileBlurb[l.slug]}</span></a>
        ))}
        <a class="of-tile" href="/equipo/"><em>Guías de compra</em><b>Equipo recomendado</b><span>Webcams, micrófonos, capture cards y más para streaming.</span></a>
        <a class="of-tile" href="/mercado/"><em>{M.total ? tm('mercado.tile_em', { n: M.total }) : tm('mercado.tile_em_cero')}</em><b>Mercado</b><span>{tm('mercado.tile')}</span></a>
      </div>
    </section>

    <p class="of-note"><strong>Cómo lo hacemos.</strong> CORILLO no vende juegos: te enviamos a la tienda. Los precios de Steam, GOG y Epic Games Store vienen directamente de esas tiendas; los de Humble, Fanatical, Green Man Gaming y GamersGate y el "mínimo histórico" vienen de <a href="https://www.cheapshark.com/" target="_blank" rel="noopener">CheapShark</a>, y esos enlaces pasan por CheapShark, que puede recibir una comisión si compras. Descartamos cualquier oferta cuyo precio no coincida con su descuento. Los precios y las promociones cambian: confirma siempre el precio final en la tienda antes de comprar.</p>
  </main>

  <script is:inline>
    (function(){
      var chips=document.querySelectorAll('.of-chip'), secs=document.querySelectorAll('[data-sec]');
      chips.forEach(function(c){c.addEventListener('click',function(){
        chips.forEach(function(x){x.setAttribute('aria-pressed',String(x===c))});
        var f=c.dataset.f; secs.forEach(function(s){ if(!f||s.dataset.sec===f) s.removeAttribute('data-hide'); else s.setAttribute('data-hide',''); });
      });});
      function tick(){
        var now=Date.now();
        document.querySelectorAll('.of-free[data-end]').forEach(function(card){
          var end=+card.dataset.end; if(!end) return;
          var ms=end-now; if(ms<=0){card.setAttribute('data-hide','');return;}
          var d=Math.floor(ms/864e5), h=Math.floor(ms%864e5/36e5), m=Math.floor(ms%36e5/6e4);
          var el=card.querySelector('[data-cd]'); if(el) el.textContent='Termina en '+(d?d+' d ':'')+(h||d?h+' h ':'')+(d?'':m+' min');
        });
      }
      tick(); setInterval(tick,60000);
    })();
  </script>
</SiteShell>
