---
import FullscreenLayout from '../../layouts/FullscreenLayout.astro';
---
<FullscreenLayout
  title="CORILLO · Reels"
  description="Los mejores momentos de CORILLO — clips verticales de los streamers de Puerto Rico, y quién está en vivo ahora."
  canonical="https://corillo.live/reels/"
>
  <fragment slot="head">
    <link rel="stylesheet" href="/assets/reels2.css?v=2" />
  </fragment>

<header class="rl-top">
  <a class="rl-back" href="/" aria-label="Volver al inicio"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
  <a href="/" class="rl-logo" aria-label="Corillo, inicio">
    <svg viewBox="0 0 304 88" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs><radialGradient id="rn-ng" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="var(--crl-accent)" stop-opacity="0.18"/><stop offset="100%" stop-color="var(--crl-accent)" stop-opacity="0"/></radialGradient></defs>
      <text fill="var(--crl-white)" x="0" y="74" font-family="Bebas Neue, cursive" font-size="82">C</text>
      <circle cx="72" cy="42" r="36" fill="url(#rn-ng)"/>
      <circle cx="72" cy="42" r="34" stroke="var(--crl-white)" stroke-width="9" fill="none" stroke-opacity=".85"/>
      <circle cx="72" cy="42" r="20" stroke="var(--crl-accent)" stroke-width="6" fill="none"/>
      <circle cx="72" cy="42" r="8" fill="var(--crl-accent)"/>
      <circle cx="72" cy="42" r="3.5" fill="var(--crl-confirm)"/>
      <text fill="var(--crl-white)" x="114" y="74" font-family="Bebas Neue, cursive" font-size="82">RILLO</text>
    </svg>
  </a>
  <div class="rl-filters" id="rlFilters" role="group" aria-label="Filtrar por canal"></div>
  <div class="rl-top-r">
    <button class="rl-icon" id="rlMute" type="button" aria-label="Activar sonido" title="Sonido (M)"><i class="fa-solid fa-volume-xmark" aria-hidden="true"></i></button>
  </div>
</header>

<main class="rl-feed" id="rlFeed" tabindex="0" aria-label="Reels">
  <article class="rl-item rl-skel" aria-hidden="true"><div class="rl-stage"></div></article>
</main>

<div class="rl-arrows" id="rlArrows">
  <button class="rl-icon" id="rlPrev" type="button" aria-label="Reel anterior" title="Anterior (↑)"><i class="fa-solid fa-chevron-up" aria-hidden="true"></i></button>
  <small id="rlCount"></small>
  <button class="rl-icon" id="rlNext" type="button" aria-label="Reel siguiente" title="Siguiente (↓)"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
</div>

<div class="rl-state" id="rlEmpty" role="status">
  <i class="fa-solid fa-clapperboard" aria-hidden="true"></i>
  <b>Aún no hay reels</b>
  <span>Los streamers crean sus clips desde sus transmisiones grabadas.</span>
  <a href="/vods/">Ver las transmisiones</a>
</div>
<div class="rl-state" id="rlError" role="alert">
  <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
  <b>No pudimos cargar los reels</b>
  <span>Revisa tu conexión e intenta de nuevo.</span>
  <button type="button" id="rlRetry">Reintentar</button>
</div>
<button class="rl-pill" id="rlPill" type="button"><i class="fa-solid fa-volume-high" aria-hidden="true"></i> Toca para activar el sonido</button>
<div class="rl-pill" id="rlToast" role="status" style="cursor:default"></div>

<script>
const PB = 'https://pb.corillo.live';
const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const $ = (id: string) => document.getElementById(id)!;
const feed = $('rlFeed');

let reels: any[] = [];
let liveNow: any[] = [];
const people: Record<string, any> = {};
const vods: Record<string, any> = {};
let channel = '';
let items: HTMLElement[] = [];
let active = -1;
let muted = localStorage.getItem('corillo_muted') !== 'false';   // mismo ajuste que /vods/v/
// Calidad: 720p por defecto; 480p con ahorro de datos o red 2G/3G; el original solo si faltan las versiones livianas.
const conn = (navigator as any).connection;
const slowNet = !!conn && (conn.saveData || /(^|-)(2g|3g)$/.test(conn.effectiveType || ''));
const TIERS = ['480', '720', 'orig'];
let tier = sessionStorage.getItem('rl_tier') || (slowNet ? '480' : '720');
const variant = (file: string, t: string) => t === 'orig' ? file : file.replace(/\.mp4$/, `_${t}.mp4`);

const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]);
const nameOf = (k: string) => people[k]?.name || k;
function clock(sec: number) { sec = Math.max(0, Math.floor(sec)); const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60; return h ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}` : `${m}:${String(s).padStart(2, '0')}`; }
function ago(iso: string) {
  if (!iso) return '';
  const d = new Date(iso), diff = (Date.now() - d.getTime()) / 1000;
  if (diff < 3600) return `Hace ${Math.max(1, Math.floor(diff / 60))} min`;
  if (diff < 86400) return `Hace ${Math.floor(diff / 3600)} h`;
  if (diff < 604800) return `Hace ${Math.floor(diff / 86400)} d`;
  return d.toLocaleDateString('es-PR', { day: 'numeric', month: 'short' });
}
const vodLabel = (v: any) => v.title || `Transmisión del ${new Date(v.date).toLocaleDateString('es-PR', { day: 'numeric', month: 'long' })}`;
function toast(msg: string) { const t = $('rlToast'); t.textContent = msg; t.classList.add('show'); clearTimeout((toast as any)._t); (toast as any)._t = setTimeout(() => t.classList.remove('show'), 1800); }
const avaHTML = (k: string) => { const p = people[k]; return p?.avatar_url ? `<img src="${esc(p.avatar_url)}" alt="" loading="lazy" onerror="this.remove()">` : esc((nameOf(k)[0] || '?').toUpperCase()); };

/* ── datos: caché primero (pinta al instante), red después ───────────── */
const CK = 'rl_cache_v1';
function readCache() { try { const c = JSON.parse(localStorage.getItem(CK) || 'null'); if (c && Date.now() - c.t < 864e5) return c; } catch { /* sin caché */ } return null; }
function writeCache() {
  try { localStorage.setItem(CK, JSON.stringify({ t: Date.now(), reels, vods, people: Object.fromEntries(Object.entries(people).map(([k, p]: any) => [k, { name: p.name, color: p.color, avatar_url: p.avatar_url }])) })); } catch { /* cuota llena: se ignora */ }
}
const sig = () => reels.map(r => r.id).join(',') + '|' + liveNow.map(l => l.key).join(',');

async function loadAll() {
  $('rlError').classList.remove('show'); $('rlEmpty').classList.remove('show');
  let shown = false, shownSig = '';
  const c = readCache();
  if (c && !items.length && (c.reels || []).length) {
    reels = c.reels; Object.assign(vods, c.vods || {}); Object.assign(people, c.people || {});
    buildFilters(); render(true); shown = true; shownSig = sig();
  }
  try {
    const [rr, sr, pr] = await Promise.allSettled([
      fetch(`${PB}/api/collections/reels/records?filter=${encodeURIComponent('public=true')}&sort=-date&perPage=100`, { signal: AbortSignal.timeout(8000) }).then(r => r.json()),
      fetch('/api/streamers', { signal: AbortSignal.timeout(5000) }).then(r => r.json()),
      fetch('/mediamtx-api/v3/paths/list', { signal: AbortSignal.timeout(4000) }).then(r => r.json()),
    ]);
    if (rr.status !== 'fulfilled') throw new Error('reels');
    reels = rr.value.items || [];
    if (sr.status === 'fulfilled') for (const s of sr.value) people[s.key] = s;
    const paths = pr.status === 'fulfilled' ? (pr.value.items || []) : [];
    const keys = new Set<string>();
    for (const p of paths) { const m = String(p.name).match(/^live\/([^/]+)$/); if (p.ready && m && !/_(low|rtc)$/.test(m[1])) keys.add(m[1]); }
    liveNow = [...keys].map(k => ({ key: k, viewers: (paths.find((p: any) => p.name === 'live/' + k)?.readers || []).length })).sort((a, b) => b.viewers - a.viewers);
    // solo se vuelve a pintar si algo cambió (no interrumpe el video que ya está sonando)
    if (!shown || sig() !== shownSig) { const keep = items[active]?.dataset.id || ''; buildFilters(); render(!shown, keep); }
    // transmisión de origen de cada clip: se añade sobre lo ya pintado
    const ids = [...new Set(reels.map(r => r.vod_id).filter(Boolean))];
    if (ids.length) {
      try {
        const f = ids.map(i => `id="${i}"`).join('||');
        const v = await fetch(`${PB}/api/collections/vods/records?filter=${encodeURIComponent(f)}&fields=id,title,date&perPage=100`, { signal: AbortSignal.timeout(6000) }).then(r => r.json());
        for (const x of (v.items || [])) vods[x.id] = x;
        patchVods();
      } catch { /* sin contexto de transmisión: se oculta ese botón */ }
    }
    writeCache();
  } catch { if (!shown) { $('rlError').classList.add('show'); feed.innerHTML = ''; } }
}
function patchVods() {
  for (const it of items) {
    const r = reels.find(x => x.id === it.dataset.id); const v = r?.vod_id ? vods[r.vod_id] : null;
    const info = it.querySelector('.rl-info'); if (!r || !v || !info) continue;
    if (!info.querySelector('.rl-cap')) { const cap = r.title || `De: ${vodLabel(v)}`; info.querySelector('.rl-ch')!.insertAdjacentHTML('afterend', `<p class="rl-cap">${esc(cap)}</p>`); }
    if (!info.querySelector('.rl-full')) info.insertAdjacentHTML('beforeend', `<a class="rl-full" href="/vods/v/?id=${esc(r.vod_id)}${r.start_sec > 0 ? '&t=' + Math.floor(r.start_sec) : ''}"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> Ver la transmisión completa${r.start_sec > 0 ? ' · desde ' + clock(r.start_sec) : ''}</a>`);
  }
}

function buildFilters() {
  const chans = [...new Set([...reels.map(r => r.channel), ...liveNow.map(l => l.key)])];
  const bar = $('rlFilters');
  bar.innerHTML = `<button class="rl-chip" type="button" data-c="" aria-pressed="${channel === ''}">Todos</button>` +
    chans.map(c => `<button class="rl-chip" type="button" data-c="${esc(c)}" aria-pressed="${channel === c}" style="--c:${esc(people[c]?.color || 'var(--crl-accent)')}"><i></i>${esc(nameOf(c))}</button>`).join('');
}

/* ── feed ──────────────────────────────────────────────────────────── */
function reelHTML(r: any, i: number) {
  const src = `/vods/reels/${r.channel}/${r.filename}`;
  const vsrc = (t: string) => `/vods/reels/${r.channel}/${variant(r.filename, t)}`;
  const v = r.vod_id ? vods[r.vod_id] : null;
  const cap = r.title || (v ? `De: ${vodLabel(v)}` : '');
  const full = v ? `<a class="rl-full" href="/vods/v/?id=${esc(r.vod_id)}${r.start_sec > 0 ? '&t=' + Math.floor(r.start_sec) : ''}"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> Ver la transmisión completa${r.start_sec > 0 ? ' · desde ' + clock(r.start_sec) : ''}</a>` : '';
  const bg = r.thumb ? `background-image:url('${esc(r.thumb)}')` : '';
  return `<article class="rl-item" data-i="${i}" data-id="${esc(r.id)}" data-vod="${esc(r.vod_id || '')}" data-start="${r.start_sec || 0}" aria-label="Reel de ${esc(nameOf(r.channel))}">
    <div class="rl-ambient" style="${bg}"></div>
    <div class="rl-stage rl-shimmer">
      ${r.thumb ? `<img class="rl-poster" src="${esc(r.thumb)}" alt="" ${i < 2 ? 'fetchpriority="high"' : 'loading="lazy"'} decoding="async" onload="this.classList.add('ok')" onerror="this.remove()">` : ''}
      <video class="rl-video" data-orig="${esc(src)}" data-q720="${esc(vsrc('720'))}" data-q480="${esc(vsrc('480'))}" playsinline muted loop preload="none"></video>
      <div class="rl-shade"></div>
      <div class="rl-buffer"></div>
      <div class="rl-slow">Conexión lenta… cargando</div>
      <button class="rl-tap" type="button" aria-label="Pausar o reproducir"></button>
      <div class="rl-flash"><i class="fa-solid fa-play" aria-hidden="true"></i></div>
      <div class="rl-info">
        <a class="rl-ch" href="/${esc(r.channel)}/"><span class="rl-ava" style="--c:${esc(people[r.channel]?.color || '')}">${avaHTML(r.channel)}</span><span style="min-width:0"><b>${esc(nameOf(r.channel))}</b><small>${esc(ago(r.date))}${r.duration ? ' · ' + r.duration + ' s' : ''}</small></span></a>
        ${cap ? `<p class="rl-cap">${esc(cap)}</p>` : ''}
        ${full}
      </div>
      <div class="rl-progress" role="slider" aria-label="Posición del video" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i></i></div>
    </div>
    <div class="rl-rail">
      <button class="rl-act" type="button" data-share="${esc(r.id)}" aria-label="Compartir"><span><i class="fa-solid fa-share-nodes" aria-hidden="true"></i></span>Compartir</button>
      <a class="rl-act" href="${esc(src)}" download aria-label="Descargar"><span><i class="fa-solid fa-download" aria-hidden="true"></i></span>Bajar</a>
      <a class="rl-act" href="/${esc(r.channel)}/" aria-label="Ir al canal"><span><i class="fa-solid fa-tv" aria-hidden="true"></i></span>Canal</a>
    </div>
  </article>`;
}
function liveHTML(l: any, i: number) {
  const s = people[l.key] || {};
  const bg = `background-image:url('/assets/thumbs/${esc(l.key)}.jpg?t=${Math.floor(Date.now() / 60000)}')`;
  return `<article class="rl-item rl-live" data-i="${i}" data-live="${esc(l.key)}" aria-label="${esc(nameOf(l.key))} está en vivo">
    <div class="rl-ambient" style="${bg}"></div>
    <div class="rl-stage rl-shimmer">
      <img class="rl-poster" src="/assets/thumbs/${esc(l.key)}.jpg?t=${Math.floor(Date.now() / 60000)}" alt="" decoding="async" onload="this.classList.add('ok')" onerror="this.remove()">
      <div class="rl-shade"></div>
      <span class="rl-live-pill">EN VIVO</span>
      <span class="rl-viewers"><i class="fa-solid fa-eye" aria-hidden="true"></i> ${l.viewers}</span>
      <a class="rl-tap" href="/${esc(l.key)}/" aria-label="Entrar al directo de ${esc(nameOf(l.key))}"></a>
      <div class="rl-info">
        <a class="rl-ch" href="/${esc(l.key)}/"><span class="rl-ava" style="--c:${esc(s.color || '')}">${avaHTML(l.key)}</span><span style="min-width:0"><b>${esc(nameOf(l.key))}</b><small>Transmitiendo ahora</small></span></a>
        ${s.stream_title || s.sub ? `<p class="rl-cap">${esc(s.stream_title || s.sub)}</p>` : ''}
        <a class="rl-full is-live" href="/${esc(l.key)}/"><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> Entrar al directo</a>
      </div>
    </div>
  </article>`;
}

function render(initial = false, keepId = '') {
  const lives = liveNow.filter(l => !channel || l.key === channel);
  const list = reels.filter(r => !channel || r.channel === channel);
  const html = lives.map((l, i) => liveHTML(l, i)).join('') + list.map((r, i) => reelHTML(r, lives.length + i)).join('');
  items.forEach(pauseItem); active = -1;
  if (!html) { feed.innerHTML = ''; $('rlEmpty').classList.add('show'); $('rlCount').textContent = ''; return; }
  $('rlEmpty').classList.remove('show');
  feed.innerHTML = html;
  items = [...feed.querySelectorAll<HTMLElement>('.rl-item')];
  feed.scrollTop = 0;
  observe();
  wire();
  if (initial) {
    const q = new URLSearchParams(location.search);
    const target = q.get('r') || q.get('start') || keepId;   // ?start= es el formato antiguo
    const k = target ? items.findIndex(it => it.dataset.id === target) : -1;
    if (k > 0) { feed.style.scrollBehavior = 'auto'; feed.scrollTop = items[k].offsetTop; feed.style.scrollBehavior = ''; }
  }
  if (keepId && !initial) { const k = items.findIndex(it => it.dataset.id === keepId); if (k > 0) { feed.style.scrollBehavior = 'auto'; feed.scrollTop = items[k].offsetTop; feed.style.scrollBehavior = ''; } }
  if (active < 0) setActive(Math.max(0, items.findIndex(it => it.getBoundingClientRect().top >= -10)));
}

/* ── reproducción ──────────────────────────────────────────────────── */
let io: IntersectionObserver | null = null;
function observe() {
  io?.disconnect();
  io = new IntersectionObserver(es => { for (const e of es) if (e.isIntersecting) setActive(items.indexOf(e.target as HTMLElement)); }, { root: feed, threshold: 0.6 });
  items.forEach(it => io!.observe(it));
}
const vid = (it?: HTMLElement) => it?.querySelector('video') as HTMLVideoElement | null;
function srcFor(v: HTMLVideoElement) { return tier === 'orig' ? v.dataset.orig! : (tier === '480' ? v.dataset.q480! : v.dataset.q720!); }
function ensureSrc(v: HTMLVideoElement | null, preload = 'auto') {
  if (!v) return;
  v.preload = preload;
  if (!v.getAttribute('src')) { v.src = srcFor(v); v.dataset.tier = tier; }
}
/* si la versión liviana no existe (reel nuevo aún sin procesar) o falla, sube a la siguiente calidad; conserva el segundo */
function fallback(v: HTMLVideoElement) {
  const cur = TIERS.indexOf(v.dataset.tier || tier); if (cur < 0 || cur >= TIERS.length - 1) return;
  const t = v.currentTime; const next = TIERS[cur + 1]; v.dataset.tier = next;
  v.src = next === 'orig' ? v.dataset.orig! : (next === '720' ? v.dataset.q720! : v.dataset.q480!);
  v.addEventListener('loadedmetadata', () => { if (t) v.currentTime = t; v.play().catch(() => {}); }, { once: true });
}
/* si se traba más de 3.5 s en 720p, baja a 480p y lo recuerda en esta sesión */
function downgrade(it: HTMLElement) {
  const v = vid(it); if (!v || v.dataset.tier !== '720') return;
  const t = v.currentTime; tier = '480'; sessionStorage.setItem('rl_tier', '480'); v.dataset.tier = '480'; v.src = v.dataset.q480!;
  v.addEventListener('loadedmetadata', () => { v.currentTime = t; v.play().catch(() => {}); }, { once: true });
  toast('Conexión lenta: calidad ahorro');
}
function releaseSrc(v: HTMLVideoElement | null) { if (v && v.getAttribute('src') && v.paused) { v.removeAttribute('src'); v.load(); } }
function pauseItem(it: HTMLElement) { const v = vid(it); if (v) { v.pause(); v.currentTime = 0; } it.classList.remove('is-playing', 'is-loading'); }

function setActive(i: number) {
  if (i < 0 || i === active || !items[i]) return;
  if (items[active]) pauseItem(items[active]);
  active = i;
  items.forEach((it, k) => it.classList.toggle('is-active', k === i));
  // precarga la siguiente y libera lo que quedó lejos (memoria en móviles)
  items.forEach((it, k) => { const v = vid(it); const d = k - i;
    if (d === 0) ensureSrc(v, 'auto');
    else if (d === 1) ensureSrc(v, slowNet || tier === '480' ? 'metadata' : 'auto');   // siguiente: se precarga mientras ves este
    else if (d === -1) ensureSrc(v, 'none');
    else if (Math.abs(d) > 2) releaseSrc(v); });
  play(i);
  $('rlCount').textContent = `${i + 1} / ${items.length}`;
  ($('rlPrev') as HTMLButtonElement).disabled = i === 0; ($('rlNext') as HTMLButtonElement).disabled = i === items.length - 1;
  const id = items[i].dataset.id;
  if (id) history.replaceState(null, '', `?r=${id}${channel ? '&c=' + channel : ''}`); else history.replaceState(null, '', channel ? `?c=${channel}` : location.pathname);
}
function play(i: number) {
  const it = items[i], v = vid(it);
  if (!v) return;
  it.classList.add('is-loading');
  ensureSrc(v, 'auto');
  v.muted = muted;
  v.play().then(() => hidePill()).catch(() => { v.muted = true; v.play().catch(() => {}); if (!muted) $('rlPill').classList.add('show'); });
}
const hidePill = () => $('rlPill').classList.remove('show');
function applyMute() {
  const b = $('rlMute'); b.innerHTML = `<i class="fa-solid ${muted ? 'fa-volume-xmark' : 'fa-volume-high'}" aria-hidden="true"></i>`; b.setAttribute('aria-label', muted ? 'Activar sonido' : 'Silenciar');
  const v = vid(items[active]); if (v) v.muted = muted;
}
function setMuted(m: boolean) { muted = m; localStorage.setItem('corillo_muted', String(m)); applyMute(); if (!m) { const v = vid(items[active]); v?.play().then(hidePill).catch(() => {}); } else hidePill(); }
function toggle() {
  const v = vid(items[active]); if (!v) return;
  const f = items[active].querySelector('.rl-flash') as HTMLElement, ic = f.querySelector('i')!;
  if (v.paused) { v.play().catch(() => {}); ic.className = 'fa-solid fa-play'; } else { v.pause(); ic.className = 'fa-solid fa-pause'; }
  f.classList.remove('go'); void f.offsetWidth; f.classList.add('go');
}
function go(d: number) { const t = Math.min(items.length - 1, Math.max(0, active + d)); if (t === active) return; items[t].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' }); }

/* barra de progreso (un solo bucle para el video activo) */
(function loop() {
  const it = items[active], v = vid(it);
  if (v && v.duration) { const bar = it.querySelector('.rl-progress') as HTMLElement; (bar.firstElementChild as HTMLElement).style.transform = `scaleX(${v.currentTime / v.duration})`; }
  requestAnimationFrame(loop);
})();

/* ── eventos ───────────────────────────────────────────────────────── */
function wire() {
  items.forEach(it => {
    const v = vid(it);
    if (v) {
      let stall: any = null;
      const clear = () => { clearTimeout(stall); it.classList.remove('is-slow'); };
      v.addEventListener('playing', () => { it.classList.remove('is-loading'); it.classList.add('is-playing'); it.querySelector('.rl-stage')?.classList.remove('rl-shimmer'); clear(); });
      v.addEventListener('waiting', () => { it.classList.add('is-loading'); clearTimeout(stall); stall = setTimeout(() => { it.classList.add('is-slow'); downgrade(it); }, 3500); });
      v.addEventListener('canplay', () => { it.classList.remove('is-loading'); clear(); });
      v.addEventListener('error', () => { it.classList.remove('is-loading'); fallback(v); });
    }
    it.querySelector('button.rl-tap')?.addEventListener('click', toggle);
    const bar = it.querySelector('.rl-progress') as HTMLElement | null;
    if (bar && v) {
      const seek = (e: PointerEvent) => { const r = bar.getBoundingClientRect(); if (v.duration) v.currentTime = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)) * v.duration; };
      bar.addEventListener('pointerdown', e => { bar.setPointerCapture(e.pointerId); bar.classList.add('drag'); seek(e); });
      bar.addEventListener('pointermove', e => { if (bar.classList.contains('drag')) seek(e); });
      bar.addEventListener('pointerup', () => bar.classList.remove('drag'));
    }
    it.querySelector('[data-share]')?.addEventListener('click', async e => {
      const id = (e.currentTarget as HTMLElement).dataset.share!;
      const url = `${location.origin}/reels/?r=${id}`;
      if (navigator.share) { try { await navigator.share({ title: 'Reel en CORILLO', url }); return; } catch { /* cancelado: cae al portapapeles */ } }
      try { await navigator.clipboard.writeText(url); toast('Enlace copiado'); } catch { toast('No se pudo copiar el enlace'); }
    });
  });
}
$('rlFilters').addEventListener('click', e => {
  const b = (e.target as Element).closest('.rl-chip') as HTMLElement | null; if (!b) return;
  channel = b.dataset.c || '';
  document.querySelectorAll('.rl-chip').forEach(c => c.setAttribute('aria-pressed', String(c === b)));
  render();
});
$('rlMute').addEventListener('click', () => setMuted(!muted));
$('rlPill').addEventListener('click', () => setMuted(false));
$('rlPrev').addEventListener('click', () => go(-1));
$('rlNext').addEventListener('click', () => go(1));
$('rlRetry').addEventListener('click', () => { feed.innerHTML = '<article class="rl-item rl-skel" aria-hidden="true"><div class="rl-stage"></div></article>'; loadAll(); });
document.addEventListener('keydown', e => {
  if ((e.target as HTMLElement).closest('input,textarea,select') || e.ctrlKey || e.metaKey || e.altKey) return;
  const k = e.key;
  if (k === 'ArrowDown' || k === 'PageDown') { e.preventDefault(); go(1); }
  else if (k === 'ArrowUp' || k === 'PageUp') { e.preventDefault(); go(-1); }
  else if (k === ' ' || k === 'k' || k === 'K') { if ((e.target as HTMLElement).closest('button,a')) return; e.preventDefault(); toggle(); }
  else if (k === 'm' || k === 'M') setMuted(!muted);
  else if (k === 'Escape') location.href = '/';
});
// el primer gesto del usuario desbloquea el sonido si la preferencia guardada es "con sonido"
document.addEventListener('pointerdown', () => { if (!muted) { const v = vid(items[active]); if (v && v.muted) { v.muted = false; hidePill(); } } }, { once: true });
document.addEventListener('visibilitychange', () => { const v = vid(items[active]); if (!v) return; if (document.hidden) v.pause(); else v.play().catch(() => {}); });

const startCh = new URLSearchParams(location.search).get('c'); if (startCh) channel = startCh;
applyMute();
loadAll();
</script>

</FullscreenLayout>
