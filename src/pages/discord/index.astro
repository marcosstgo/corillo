---
import SiteShell from '../../layouts/SiteShell.astro';
import { DISCORD_INVITE } from '../../data/site';
const CODE = DISCORD_INVITE.split('/').pop();
---
<SiteShell
  title="Discord de CORILLO — El corillo se junta aquí"
  description="El Discord de CORILLO: salas de voz por juego, avisos de directos y gente de Puerto Rico. Mira quién está conectado ahora."
  canonical="https://corillo.live/discord/"
>
  <fragment slot="head">
    <style is:global>
      .dc{max-width:1400px;margin:0 auto;padding:clamp(28px,5vw,64px) var(--h2-gutter) 90px}
      .dc-hero{display:grid;gap:26px;padding:clamp(26px,4vw,52px);border-radius:38px;background:radial-gradient(90% 120% at 100% 0%,rgba(88,101,242,.5),transparent 65%),radial-gradient(70% 90% at 0% 100%,color-mix(in srgb,var(--h2-cyan) 16%,transparent),transparent 70%),color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line)}
      .dc-ico{width:72px;height:72px;border-radius:22px;display:grid;place-items:center;background:#5865f2;color:#fff;font-size:2.1rem;box-shadow:0 18px 44px -14px #5865f2}
      .dc-hero h1{margin:0;font:800 clamp(2.6rem,7vw,5.6rem)/.9 var(--h2-display);letter-spacing:-.045em;text-transform:none;max-width:14ch}
      .dc-hero p{margin:0;max-width:58ch;color:color-mix(in srgb,var(--h2-bone) 80%,transparent);font:500 clamp(1.05rem,1.6vw,1.25rem)/1.55 var(--h2-body)}
      .dc-row{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
      .dc-go{display:inline-flex;align-items:center;gap:12px;height:58px;padding:0 32px;border-radius:999px;background:#5865f2;color:#fff;text-decoration:none;font:800 1.08rem var(--h2-body);transition:box-shadow .15s,transform .15s}
      .dc-go:hover{box-shadow:0 0 0 5px rgba(88,101,242,.4);transform:translateY(-1px)}
      .dc-stat{display:flex;gap:26px;flex-wrap:wrap}
      .dc-stat div{display:flex;flex-direction:column}
      .dc-stat b{font:800 2.4rem/1 var(--h2-display);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
      .dc-stat b.on{color:var(--crl-confirm,#35e0a1)}
      .dc-stat small{margin-top:6px;color:var(--h2-mute);font:700 .82rem var(--h2-body)}
      .dc-sec{margin-top:44px}
      .dc-sec h2{margin:0 0 6px;font:800 clamp(1.6rem,3vw,2.2rem)/1 var(--h2-display);letter-spacing:-.035em;text-transform:none}
      .dc-sec>p{margin:0 0 20px;color:var(--h2-mute);font:500 1rem var(--h2-body)}
      .dc-games{display:flex;gap:10px;flex-wrap:wrap}
      .dc-game{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 18px 0 8px;border-radius:999px;background:color-mix(in srgb,var(--h2-bone) 8%,transparent);font:700 .98rem var(--h2-body)}
      .dc-game i{width:30px;height:30px;display:grid;place-items:center;border-radius:10px;background:color-mix(in srgb,var(--h2-cyan) 22%,transparent);color:var(--h2-cyan);font-size:.8rem}
      .dc-game em{font-style:normal;color:var(--h2-mag);font-variant-numeric:tabular-nums}
      .dc-people{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr));gap:10px}
      .dc-p{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:20px;background:color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line);min-width:0}
      .dc-av{position:relative;flex:none;width:42px;height:42px;border-radius:50%;background:var(--h2-raise) center/cover}
      .dc-av::after{content:'';position:absolute;right:-1px;bottom:-1px;width:13px;height:13px;border-radius:50%;background:var(--sc,#35e0a1);box-shadow:0 0 0 3px var(--h2-ink)}
      .dc-p b{display:block;font:700 .98rem/1.15 var(--h2-body);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .dc-p small{display:block;margin-top:3px;color:var(--h2-mute);font:500 .8rem/1.2 var(--h2-body);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .dc-p small.g{color:var(--h2-mag)}
      .dc-rooms{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,270px),1fr));gap:12px}
      .dc-room{padding:18px 20px;border-radius:24px;background:color-mix(in srgb,var(--h2-bone) 6%,transparent);box-shadow:inset 0 0 0 1px var(--h2-line)}
      .dc-room b{display:flex;justify-content:space-between;gap:10px;font:800 1.05rem/1.2 var(--h2-display);letter-spacing:-.02em}
      .dc-room b span{flex:none;color:var(--h2-mute);font:700 .82rem var(--h2-body)}
      .dc-room b span.live{color:var(--crl-confirm,#35e0a1)}
      .dc-room small{display:block;margin-top:8px;color:var(--h2-mute);font:500 .86rem/1.4 var(--h2-body)}
      .dc-err{padding:26px;border-radius:24px;background:color-mix(in srgb,var(--h2-bone) 6%,transparent);color:var(--h2-mute);font:500 1rem var(--h2-body)}
      .dc-note{margin-top:30px;color:var(--h2-mute);font:500 .86rem/1.5 var(--h2-body)}
    </style>
  </fragment>

  <main class="dc">
    <section class="dc-hero">
      <div class="dc-ico"><i class="fa-brands fa-discord" aria-hidden="true"></i></div>
      <h1>El corillo se junta aquí</h1>
      <p>Salas de voz por juego, avisos de directos, ayuda con OBS y gente de Puerto Rico hablando de gaming y streaming. Entra y juega con el corillo.</p>
      <div class="dc-row">
        <a class="dc-go" href={DISCORD_INVITE} target="_blank" rel="noopener"><i class="fa-brands fa-discord" aria-hidden="true"></i> Entrar al servidor</a>
        <div class="dc-stat" aria-live="polite">
          <div><b class="on" id="dcOn">—</b><small>en línea ahora</small></div>
          <div><b id="dcTot">—</b><small>miembros</small></div>
        </div>
      </div>
    </section>

    <section class="dc-sec" id="dcGamesSec" hidden>
      <h2>Se está jugando ahora mismo</h2>
      <p>Lo que el corillo tiene abierto en este momento.</p>
      <div class="dc-games" id="dcGames"></div>
    </section>

    <section class="dc-sec">
      <h2>Conectados</h2>
      <p>Quién está en el servidor ahora.</p>
      <div class="dc-people" id="dcPeople"><div class="dc-err">Cargando el corillo…</div></div>
    </section>

    <section class="dc-sec">
      <h2>Las salas</h2>
      <p>Salas de voz por juego y para conversar.</p>
      <div class="dc-rooms" id="dcRooms"></div>
    </section>

    <p class="dc-note">Esta lista viene del widget público de Discord y se actualiza cada pocos minutos. Solo aparecen quienes están conectados y su nombre de usuario.</p>
  </main>

  <script src="/assets/discord-live.js" is:inline></script>
  <script is:inline define:vars={{ CODE }}>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var SC = { online: '#35e0a1', idle: '#ffd23f', dnd: '#ff2d55' };
    function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
    window.CorilloDiscord.load(CODE).then(function (d) {
      $('dcOn').textContent = d.online; if (d.total) $('dcTot').textContent = d.total.toLocaleString('en-US');
      if (d.games.length) {
        $('dcGamesSec').hidden = false;
        d.games.forEach(function (g) { var c = el('span', 'dc-game'); var i = el('i'); i.className = 'fa-solid fa-gamepad'; c.appendChild(i); c.appendChild(document.createTextNode(g.name + ' ')); c.appendChild(el('em', '', '× ' + g.count)); $('dcGames').appendChild(c); });
      }
      var box = $('dcPeople'); box.textContent = '';
      var sorted = d.members.slice().sort(function (a, b) { return (b.game ? 1 : 0) - (a.game ? 1 : 0); });
      sorted.forEach(function (m) {
        var p = el('div', 'dc-p'); var av = el('div', 'dc-av'); av.style.backgroundImage = 'url("' + m.avatar + '")'; av.style.setProperty('--sc', SC[m.status] || SC.online); p.appendChild(av);
        var t = el('div'); t.style.minWidth = 0; t.appendChild(el('b', '', m.name));
        t.appendChild(m.game ? el('small', 'g', 'Jugando ' + m.game) : el('small', '', m.status === 'idle' ? 'Ausente' : m.status === 'dnd' ? 'No molestar' : 'En línea'));
        p.appendChild(t); box.appendChild(p);
      });
      var rooms = $('dcRooms');
      d.voice.forEach(function (v) {
        var r = el('div', 'dc-room'); var b = el('b'); b.appendChild(document.createTextNode(v.name));
        b.appendChild(el('span', v.members.length ? 'live' : '', v.members.length ? v.members.length + ' dentro' : 'vacía')); r.appendChild(b);
        if (v.members.length) r.appendChild(el('small', '', v.members.map(function (m) { return m.name; }).join(', ')));
        rooms.appendChild(r);
      });
    }).catch(function () {
      $('dcPeople').textContent = ''; $('dcPeople').appendChild(el('div', 'dc-err', 'No pudimos cargar quién está conectado ahora. Igual puedes entrar al servidor con el botón de arriba.'));
      $('dcOn').textContent = '·';
    });
  })();
  </script>
</SiteShell>
