[Unit]
Description=Corillo Auth — RTMP stream key validation
After=network.target wg-quick@wg0.service
Wants=wg-quick@wg0.service

[Service]
Type=simple
User=corillo-adm
WorkingDirectory=/home/corillo-adm/corillo-auth
EnvironmentFile=/home/corillo-adm/corillo-auth/.env
ExecStart=/home/corillo-adm/corillo-auth/venv/bin/uvicorn server:app --host 10.77.0.1 --port 3002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
