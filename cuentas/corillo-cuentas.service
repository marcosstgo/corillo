[Unit]
Description=Corillo Cuentas — registro de streamers (formulario /join/)
After=network.target

[Service]
Type=simple
User=corillo-adm
WorkingDirectory=/home/corillo-adm/corillo-cuentas
EnvironmentFile=/home/corillo-adm/corillo-cuentas/.env
ExecStart=/home/corillo-adm/corillo-cuentas/venv/bin/uvicorn server:app --host 127.0.0.1 --port 3003
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
